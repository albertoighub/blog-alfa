---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfessionalComments from '../components/ProfessionalComments.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, author } = Astro.props;

// Formateo de fecha para la cita académica
const pubYear = pubDate.getFullYear();
const formattedDate = pubDate.toLocaleDateString('es-MX', {
year: 'numeric',
month: 'long',
day: 'numeric'
});
---

<html lang="es">
<head>
<BaseHead title={`${title} | News Internacional TEP`} description={description} />
<style>
:global(body) { margin: 0 !important; padding: 0 !important; width: 100vw !important; max-width: 100% !important; overflow-x: hidden !important;
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
margin: 0;
}



main {
max-width: 900px; /* Ancho de lectura óptimo y confortable */
width: 100%;
margin: 0 auto;
box-sizing: border-box;
padding: 3.5rem 2rem 7rem; /* Márgenes y espacios despejados a los costados */
}

@media (max-width: 768px) {
main {
padding: 2rem 1.25rem 5rem;
}
}

.article-container {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 12px;
box-shadow: 0 4px 24px -4px rgba(15, 23, 42, 0.06);
padding: 3.5rem 3rem;
box-sizing: border-box;
}

@media (max-width: 768px) {
.article-container {
padding: 2rem 1.25rem;
border-radius: 8px;
}
}

.article-header {
margin-bottom: 2.5rem;
}
.article-cat-badge {
display: inline-block;
font-size: 0.75rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
letter-spacing: 0.12em;
margin-bottom: 1rem;
border-bottom: 2px solid #dc2626;
padding-bottom: 0.2rem;
}
.article-title {
font-size: clamp(2rem, 4vw, 3.2rem);
font-weight: 950;
line-height: 1.15;
color: #050505;
margin: 0 0 1rem;
letter-spacing: -0.03em;
}
.article-desc {
font-size: 1.25rem;
line-height: 1.6;
color: #475569;
margin: 0 0 1.8rem;
font-weight: 400;
}

/* 2. BLOQUE DE METADATOS EJECUTIVOS */
.executive-metadata-strip {
display: flex;
flex-wrap: wrap;
gap: 1rem;
margin-bottom: 1.5rem;
padding: 1rem 0;
border-top: 1px solid #e2e8f0;
border-bottom: 1px solid #e2e8f0;
}
.meta-badge {
display: inline-flex;
align-items: center;
gap: 6px;
background: #f1f5f9;
border: 1px solid #cbd5e1;
padding: 0.35rem 0.8rem;
border-radius: 4px;
font-size: 0.74rem;
font-weight: 700;
color: #334155;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.meta-badge.highlight {
background: #fff1f2;
border-color: #fecdd3;
color: #be123c;
}

.author-date-row {
font-size: 0.88rem;
color: #64748b;
font-weight: 600;
}
.author-name {
color: #050505;
font-weight: 800;
}

.hero-image-wrap {
width: 100%;
margin-bottom: 3.5rem;
border-radius: 8px;
overflow: hidden;
box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.15);
border: 1px solid #e2e8f0;
}
.hero-image-wrap img {
width: 100%;
height: auto;
display: block;
}

/* Estilos del Cuerpo Markdown MIT/Harvard */
.markdown-body {
font-size: 1.12rem;
line-height: 1.8;
color: #1e293b;
}
.markdown-body h2 {
font-size: 1.8rem;
font-weight: 900;
color: #080e21;
margin: 3.5rem 0 1.2rem;
padding-bottom: 0.6rem;
border-bottom: 2px solid #080e21;
letter-spacing: -0.02em;
position: relative;
}
.markdown-body h2:after {
content: "";
position: absolute;
bottom: -2px;
left: 0;
width: 60px;
height: 2px;
background: #dc2626;
}
.markdown-body h3 {
font-size: 1.35rem;
font-weight: 800;
margin: 2rem 0 1rem;
color: #0f172a;
}
.markdown-body p {
margin: 0 0 1.6rem;
}
.markdown-body blockquote {
margin: 2.5rem 0;
padding: 1.5rem 2rem;
background: #f8fafc;
border-left: 4px solid #dc2626;
font-size: 1.2rem;
font-style: italic;
color: #334155;
border-radius: 0 8px 8px 0;
}
/* TABLAS DE ALTA PRECISIÓN & ESTÉTICA EDITORIAL */
:global(.markdown-body table) {
  width: 100% !important;
  border-collapse: separate !important;
  border-spacing: 0 !important;
  margin: 2.2rem 0 !important;
  font-size: 0.88rem !important;
  background: #ffffff !important;
  border: 1px solid #cbd5e1 !important;
  border-radius: 8px !important;
  overflow: hidden !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04) !important;
}
:global(.markdown-body thead) {
  background: #050505 !important;
}
:global(.markdown-body th) {
  background: #050505 !important;
  color: #ffffff !important;
  text-align: left !important;
  padding: 0.85rem 1rem !important;
  font-weight: 850 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  font-size: 0.74rem !important;
  border: none !important;
  border-bottom: 2px solid #dc2626 !important;
}
:global(.markdown-body td) {
  padding: 0.8rem 1rem !important;
  border-bottom: 1px solid #e2e8f0 !important;
  color: #334155 !important;
  font-size: 0.86rem !important;
  line-height: 1.5 !important;
  vertical-align: top !important;
}
:global(.markdown-body tbody tr:nth-child(even)) {
  background: #f8fafc !important;
}
:global(.markdown-body tbody tr:hover) {
  background: #f1f5f9 !important;
  transition: background 0.15s ease !important;
}
:global(.markdown-body tbody tr:last-child td) {
  border-bottom: none !important;
}
:global(.markdown-body td:first-child) {
  font-weight: 800 !important;
  color: #050505 !important;
}
:global(.markdown-body img) {
  width: 100% !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 480px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  margin: 2rem auto 0.6rem !important;
  display: block !important;
  border: 1px solid #e2e8f0 !important;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06) !important;
}
:global(.markdown-body p > em) {
  display: block !important;
  font-size: 0.8rem !important;
  color: #64748b !important;
  text-align: center !important;
  margin-bottom: 1.8rem !important;
}
.markdown-body ul, .markdown-body ol { margin: 0 0 1.6rem 1.5rem; }
.markdown-body li { margin-bottom: 0.5rem; }

/* 3. CAJA DE CAPTACIÓN FLOTANTE AL CANAL DE ALERTAS */
.telegram-catchment-box {
background: linear-gradient(135deg, #050505 0%, #1a0505 100%);
color: #ffffff;
border-radius: 8px;
padding: 2.5rem;
margin: 4rem 0;
display: flex;
align-items: center;
justify-content: space-between;
gap: 2rem;
border-left: 6px solid #dc2626;
box-shadow: 0 15px 35px -10px rgba(220, 38, 38, 0.25);
}
.catchment-content h3 {
margin: 0 0 0.5rem;
font-size: 1.4rem;
font-weight: 900;
letter-spacing: -0.01em;
}
.catchment-content p {
margin: 0;
font-size: 0.95rem;
color: #cbd5e1;
line-height: 1.5;
}
.catchment-btn {
background: #dc2626;
color: #ffffff;
text-decoration: none;
padding: 0.85rem 1.8rem;
border-radius: 30px;
font-weight: 800;
font-size: 0.88rem;
white-space: nowrap;
transition: background 0.2s ease, transform 0.2s ease;
box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
}
.catchment-btn:hover {
background: #b91c1c;
transform: translateY(-2px);
}

/* ESTILOS DE MONETIZACIÓN DISCRETA Y RESPONSIVA TEP */
.tep-ad-slot-wrapper {
  margin: 2.5rem 0;
  padding: 1rem 0;
  text-align: center;
  border-top: 1px dashed #e2e8f0;
  border-bottom: 1px dashed #e2e8f0;
  background: rgba(248, 250, 252, 0.6);
  border-radius: 6px;
  overflow: hidden;
}
.ad-label-discreet {
  display: block;
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #94a3b8;
  margin-bottom: 0.5rem;
  font-weight: 700;
}

/* 4. FICHA DE CITA ACADÉMICA (EXPORT CITATION) */
.academic-citation-box {
background: #f1f5f9;
border: 1px solid #cbd5e1;
border-radius: 6px;
padding: 1.5rem;
margin-top: 4rem;
}
.citation-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 1rem;
border-bottom: 1px solid #e2e8f0;
padding-bottom: 0.8rem;
}
.citation-header h4 {
margin: 0;
font-size: 0.85rem;
font-weight: 900;
color: #0f172a;
text-transform: uppercase;
letter-spacing: 0.05em;
}
.copy-citation-btn {
background: #ffffff;
border: 1px solid #cbd5e1;
color: #0f172a;
padding: 0.4rem 0.8rem;
border-radius: 4px;
font-size: 0.72rem;
font-weight: 800;
cursor: pointer;
transition: all 0.2s ease;
display: inline-flex;
align-items: center;
gap: 5px;
}
.copy-citation-btn:hover {
background: #f8fafc;
border-color: #94a3b8;
}
.copy-citation-btn.success {
background: #10b981;
color: white;
border-color: #059669;
}
.citation-text {
font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
font-size: 0.88rem;
color: #334155;
line-height: 1.6;
margin: 0;
word-break: break-word;
}

@media (max-width: 768px) {
.telegram-catchment-box { flex-direction: column; text-align: center; padding: 2rem 1.5rem; }
.catchment-btn { width: 100%; text-align: center; }
.executive-metadata-strip { flex-direction: column; gap: 0.6rem; }
}
</style>
</head>

<body>
<!-- 1. BARRA DE PROGRESO DE LECTURA (Anclada arriba) -->


<Header />

<main>
<article class="article-container">
<header class="article-header">
<span class="article-cat-badge">{category}</span>
<h1 class="article-title">{title}</h1>
<p class="article-desc">{description}</p>

<!-- 2. METADATOS DE CONSUMO EJECUTIVO -->
<div class="executive-metadata-strip">
<div class="meta-badge highlight" id="reading-time-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
Lectura: Calculando...
</div>
<div class="meta-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
Arbitraje: Fuentes Primarias (Rigor MIT)
</div>
<div class="meta-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
Grado: Inteligencia Prospectiva
</div>
</div>

<div class="author-date-row">
Por <span class="author-name">{author || 'Comité Analítico TEP'}</span> • <time>{formattedDate}</time>
</div>
</header>

{heroImage && (
<div class="hero-image-wrap">
<img src={heroImage} alt={title} />
</div>
)}

<!-- AD BLOCK 1: IN-ARTICLE TOP BANNER (RESPONSIVE ALTO CTR) -->
<div class="tep-ad-slot-wrapper ad-slot-top">
  <span class="ad-label-discreet">Publicidad</span>
  <ins class="adsbygoogle"
       style="display:block; text-align:center;"
       data-ad-layout="in-article"
       data-ad-format="fluid"
       data-ad-client="ca-pub-3739732712037306"
       data-ad-slot="default"></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<div class="markdown-body" id="article-markdown-content">
<slot />
</div>

<!-- AD BLOCK 2: END-OF-ARTICLE NATIVE BANNER -->
<div class="tep-ad-slot-wrapper ad-slot-bottom">
  <span class="ad-label-discreet">Publicidad Patrocinada</span>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-3739732712037306"
       data-ad-format="autorelaxed"
       data-ad-slot="default"></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<!-- 3. CAJA DE CAPTACIÓN FLOTANTE (TELEGRAM) -->
<div class="telegram-catchment-box">
<div class="catchment-content">
<h3>Dossier de Inteligencia TEP en Vivo</h3>
<p>Reciba notificaciones de nuevos papers, alertas de liquidez y análisis geopolítico directamente en su terminal a través de nuestro canal clasificado.</p>
</div>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="catchment-btn">
Unirse al Canal Oficial →
</a>
</div>

<ProfessionalComments />

<!-- 4. FICHA DE CITACIÓN ACADÉMICA (EXPORT CITATION) -->
<div class="academic-citation-box">
<div class="citation-header">
<h4>Referencia Bibliográfica (Formato APA)</h4>
<button id="copy-citation-btn" class="copy-citation-btn">
<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
Copiar Cita
</button>
</div>
<p class="citation-text" id="citation-text-content">
{author || 'Comité Analítico TEP'}. ({pubYear}). <em>{title}</em>. News Internacional TEP. Recuperado de <span id="current-url-span">https://newsinternacionaltep.com</span>
</p>
</div>

</article>
</main>

<Footer />

<!-- SCRIPTS DE INTERACCIÓN (Progreso, Tiempo de Lectura y Copiado) -->
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
// 1. Cálculo del Tiempo de Lectura
const contentDiv = document.getElementById("article-markdown-content");
const timeBadge = document.getElementById("reading-time-badge");
if (contentDiv && timeBadge) {
const text = contentDiv.innerText || "";
const wordCount = text.trim().split(/\s+/).length;
const readingTimeMins = Math.ceil(wordCount / 220); // 220 palabras por minuto
timeBadge.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Lectura: ${readingTimeMins} min`;
}



// 3. Obtener URL Actual Dinámica para la Citación
const urlSpan = document.getElementById("current-url-span");
if (urlSpan) {
urlSpan.textContent = window.location.href.split('?')[0]; // Limpiar parámetros extra
}

// 4. Copiar Cita Académica al Portapapeles
const copyBtn = document.getElementById("copy-citation-btn");
const citationText = document.getElementById("citation-text-content");
if (copyBtn && citationText) {
copyBtn.addEventListener("click", () => {
navigator.clipboard.writeText(citationText.innerText).then(() => {
const originalHTML = copyBtn.innerHTML;
copyBtn.classList.add("success");
copyBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> ¡Copiado!`;
setTimeout(() => {
copyBtn.classList.remove("success");
copyBtn.innerHTML = originalHTML;
}, 2500);
});
});
}
});
</script>
</body>
</html>