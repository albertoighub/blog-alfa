---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, category, heroImage } = Astro.props;
const currentUrl = Astro.url.href;
---

<html lang="es">
<head>
<BaseHead title={`${title} | News Internacional TEP`} description={description} image={heroImage} />
<style>
main {
max-width: 820px;
margin: 0 auto;
padding: 2.5rem 1.25rem;
}
.article-header {
margin-bottom: 2rem;
border-bottom: 1px solid #e2e8f0;
padding-bottom: 1.5rem;
}
.category-pill {
display: inline-block;
background-color: #2563eb;
color: #ffffff;
font-size: 0.75rem;
font-weight: 800;
padding: 0.25rem 0.75rem;
border-radius: 4px;
text-transform: uppercase;
letter-spacing: 0.05em;
margin-bottom: 1rem;
}
.article-title {
font-size: 2.4rem;
line-height: 1.2;
font-weight: 800;
color: #0f172a;
margin: 0 0 1rem;
}
.article-desc {
font-size: 1.2rem;
line-height: 1.5;
color: #475569;
margin: 0 0 1.25rem;
}
.article-meta {
display: flex;
align-items: center;
gap: 1rem;
font-size: 0.88rem;
color: #64748b;
flex-wrap: wrap;
}
.share-bar {
display: flex;
align-items: center;
gap: 0.6rem;
margin-top: 1.5rem;
padding-top: 1rem;
border-top: 1px dashed #e2e8f0;
}
.share-label {
font-size: 0.82rem;
font-weight: 700;
color: #64748b;
text-transform: uppercase;
}
.share-btn {
padding: 0.35rem 0.75rem;
border-radius: 4px;
font-size: 0.82rem;
font-weight: 600;
text-decoration: none;
color: #ffffff !important;
}
.share-tg { background-color: #0284c7; }
.share-wa { background-color: #16a34a; }
.share-tw { background-color: #0f172a; }
.prose {
font-size: 1.12rem;
line-height: 1.8;
color: #1e293b;
}
.prose :global(h2) {
font-size: 1.6rem;
margin-top: 2.2rem;
margin-bottom: 0.8rem;
color: #0f172a;
font-weight: 700;
}
.prose :global(p) {
margin-bottom: 1.4rem;
}
.prose :global(ul) {
margin-bottom: 1.4rem;
padding-left: 1.5rem;
}
.prose :global(li) {
margin-bottom: 0.4rem;
}
.telegram-cta {
background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
color: #ffffff;
padding: 2rem;
border-radius: 10px;
margin-top: 3.5rem;
text-align: center;
}
.cta-title {
margin: 0 0 0.5rem;
font-size: 1.35rem;
font-weight: 800;
}
.cta-text {
color: #cbd5e1;
font-size: 0.95rem;
margin: 0 0 1.25rem;
}
.cta-button {
display: inline-block;
background-color: #0284c7;
color: #ffffff;
font-weight: 700;
padding: 0.65rem 1.4rem;
border-radius: 6px;
text-decoration: none;
font-size: 0.95rem;
}
.cta-button:hover { background-color: #0369a1; }
</style>
</head>

<body>
<Header />
<main>
<article>
<header class="article-header">
{category && <span class="category-pill">{category}</span>}
<h1 class="article-title">{title}</h1>
{description && <p class="article-desc">{description}</p>}
<div class="article-meta">
<span>Por <strong>Redacción News Internacional TEP</strong></span>
<span>•</span>
<time datetime={pubDate.toISOString()}>
{pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</time>
</div>

<div class="share-bar">
<span class="share-label">Compartir:</span>
<a class="share-btn share-tg" href={`https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer">Telegram</a>
<a class="share-btn share-wa" href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + currentUrl)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
<a class="share-btn share-tw" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer">X</a>
</div>
</header>

<div class="prose">
<slot />
</div>

<div class="telegram-cta">
<h3 class="cta-title">📡 Sigue la cobertura en tiempo real</h3>
<p class="cta-text">Únete a nuestra comunidad en Telegram para recibir análisis geopolíticos, tecnológicos y económicos al instante sin algoritmos mediadores.</p>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="cta-button">Unirme a @newsinternacionaltep</a>
</div>
</article>
</main>
<Footer />
</body>
</html>
