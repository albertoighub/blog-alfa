---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, category, heroImage } = Astro.props;
const currentUrl = Astro.url.href;
---

<html lang="es">
<head>
<BaseHead title={`${title} | News Internacional TEP`} description={description} image={heroImage} />
<style>
:global(body) {
background: #fdfdfd;
color: #121212;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
main {
max-width: 840px;
margin: 0 auto;
padding: 2.5rem 1.25rem 4rem;
}
.article-header {
margin-bottom: 2rem;
border-bottom: 1px solid #121212;
padding-bottom: 1.5rem;
}
.category-kicker {
font-size: 0.8rem;
font-weight: 900;
color: #b91c1c;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.8rem;
display: block;
}
.article-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2.2rem, 4vw, 3rem);
line-height: 1.16;
font-weight: 700;
color: #121212;
margin: 0 0 1rem;
}
.article-subtitle {
font-family: "Georgia", serif;
font-size: 1.25rem;
line-height: 1.55;
color: #334155;
margin: 0 0 1.5rem;
}
.byline-bar {
display: flex;
justify-content: space-between;
align-items: center;
font-size: 0.82rem;
color: #64748b;
border-top: 1px solid #e2e8f0;
padding-top: 1rem;
flex-wrap: wrap;
gap: 1rem;
}
.byline-text strong {
color: #0f172a;
}
.share-tools {
display: flex;
align-items: center;
gap: 0.5rem;
}
.share-pill {
padding: 0.3rem 0.7rem;
border-radius: 3px;
font-size: 0.75rem;
font-weight: 700;
text-decoration: none;
color: #ffffff !important;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.tg-pill { background: #0284c7; }
.wa-pill { background: #16a34a; }
.tw-pill { background: #0f172a; }

.prose {
font-family: "Georgia", "Times New Roman", serif;
font-size: 1.2rem;
line-height: 1.85;
color: #1a1a1a;
}
.prose :global(h2) {
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
font-size: 1.55rem;
font-weight: 800;
margin-top: 2.5rem;
margin-bottom: 0.8rem;
color: #0f172a;
}
.prose :global(p) {
margin-bottom: 1.5rem;
}
.prose :global(ul) {
margin-bottom: 1.5rem;
padding-left: 1.6rem;
}
.prose :global(li) {
margin-bottom: 0.5rem;
}
.prose :global(blockquote) {
border-left: 3px solid #1e3a8a;
margin: 1.5rem 0;
padding-left: 1.2rem;
font-style: italic;
color: #334155;
}

.bottom-wire {
margin-top: 3.5rem;
padding: 1.8rem;
background: #f8fafc;
border: 1px solid #cbd5e1;
border-top: 3px solid #1e3a8a;
text-align: center;
}
.bottom-wire h4 {
margin: 0 0 0.5rem;
font-size: 1.2rem;
color: #0f172a;
}
.bottom-wire p {
color: #475569;
font-size: 0.95rem;
margin: 0 0 1.2rem;
}
.bottom-wire a {
background: #1e3a8a;
color: #ffffff;
padding: 0.6rem 1.3rem;
text-decoration: none;
font-weight: 700;
font-size: 0.85rem;
border-radius: 4px;
display: inline-block;
}
</style>
</head>
<body>
<Header />
<main>
<article>
<header class="article-header">
{category && <span class="category-kicker">{category}</span>}
<h1 class="article-title">{title}</h1>
{description && <p class="article-subtitle">{description}</p>}
<div class="byline-bar">
<div class="byline-text">
Por <strong>Redacción News Internacional TEP</strong> • <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
</div>
<div class="share-tools">
<a class="share-pill tg-pill" href={`https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer">Telegram</a>
<a class="share-pill wa-pill" href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + currentUrl)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
<a class="share-pill tw-pill" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`} target="_blank" rel="noopener noreferrer">X</a>
</div>
</div>
</header>

<div class="prose">
<slot />
</div>

<div class="bottom-wire">
<h4>Reciba la cobertura global directamente en Telegram</h4>
<p>Análisis geopolítico y financiero sin algoritmos de terceros.</p>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer">Unirse al Canal Oficial</a>
</div>
</article>
</main>
<Footer />
</body>
</html>
