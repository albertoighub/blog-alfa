---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfessionalComments from '../components/ProfessionalComments.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, author } = Astro.props;

// Date formatting in English
const pubYear = pubDate.getFullYear();
const formattedDate = pubDate.toLocaleDateString('en-US', {
year: 'numeric',
month: 'long',
day: 'numeric'
});
---

<html lang="en">
<head>
<BaseHead title={`${title} | News International TEP`} description={description} />
<style>
:global(body) { 
margin: 0 !important; 
padding: 0 !important; 
width: 100vw !important; 
max-width: 100% !important; 
overflow-x: hidden !important;
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

main {
max-width: 900px; /* Optimal, comfortable reading width */
width: 100%;
margin: 0 auto;
box-sizing: border-box;
padding: 3.5rem 2rem 7rem; /* Generous side padding and spacing */
}

@media (max-width: 768px) {
main {
padding: 2rem 1.25rem 5rem;
}
}

.article-container {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 12px;
box-shadow: 0 4px 24px -4px rgba(15, 23, 42, 0.06);
padding: 3.5rem 3rem;
box-sizing: border-box;
}

@media (max-width: 768px) {
.article-container {
padding: 2rem 1.25rem;
border-radius: 8px;
}
}

.article-header {
margin-bottom: 2.5rem;
}
.article-cat-badge {
display: inline-block;
font-size: 0.75rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
letter-spacing: 0.12em;
margin-bottom: 1rem;
border-bottom: 2px solid #dc2626;
padding-bottom: 0.2rem;
}
.article-title {
font-size: clamp(2rem, 4vw, 3.2rem);
font-weight: 950;
line-height: 1.15;
color: #050505;
margin: 0 0 1rem;
letter-spacing: -0.03em;
}
.article-desc {
font-size: 1.25rem;
line-height: 1.6;
color: #475569;
margin: 0 0 1.8rem;
font-weight: 400;
}

/* 2. EXECUTIVE METADATA STRIP */
.executive-metadata-strip {
display: flex;
flex-wrap: wrap;
gap: 1rem;
margin-bottom: 1.5rem;
padding: 1rem 0;
border-top: 1px solid #e2e8f0;
border-bottom: 1px solid #e2e8f0;
}
.meta-badge {
display: inline-flex;
align-items: center;
gap: 6px;
background: #f1f5f9;
border: 1px solid #cbd5e1;
padding: 0.35rem 0.8rem;
border-radius: 4px;
font-size: 0.74rem;
font-weight: 700;
color: #334155;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.meta-badge.highlight {
background: #fff1f2;
border-color: #fecdd3;
color: #be123c;
}

.author-date-row {
font-size: 0.88rem;
color: #64748b;
font-weight: 600;
}
.author-name {
color: #050505;
font-weight: 800;
}

.hero-image-wrap {
width: 100%;
margin-bottom: 3.5rem;
border-radius: 8px;
overflow: hidden;
box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.15);
border: 1px solid #e2e8f0;
}
.hero-image-wrap img {
width: 100%;
height: auto;
display: block;
}

/* Markdown Body Styles MIT/Harvard Standard */
.markdown-body {
font-size: 1.12rem;
line-height: 1.8;
color: #1e293b;
}
.markdown-body h2 {
font-size: 1.8rem;
font-weight: 900;
color: #080e21;
margin: 3.5rem 0 1.2rem;
padding-bottom: 0.6rem;
border-bottom: 2px solid #080e21;
letter-spacing: -0.02em;
position: relative;
}
.markdown-body h2:after {
content: "";
position: absolute;
bottom: -2px;
left: 0;
width: 60px;
height: 2px;
background: #dc2626;
}
.markdown-body h3 {
font-size: 1.35rem;
font-weight: 800;
margin: 2rem 0 1rem;
color: #0f172a;
}
.markdown-body p {
margin: 0 0 1.6rem;
}
.markdown-body blockquote {
margin: 2.5rem 0;
padding: 1.5rem 2rem;
background: #f8fafc;
border-left: 4px solid #dc2626;
font-size: 1.2rem;
font-style: italic;
color: #334155;
border-radius: 0 8px 8px 0;
}

/* TABLES WITH PRECISION EDITORIAL FORMATTING */
:global(.markdown-body table) {
  width: 100% !important;
  border-collapse: separate !important;
  border-spacing: 0 !important;
  margin: 2.2rem 0 !important;
  font-size: 0.88rem !important;
  background: #ffffff !important;
  border: 1px solid #cbd5e1 !important;
  border-radius: 8px !important;
  overflow: hidden !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04) !important;
}
:global(.markdown-body thead) {
  background: #050505 !important;
}
:global(.markdown-body th) {
  background: #050505 !important;
  color: #ffffff !important;
  text-align: left !important;
  padding: 0.85rem 1rem !important;
  font-weight: 850 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.06em !important;
  font-size: 0.74rem !important;
  border: none !important;
  border-bottom: 2px solid #dc2626 !important;
}
:global(.markdown-body td) {
  padding: 0.8rem 1rem !important;
  border-bottom: 1px solid #e2e8f0 !important;
  color: #334155 !important;
  font-size: 0.86rem !important;
  line-height: 1.5 !important;
  vertical-align: top !important;
}
:global(.markdown-body tbody tr:nth-child(even)) {
  background: #f8fafc !important;
}
:global(.markdown-body tbody tr:hover) {
  background: #f1f5f9 !important;
  transition: background 0.15s ease !important;
}
:global(.markdown-body tbody tr:last-child td) {
  border-bottom: none !important;
}
:global(.markdown-body td:first-child) {
  font-weight: 800 !important;
  color: #050505 !important;
}
:global(.markdown-body img) {
  width: 100% !important;
  max-width: 100% !important;
  height: auto !important;
  max-height: 480px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  margin: 2rem auto 0.6rem !important;
  display: block !important;
  border: 1px solid #e2e8f0 !important;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06) !important;
}
:global(.markdown-body p > em) {
  display: block !important;
  font-size: 0.8rem !important;
  color: #64748b !important;
  text-align: center !important;
  margin-bottom: 1.8rem !important;
}
.markdown-body ul, .markdown-body ol { margin: 0 0 1.6rem 1.5rem; }
.markdown-body li { margin-bottom: 0.5rem; }

/* AD SLOTS */
.tep-ad-slot-wrapper {
  margin: 2.5rem 0;
  padding: 1rem 0;
  text-align: center;
  border-top: 1px dashed #e2e8f0;
  border-bottom: 1px dashed #e2e8f0;
  background: rgba(248, 250, 252, 0.6);
  border-radius: 6px;
  overflow: hidden;
}
.ad-label-discreet {
  display: block;
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #94a3b8;
  margin-bottom: 0.5rem;
  font-weight: 700;
}

/* 4. ACADEMIC CITATION BOX */
.academic-citation-box {
background: #f1f5f9;
border: 1px solid #cbd5e1;
border-radius: 6px;
padding: 1.5rem;
margin-top: 4rem;
}
.citation-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 1rem;
border-bottom: 1px solid #e2e8f0;
padding-bottom: 0.8rem;
}
.citation-header h4 {
margin: 0;
font-size: 0.85rem;
font-weight: 900;
color: #0f172a;
text-transform: uppercase;
letter-spacing: 0.05em;
}
.copy-citation-btn {
background: #ffffff;
border: 1px solid #cbd5e1;
color: #0f172a;
padding: 0.4rem 0.8rem;
border-radius: 4px;
font-size: 0.72rem;
font-weight: 800;
cursor: pointer;
transition: all 0.2s ease;
display: inline-flex;
align-items: center;
gap: 5px;
}
.copy-citation-btn:hover {
background: #f8fafc;
border-color: #94a3b8;
}
.copy-citation-btn.success {
background: #10b981;
color: white;
border-color: #059669;
}
.citation-text {
font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
font-size: 0.88rem;
color: #334155;
line-height: 1.6;
margin: 0;
word-break: break-word;
}
</style>
</head>

<body>
<Header />

<main>
<article class="article-container">
<header class="article-header">
<span class="article-cat-badge">{category}</span>
<h1 class="article-title">{title}</h1>
<p class="article-desc">{description}</p>

<!-- 2. EXECUTIVE METADATA STRIP -->
<div class="executive-metadata-strip">
<div class="meta-badge highlight" id="reading-time-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
Reading Time: Calculating...
</div>
<div class="meta-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
Peer Review: Primary Sources (MIT Standard)
</div>
<div class="meta-badge">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
Grade: Strategic Intelligence
</div>
</div>

<div class="author-date-row">
By <span class="author-name">{author || 'TEP Analytical Committee'}</span> • <time>{formattedDate}</time>
</div>
</header>

{heroImage && (
<div class="hero-image-wrap">
<img src={heroImage} alt={title} />
</div>
)}

<!-- AD BLOCK 1: IN-ARTICLE TOP BANNER -->
<div class="tep-ad-slot-wrapper ad-slot-top">
  <span class="ad-label-discreet">Sponsored Analysis</span>
  <ins class="adsbygoogle"
       style="display:block; text-align:center;"
       data-ad-layout="in-article"
       data-ad-format="fluid"
       data-ad-client="ca-pub-3739732712037306"
       data-ad-slot="default"></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<div class="markdown-body" id="article-markdown-content">
<slot />
</div>

<!-- AD BLOCK 2: END-OF-ARTICLE NATIVE BANNER -->
<div class="tep-ad-slot-wrapper ad-slot-bottom">
  <span class="ad-label-discreet">Sponsored Content</span>
  <ins class="adsbygoogle"
       style="display:block; text-align:center;"
       data-ad-layout="in-article"
       data-ad-format="fluid"
       data-ad-client="ca-pub-3739732712037306"
       data-ad-slot="default"></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<!-- ACADEMIC CITATION BOX -->
<div class="academic-citation-box">
<div class="citation-header">
<h4>Academic Citation Format (Harvard / APA / ISO 690)</h4>
<button class="copy-citation-btn" id="copyCitationBtn">
<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
Copy Citation
</button>
</div>
<p class="citation-text" id="citationText">
{author || 'TEP Analytical Committee'}. ({pubYear}). "{title}". <em>News International TEP — Global Intelligence & Financial Research</em>. Retrieved from https://international.newsinternacionaltep.com/
</p>
</div>

<ProfessionalComments />
</article>
</main>

<Footer />

<script is:inline>
// Reading time calculation in English
document.addEventListener('DOMContentLoaded', () => {
const content = document.getElementById('article-markdown-content');
const badge = document.getElementById('reading-time-badge');
if (content && badge) {
const words = content.innerText.trim().split(/\s+/).length;
const time = Math.max(1, Math.ceil(words / 220));
badge.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> ${time} min read (${words} words)`;
}

// Copy Citation functionality
const copyBtn = document.getElementById('copyCitationBtn');
const citationText = document.getElementById('citationText');
if (copyBtn && citationText) {
copyBtn.addEventListener('click', () => {
navigator.clipboard.writeText(citationText.innerText.trim()).then(() => {
const originalHtml = copyBtn.innerHTML;
copyBtn.innerHTML = 'Copied!';
copyBtn.classList.add('success');
setTimeout(() => {
copyBtn.innerHTML = originalHtml;
copyBtn.classList.remove('success');
}, 2500);
});
});
}
});
</script>
</body>
</html>