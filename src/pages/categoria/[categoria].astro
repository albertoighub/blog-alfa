---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
const allPosts = await getCollection('blog');

const categories = [
{
slug: 'tecnologia',
label: 'Tecnología & Inteligencia Artificial',
kicker: 'DIVISIÓN DE INTELIGENCIA TÉCNICA & MODELOS DE FRONTERA',
desc: 'Monitoreo e investigación de frontera sobre semiconductores, computación cuántica, centros de datos y desarrollo algorítmico.',
accentColor: '#2563eb',
bgHero: 'linear-gradient(135deg, #090d16 0%, #1e293b 50%, #0c1938 100%)',
borderHero: '#1d4ed8',
tags: ['Semiconductores', 'Modelos de Frontera', 'Ciberdefensa', 'Computación Cuántica', 'Infraestructura Cloud'],
iconType: 'tech',
match: ['tecnología', 'tecnologia', 'ia', 'inteligencia', 'tech', 'software', 'hardware']
},
{
slug: 'economia',
label: 'Economía, Mercados & Finanzas',
kicker: 'DEPARTAMENTO DE ANÁLISIS MACROECONÓMICO & CAPITALES',
desc: 'Rastreo sistemático de liquidez global, políticas de bancos centrales, tipos de interés, renta fija, materias primas y deuda soberana.',
accentColor: '#059669',
bgHero: 'linear-gradient(135deg, #04140d 0%, #0f172a 50%, #062b1b 100%)',
borderHero: '#059669',
tags: ['Bancos Centrales', 'Renta Variable', 'Materias Primas', 'Deuda Soberana', 'Cadena de Suministro'],
iconType: 'finance',
match: ['economía', 'economia', 'mercados', 'finanzas', 'bancos', 'inflación', 'patrimonial']
},
{
slug: 'geopolitica',
label: 'Geopolítica & Orden Global',
kicker: 'MESA DE RADAR GEOESTRATÉGICO & POLÍTICA EXTERIOR',
desc: 'Evaluación del equilibrio de poder internacional, conflictos asimétricos, seguridad euroatlántica, tratados y sanciones.',
accentColor: '#b91c1c',
bgHero: 'linear-gradient(135deg, #180909 0%, #0f172a 50%, #2b0b0b 100%)',
borderHero: '#b91c1c',
tags: ['Seguridad Colectiva', 'Indo-Pacífico', 'Guerra Híbrida', 'Sanciones Económicas', 'Diplomacia Estratégica'],
iconType: 'geopolitics',
match: ['política', 'politica', 'geopolítica', 'geopolitica', 'seguridad', 'defensa', 'diplomacia']
},
];

return categories.map((cat) => {
const filteredPosts = allPosts
.filter((post) => {
const postCat = (post.data.category || '').toLowerCase();
return cat.match.some((m) => postCat.includes(m));
})
.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

return {
params: { categoria: cat.slug },
props: { meta: cat, posts: filteredPosts },
};
});
}

const { meta, posts } = Astro.props;
const leadStory = posts[0];
const otherStories = posts.slice(1);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead
title={meta.label + " | News Internacional TEP"}
description={meta.desc}
/>
<style define:vars={{
accent: meta.accentColor,
bgHero: meta.bgHero,
borderHero: meta.borderHero
}}>
:global(body) {
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main {
max-width: 1240px;
margin: 0 auto;
padding: 2rem 1rem 6rem;
}

/* Banner Panorámico Cinemático */
.panoramic-hero {
background: var(--bgHero);
color: #ffffff;
border: 1px solid rgba(255, 255, 255, 0.12);
border-top: 4px solid var(--accent);
border-radius: 10px;
padding: 3rem 2.8rem;
margin-bottom: 3.5rem;
display: flex;
justify-content: space-between;
align-items: center;
gap: 2.5rem;
box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.25);
flex-wrap: wrap;
}
.hero-info {
max-width: 820px;
}
.hero-kicker-badge {
display: inline-flex;
align-items: center;
gap: 8px;
font-size: 0.74rem;
font-weight: 800;
color: var(--accent);
letter-spacing: 0.12em;
text-transform: uppercase;
background: rgba(255, 255, 255, 0.08);
border: 1px solid rgba(255, 255, 255, 0.12);
padding: 0.3rem 0.8rem;
border-radius: 20px;
margin-bottom: 1.2rem;
}
.live-dot {
width: 7px;
height: 7px;
border-radius: 50%;
background: var(--accent);
box-shadow: 0 0 8px var(--accent);
}
.hero-title {
font-size: clamp(2.3rem, 4.2vw, 3.4rem);
font-weight: 900;
letter-spacing: -0.03em;
margin: 0 0 1rem;
color: #ffffff;
line-height: 1.1;
}
.hero-desc {
font-size: 1.15rem;
color: #cbd5e1;
line-height: 1.6;
margin: 0 0 1.6rem;
}
.tags-cluster {
display: flex;
flex-wrap: wrap;
gap: 0.5rem;
}
.tag-pill {
background: rgba(255, 255, 255, 0.08);
border: 1px solid rgba(255, 255, 255, 0.15);
color: #e2e8f0;
font-size: 0.76rem;
font-weight: 700;
padding: 0.3rem 0.75rem;
border-radius: 20px;
transition: all 0.2s ease;
}
.tag-pill:hover {
background: var(--accent);
color: #ffffff;
border-color: var(--accent);
}

/* Ícono Temático Llamativo */
.hero-icon-visual {
width: 95px;
height: 95px;
border-radius: 16px;
background: rgba(255, 255, 255, 0.06);
border: 1px solid rgba(255, 255, 255, 0.18);
display: flex;
align-items: center;
justify-content: center;
color: var(--accent);
box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
flex-shrink: 0;
}

/* Noticia Líder Destacada */
.lead-card-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2.2rem;
margin-bottom: 3.5rem;
box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
}
.lead-grid {
display: grid;
grid-template-columns: 1.35fr 1fr;
gap: 2.5rem;
align-items: center;
}
.lead-img-box {
border-radius: 6px;
overflow: hidden;
max-height: 420px;
}
.lead-img {
width: 100%;
height: 100%;
max-height: 420px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-card-box:hover .lead-img {
transform: scale(1.03);
}
.lead-kicker {
font-size: 0.74rem;
font-weight: 900;
color: var(--accent);
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.6rem;
display: block;
}
.lead-title {
font-size: clamp(1.8rem, 2.8vw, 2.4rem);
line-height: 1.2;
font-weight: 900;
letter-spacing: -0.02em;
margin: 0 0 1rem;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: var(--accent);
}
.lead-desc {
font-size: 1.15rem;
color: #475569;
line-height: 1.6;
margin-bottom: 1.4rem;
}
.lead-meta {
font-size: 0.8rem;
color: #64748b;
font-weight: 600;
border-top: 1px solid #f1f5f9;
padding-top: 0.8rem;
}

/* Cuadrícula de Archivo */
.section-heading-bar {
border-bottom: 2px solid #0f172a;
padding-bottom: 0.6rem;
margin-bottom: 2rem;
}
.section-heading-title {
font-size: 1.5rem;
font-weight: 900;
letter-spacing: -0.02em;
color: #0f172a;
margin: 0;
}
.stories-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 2.2rem;
}
.story-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.story-card:hover {
transform: translateY(-5px);
box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
}
.story-img-wrap {
width: 100%;
height: 190px;
overflow: hidden;
}
.story-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.story-card:hover .story-img {
transform: scale(1.04);
}
.story-body {
padding: 1.4rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.story-title {
font-size: 1.2rem;
line-height: 1.35;
font-weight: 800;
letter-spacing: -0.02em;
margin: 0 0 0.6rem;
color: #0f172a;
}
.story-title a {
color: inherit;
text-decoration: none;
}
.story-title a:hover {
color: var(--accent);
}
.story-desc {
font-size: 0.9rem;
color: #475569;
line-height: 1.55;
margin-bottom: 1.2rem;
}
.story-footer {
font-size: 0.76rem;
color: #94a3b8;
font-weight: 600;
border-top: 1px solid #f8fafc;
padding-top: 0.6rem;
}

.empty-wire {
padding: 5rem 1rem;
text-align: center;
color: #64748b;
}

@media (max-width: 900px) {
.lead-grid {
grid-template-columns: 1fr;
gap: 1.8rem;
}
.panoramic-hero {
padding: 2rem 1.5rem;
}
}
</style>
</head>
<body>
<Header />
<main>
<!-- Banner Panorámico Sin Cuadros Toscos -->
<section class="panoramic-hero">
<div class="hero-info">
<div class="hero-kicker-badge">
<span class="live-dot"></span>
<span>{meta.kicker}</span>
</div>
<h1 class="hero-title">{meta.label}</h1>
<p class="hero-desc">{meta.desc}</p>
<div class="tags-cluster">
{meta.tags.map((t) => (
<span class="tag-pill">#{t}</span>
))}
</div>
</div>

<div class="hero-icon-visual">
{meta.iconType === 'tech' && (
<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
<line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
<line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/>
<line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/>
</svg>
)}
{meta.iconType === 'finance' && (
<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<line x1="12" y1="1" x2="12" y2="23"/>
<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
<polyline points="3 17 9 11 13 15 21 7"/>
<polyline points="14 7 21 7 21 14"/>
</svg>
)}
{meta.iconType === 'geopolitics' && (
<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<line x1="2" y1="12" x2="22" y2="12"/>
<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>
)}
</div>
</section>

<!-- Noticia Líder de la Sección -->
{leadStory && (
<section class="lead-card-box">
<div class="lead-grid">
<div class="lead-img-box">
{leadStory.data.heroImage && (
<img src={leadStory.data.heroImage} alt={leadStory.data.title} class="lead-img" />
)}
</div>
<div>
<span class="lead-kicker">INFORME DESTACADO</span>
<h2 class="lead-title">
<a href={"/blog/" + (leadStory.slug ?? leadStory.id) + "/"}>{leadStory.data.title}</a>
</h2>
<p class="lead-desc">{leadStory.data.description}</p>
<div class="lead-meta">
<span>Redacción News Internacional TEP</span>
<span>•</span>
<time>{leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
</div>
</div>
</div>
</section>
)}

<!-- Cuadrícula de Archivo -->
{otherStories.length > 0 && (
<section>
<div class="section-heading-bar">
<h3 class="section-heading-title">Archivo de Investigaciones & Prospectiva</h3>
</div>
<div class="stories-grid">
{otherStories.map((post) => (
<article class="story-card">
{post.data.heroImage && (
<div class="story-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="story-img" loading="lazy" />
</div>
)}
<div class="story-body">
<div>
<h4 class="story-title">
<a href={"/blog/" + (post.slug ?? post.id) + "/"}>{post.data.title}</a>
</h4>
<p class="story-desc">{post.data.description}</p>
</div>
<div class="story-footer">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Internacional
</div>
</div>
</article>
))}
</div>
</section>
)}

{posts.length === 0 && (
<div class="empty-wire">
<h3>Edición en Monitoreo Continuo</h3>
<p>Los sistemas autónomos están contrastando coberturas internacionales para esta sección.</p>
</div>
)}
</main>
<Footer />
</body>
</html>