---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
const allPosts = await getCollection('blog');

const categories = [
{
slug: 'tecnologia',
label: 'Tecnología & Inteligencia Artificial',
kicker: 'DIVISIÓN DE INTELIGENCIA TÉCNICA & MODELOS DE FRONTERA',
desc: 'Monitoreo exhaustivo de semiconductores, computación cuántica, infraestructura de cómputo a gran escala y autonomía algorítmica.',
accentColor: '#3b82f6',
accentGlow: 'rgba(59, 130, 246, 0.25)',
bgHero: 'linear-gradient(135deg, #090d16 0%, #111827 50%, #0c1938 100%)',
borderHero: '#1d4ed8',
tags: ['Semiconductores', 'Modelos de Frontera', 'Ciberdefensa', 'Computación Cuántica', 'Infraestructura Cloud'],
iconType: 'tech',
stats: [
{ label: 'Fuentes Primarias', val: 'TechCrunch / Verge / Wired' },
{ label: 'Eje Crítico', val: 'Soberanía Digital & Chips' },
{ label: 'Ciclo de Monitoreo', val: 'Tiempo Real (4h)' }
],
match: ['tecnología', 'tecnologia', 'ia', 'inteligencia', 'tech', 'software', 'hardware']
},
{
slug: 'economia',
label: 'Economía, Mercados & Finanzas',
kicker: 'DEPARTAMENTO DE ANÁLISIS MACROECONÓMICO & CAPITALES',
desc: 'Rastreo sistemático de liquidez global, políticas de bancos centrales, tipos de interés, renta fija, materias primas y deuda soberana.',
accentColor: '#10b981',
accentGlow: 'rgba(16, 185, 129, 0.25)',
bgHero: 'linear-gradient(135deg, #06140f 0%, #0f172a 50%, #062b1b 100%)',
borderHero: '#059669',
tags: ['Bancos Centrales', 'Renta Variable', 'Materias Primas', 'Deuda Soberana', 'Cadena de Suministro'],
iconType: 'finance',
stats: [
{ label: 'Fuentes Primarias', val: 'MarketWatch / CNBC / Yahoo' },
{ label: 'Eje Crítico', val: 'Política Monetaria & Bonos' },
{ label: 'Ciclo de Monitoreo', val: 'Tiempo Real (4h)' }
],
match: ['economía', 'economia', 'mercados', 'finanzas', 'bancos', 'inflación', 'patrimonial']
},
{
slug: 'geopolitica',
label: 'Geopolítica & Orden Global',
kicker: 'MESA DE RADAR GEOESTRATÉGICO & POLÍTICA EXTERIOR',
desc: 'Evaluación del equilibrio de poder internacional, conflictos asimétricos, seguridad euroatlántica, tensiones en el Indo-Pacífico y sanciones.',
accentColor: '#ef4444',
accentGlow: 'rgba(239, 68, 68, 0.25)',
bgHero: 'linear-gradient(135deg, #180909 0%, #111827 50%, #2b0b0b 100%)',
borderHero: '#b91c1c',
tags: ['Seguridad Colectiva', 'Indo-Pacífico', 'Guerra Híbrida', 'Sanciones Económicas', 'Diplomacia Estratégica'],
iconType: 'geopolitics',
stats: [
{ label: 'Fuentes Primarias', val: 'BBC / Politico / The Hill' },
{ label: 'Eje Crítico', val: 'Seguridad Internacional' },
{ label: 'Ciclo de Monitoreo', val: 'Tiempo Real (4h)' }
],
match: ['política', 'politica', 'geopolítica', 'geopolitica', 'seguridad', 'defensa', 'diplomacia']
},
];

return categories.map((cat) => {
const filteredPosts = allPosts
.filter((post) => {
const postCat = (post.data.category || '').toLowerCase();
return cat.match.some((m) => postCat.includes(m));
})
.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

return {
params: { categoria: cat.slug },
props: { meta: cat, posts: filteredPosts },
};
});
}

const { meta, posts } = Astro.props;
const leadStory = posts[0];
const otherStories = posts.slice(1);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead
title={meta.label + " | News Internacional TEP"}
description={meta.desc}
/>
<style define:vars={{
accent: meta.accentColor,
accentGlow: meta.accentGlow,
bgHero: meta.bgHero,
borderHero: meta.borderHero
}}>
:global(body) {
background-color: #f8fafc;
color: #0f172a;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
overflow-x: hidden;
}

/* Barra de progreso de scroll reactiva superior */
#scroll-progress {
position: fixed;
top: 0;
left: 0;
width: 0%;
height: 3px;
background: var(--accent);
z-index: 9999;
box-shadow: 0 0 10px var(--accent);
transition: width 0.1s linear;
}

main {
max-width: 1220px;
margin: 0 auto;
padding: 1.5rem 1rem 6rem;
}

/* Hero Cinemático Inmersivo */
.section-hero {
position: relative;
background: var(--bgHero);
color: #ffffff;
border: 1px solid rgba(255, 255, 255, 0.12);
border-top: 4px solid var(--accent);
border-radius: 12px;
padding: 3rem 2.8rem;
margin-bottom: 3.5rem;
overflow: hidden;
box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4), 0 0 50px -10px var(--accentGlow);
}

/* Vector Gigante de Fondo con Parallax en Scroll */
.watermark-parallax {
position: absolute;
right: -30px;
top: -30px;
width: 380px;
height: 380px;
opacity: 0.08;
color: #ffffff;
pointer-events: none;
will-change: transform;
transition: transform 0.1s cubic-bezier(0, 0, 0.2, 1);
}

.hero-kicker-badge {
display: inline-flex;
align-items: center;
gap: 8px;
font-size: 0.76rem;
font-weight: 900;
color: var(--accent);
letter-spacing: 0.14em;
text-transform: uppercase;
background: rgba(255, 255, 255, 0.06);
border: 1px solid rgba(255, 255, 255, 0.1);
padding: 0.35rem 0.85rem;
border-radius: 30px;
margin-bottom: 1.2rem;
backdrop-filter: blur(8px);
}
.live-dot {
width: 7px;
height: 7px;
border-radius: 50%;
background: var(--accent);
box-shadow: 0 0 8px var(--accent);
animation: blink 2s infinite ease-in-out;
}
@keyframes blink {
0%, 100% { opacity: 1; transform: scale(1); }
50% { opacity: 0.4; transform: scale(0.85); }
}

.hero-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2.4rem, 4.5vw, 3.6rem);
font-weight: 800;
margin: 0 0 1rem;
color: #ffffff;
line-height: 1.1;
letter-spacing: -0.02em;
}
.hero-desc {
font-family: "Georgia", serif;
font-size: 1.22rem;
color: #cbd5e1;
line-height: 1.65;
max-width: 820px;
margin: 0 0 1.8rem;
}

/* Pastillas interactivas que responden al hover */
.tags-cluster {
display: flex;
flex-wrap: wrap;
gap: 0.6rem;
margin-bottom: 2rem;
}
.tag-pill {
background: rgba(255, 255, 255, 0.08);
border: 1px solid rgba(255, 255, 255, 0.15);
color: #e2e8f0;
font-size: 0.78rem;
font-weight: 700;
padding: 0.35rem 0.85rem;
border-radius: 20px;
letter-spacing: 0.03em;
transition: all 0.25s ease;
cursor: default;
}
.tag-pill:hover {
background: var(--accent);
color: #ffffff;
border-color: var(--accent);
transform: translateY(-2px);
box-shadow: 0 4px 12px var(--accentGlow);
}

/* Barra de Estadísticas de Inteligencia */
.stats-bar {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
gap: 1.5rem;
border-top: 1px solid rgba(255, 255, 255, 0.12);
padding-top: 1.5rem;
}
.stat-box {
display: flex;
flex-direction: column;
}
.stat-label {
font-size: 0.7rem;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 0.08em;
color: #94a3b8;
margin-bottom: 0.25rem;
}
.stat-val {
font-size: 0.95rem;
font-weight: 700;
color: #ffffff;
}

/* Elementos con Animación al Scroll (Reveal) */
.scroll-reveal {
opacity: 0;
transform: translateY(28px);
transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
will-change: opacity, transform;
}
.scroll-reveal.is-visible {
opacity: 1;
transform: translateY(0);
}

/* Noticia Principal Broadsheet */
.featured-section {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 10px;
padding: 2.2rem;
margin-bottom: 3.5rem;
box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.featured-section:hover {
box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08);
}
.featured-grid {
display: grid;
grid-template-columns: 1.35fr 1fr;
gap: 2.5rem;
align-items: center;
}
.featured-img-wrap {
position: relative;
border-radius: 8px;
overflow: hidden;
max-height: 440px;
box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}
.featured-img {
width: 100%;
height: 100%;
max-height: 440px;
object-fit: cover;
display: block;
transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.featured-section:hover .featured-img {
transform: scale(1.04);
}
.featured-kicker {
font-size: 0.75rem;
font-weight: 900;
color: var(--accent);
text-transform: uppercase;
letter-spacing: 0.1em;
margin-bottom: 0.6rem;
display: inline-block;
}
.featured-title {
font-family: "Georgia", serif;
font-size: clamp(2rem, 2.8vw, 2.5rem);
line-height: 1.18;
font-weight: 800;
margin: 0 0 1.2rem;
color: #0f172a;
}
.featured-title a {
color: inherit;
text-decoration: none;
transition: color 0.2s ease;
}
.featured-title a:hover {
color: var(--accent);
}
.featured-desc {
font-family: "Georgia", serif;
font-size: 1.15rem;
color: #475569;
line-height: 1.65;
margin-bottom: 1.5rem;
}
.featured-meta {
display: flex;
align-items: center;
gap: 0.8rem;
font-size: 0.82rem;
color: #64748b;
font-weight: 600;
border-top: 1px solid #f1f5f9;
padding-top: 1rem;
}

/* Cuadrícula Secundaria Interactiva */
.grid-header {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #0f172a;
padding-bottom: 0.6rem;
margin-bottom: 2rem;
}
.grid-title {
font-family: "Georgia", serif;
font-size: 1.6rem;
font-weight: 800;
color: #0f172a;
margin: 0;
}
.grid-container {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 2.2rem;
}
.card-item {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
}
.card-item:hover {
transform: translateY(-6px);
border-color: var(--accent);
box-shadow: 0 16px 30px -10px rgba(0, 0, 0, 0.08);
}
.card-img-box {
width: 100%;
height: 200px;
overflow: hidden;
position: relative;
}
.card-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.5s ease;
}
.card-item:hover .card-img {
transform: scale(1.05);
}
.card-body {
padding: 1.4rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.card-title {
font-family: "Georgia", serif;
font-size: 1.25rem;
line-height: 1.35;
font-weight: 700;
margin: 0 0 0.7rem;
color: #0f172a;
}
.card-title a {
color: inherit;
text-decoration: none;
transition: color 0.15s ease;
}
.card-title a:hover {
color: var(--accent);
}
.card-desc {
font-size: 0.92rem;
color: #475569;
line-height: 1.55;
margin-bottom: 1.2rem;
}
.card-footer {
font-size: 0.78rem;
color: #94a3b8;
font-weight: 600;
border-top: 1px solid #f8fafc;
padding-top: 0.8rem;
}

.empty-wire {
padding: 5rem 1rem;
text-align: center;
font-family: "Georgia", serif;
color: #64748b;
}

@media (max-width: 900px) {
.featured-grid {
grid-template-columns: 1fr;
gap: 1.8rem;
}
.section-hero {
padding: 2rem 1.5rem;
}
.stats-bar {
grid-template-columns: 1fr;
gap: 1rem;
}
}
</style>
</head>
<body>
<!-- Línea indicadora de lectura en scroll -->
<div id="scroll-progress"></div>

<Header />
<main>
<!-- Hero Inmersivo con Vector Reactivo en Fondo -->
<section class="section-hero">
<div class="watermark-parallax" id="hero-watermark">
{meta.iconType === 'tech' && (
<svg viewBox="0 0 24 24" fill="currentColor">
<path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V18h-2v-1.07A6 6 0 0 1 6.07 12H5v-2h1.07A6 6 0 0 1 11 4.07V3h2v1.07A6 6 0 0 1 17.93 10H19v2h-1.07A6 6 0 0 1 13 16.93zM8 12a4 4 0 1 0 4-4 4 4 0 0 0-4 4z"/>
</svg>
)}
{meta.iconType === 'finance' && (
<svg viewBox="0 0 24 24" fill="currentColor">
<path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/>
</svg>
)}
{meta.iconType === 'geopolitics' && (
<svg viewBox="0 0 24 24" fill="currentColor">
<path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 17.93V17a3 3 0 0 0-3-3h-1v-2a1 1 0 0 1 1-1h4a1 1 0 0 0 1-1V8h1a2 2 0 0 0 2-2v-.41A8 8 0 0 1 13 19.93zM6 10a1 1 0 0 0-1 1v1h2a2 2 0 0 0 2-2z"/>
</svg>
)}
</div>

<div class="hero-kicker-badge">
<span class="live-dot"></span>
<span>{meta.kicker}</span>
</div>

<h1 class="hero-title">{meta.label}</h1>
<p class="hero-desc">{meta.desc}</p>

<div class="tags-cluster">
{meta.tags.map((t) => (
<span class="tag-pill">#{t}</span>
))}
</div>

<div class="stats-bar">
{meta.stats.map((s) => (
<div class="stat-box">
<span class="stat-label">{s.label}</span>
<span class="stat-val">{s.val}</span>
</div>
))}
</div>
</section>

<!-- Noticia Líder (Broadsheet Lead Story) -->
{leadStory && (
<section class="featured-section scroll-reveal">
<div class="featured-grid">
<div class="featured-img-wrap">
{leadStory.data.heroImage && (
<img src={leadStory.data.heroImage} alt={leadStory.data.title} class="featured-img" />
)}
</div>
<div>
<span class="featured-kicker">INFORME PRINCIPAL DE LA SECCIÓN</span>
<h2 class="featured-title">
<a href={"/blog/" + (leadStory.slug ?? leadStory.id) + "/"}>{leadStory.data.title}</a>
</h2>
<p class="featured-desc">{leadStory.data.description}</p>
<div class="featured-meta">
<span>Redacción News Internacional TEP</span>
<span>•</span>
<time>{leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
</div>
</div>
</div>
</section>
)}

<!-- Cuadrícula de Archivo Reactiva -->
{otherStories.length > 0 && (
<section>
<div class="grid-header scroll-reveal">
<h3 class="grid-title">Archivo de Investigaciones & Prospectiva</h3>
</div>
<div class="grid-container">
{otherStories.map((post) => (
<article class="card-item scroll-reveal">
{post.data.heroImage && (
<div class="card-img-box">
<img src={post.data.heroImage} alt={post.data.title} class="card-img" loading="lazy" />
</div>
)}
<div class="card-body">
<div>
<h4 class="card-title">
<a href={"/blog/" + (post.slug ?? post.id) + "/"}>{post.data.title}</a>
</h4>
<p class="card-desc">{post.data.description}</p>
</div>
<div class="card-footer">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Internacional
</div>
</div>
</article>
))}
</div>
</section>
)}

{posts.length === 0 && (
<div class="empty-wire scroll-reveal">
<h3>Edición en Monitoreo Continuo</h3>
<p>Los sistemas autónomos están contrastando coberturas internacionales para esta sección.</p>
</div>
)}
</main>
<Footer />

<!-- Script Reactivo al Desplazamiento (Scroll Parallax & Reveals) -->
<script is:inline>
// 1. Barra de progreso superior
window.addEventListener('scroll', () => {
const scrollTop = window.scrollY;
const docHeight = document.documentElement.scrollHeight - window.innerHeight;
const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
const bar = document.getElementById('scroll-progress');
if (bar) bar.style.width = scrollPercent + '%';

// 2. Parallax suave en el vector del banner
const watermark = document.getElementById('hero-watermark');
if (watermark) {
watermark.style.transform = `translateY(${scrollTop * 0.18}px) rotate(${scrollTop * 0.04}deg)`;
}
});

// 3. Animación de revelado al entrar en pantalla (IntersectionObserver)
const observer = new IntersectionObserver((entries) => {
entries.forEach((entry) => {
if (entry.isIntersecting) {
entry.target.classList.add('is-visible');
}
});
}, {
threshold: 0.12,
rootMargin: '0px 0px -40px 0px'
});

document.querySelectorAll('.scroll-reveal').forEach((el) => {
observer.observe(el);
});
</script>
</body>
</html>