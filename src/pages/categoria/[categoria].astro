---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
const allPosts = await getCollection('blog');

const categories = [
{
slug: 'tecnologia',
label: 'Tecnología & Inteligencia Artificial',
desc: 'Monitoreo de semiconductores, computación cuántica, centros de datos y desarrollo algorítmico.',
accentColor: '#2563eb',
accentSoft: 'rgba(37, 99, 235, 0.2)',
bgHero: 'linear-gradient(135deg, #090d16 0%, #172554 100%)',
statusText: 'Vigilancia Tecnológica Activa',
tags: ['Semiconductores', 'Modelos de Frontera', 'Ciberdefensa', 'Computación Cuántica'],
iconType: 'tech',
match: ['tecnología', 'tecnologia', 'ia', 'inteligencia', 'tech', 'software', 'hardware']
},
{
slug: 'economia',
label: 'Economía, Mercados & Finanzas',
desc: 'Rastreo de liquidez global, políticas de bancos centrales, renta fija, materias primas y deuda soberana.',
accentColor: '#059669',
accentSoft: 'rgba(5, 150, 105, 0.2)',
bgHero: 'linear-gradient(135deg, #04140d 0%, #064e3b 100%)',
statusText: 'Monitor de Mercados en Vivo',
tags: ['Bancos Centrales', 'Renta Variable', 'Materias Primas', 'Deuda Soberana'],
iconType: 'finance',
match: ['economía', 'economia', 'mercados', 'finanzas', 'bancos', 'inflación', 'patrimonial']
},
{
slug: 'geopolitica',
label: 'Geopolítica & Orden Global',
desc: 'Evaluación del balance de poder, seguridad euroatlántica, tratados multilaterales y sanciones.',
accentColor: '#dc2626',
accentSoft: 'rgba(220, 38, 38, 0.2)',
bgHero: 'linear-gradient(135deg, #180909 0%, #7f1d1d 100%)',
statusText: 'Radar Geoestratégico Activo',
tags: ['Seguridad Colectiva', 'Indo-Pacífico', 'Guerra Híbrida', 'Sanciones'],
iconType: 'geopolitics',
match: ['política', 'politica', 'geopolítica', 'geopolitica', 'seguridad', 'defensa', 'diplomacia']
},
];

return categories.map((cat) => {
const filteredPosts = allPosts
.filter((post) => {
const postCat = (post.data.category || '').toLowerCase();
return cat.match.some((m) => postCat.includes(m));
})
.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

return {
params: { categoria: cat.slug },
props: { meta: cat, posts: filteredPosts },
};
});
}

const { meta, posts } = Astro.props;
const leadStory = posts[0];
const otherStories = posts.slice(1);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead
title={meta.label + " | News Internacional TEP"}
description={meta.desc}
/>
<style define:vars={{
accent: meta.accentColor,
accentSoft: meta.accentSoft,
bgHero: meta.bgHero
}}>
:global(body) {
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
/* CONTENEDOR PANORÁMICO ANCHO */
main {
max-width: 1580px;
width: 94%;
margin: 0 auto;
padding: 2rem 0 6rem;
}

/* BANNER HORIZONTAL EXTENDIDO AL 100% */
.section-header-banner {
background: var(--bgHero);
color: #ffffff;
border-left: 5px solid var(--accent);
border-radius: 8px;
padding: 2.2rem 2.8rem;
margin-bottom: 3.5rem;
display: flex;
align-items: center;
gap: 2.5rem;
box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
width: 100%;
box-sizing: border-box;
}

.banner-side-icon {
width: 82px;
height: 82px;
border-radius: 12px;
background: rgba(255, 255, 255, 0.08);
border: 1px solid rgba(255, 255, 255, 0.15);
display: flex;
align-items: center;
justify-content: center;
color: var(--accent);
flex-shrink: 0;
}
.icon-currency-sign {
font-size: 3rem;
font-weight: 900;
font-family: system-ui, sans-serif;
color: #10b981;
}

.banner-content-body {
flex: 1;
}
.banner-title-line {
display: flex;
align-items: center;
gap: 1.4rem;
margin-bottom: 0.5rem;
flex-wrap: wrap;
}
.banner-heading-text {
font-size: clamp(2rem, 3.4vw, 2.7rem);
font-weight: 900;
letter-spacing: -0.03em;
margin: 0;
color: #ffffff;
line-height: 1.15;
}

.section-pulse-badge {
display: inline-flex;
align-items: center;
gap: 7px;
background: rgba(255, 255, 255, 0.08);
border: 1px solid rgba(255, 255, 255, 0.2);
color: #ffffff;
font-size: 0.74rem;
font-weight: 800;
padding: 0.25rem 0.8rem;
border-radius: 20px;
text-transform: uppercase;
letter-spacing: 0.05em;
box-shadow: 0 0 12px var(--accentSoft);
}
.custom-pulse-dot {
width: 7px;
height: 7px;
border-radius: 50%;
background: var(--accent);
box-shadow: 0 0 8px var(--accent);
animation: dynamicPulse 1.5s infinite ease-in-out;
}
@keyframes dynamicPulse {
0%, 100% { transform: scale(0.9); opacity: 0.8; }
50% { transform: scale(1.3); opacity: 1; }
}

.banner-summary {
font-size: 1.1rem;
color: #cbd5e1;
line-height: 1.55;
margin: 0 0 1.2rem;
}
.banner-tags-list {
display: flex;
flex-wrap: wrap;
gap: 0.5rem;
}
.banner-tag-pill {
background: rgba(255, 255, 255, 0.06);
border: 1px solid rgba(255, 255, 255, 0.12);
color: #e2e8f0;
font-size: 0.76rem;
font-weight: 700;
padding: 0.25rem 0.75rem;
border-radius: 16px;
}

/* Noticia Líder Extendida */
.lead-card-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2.5rem;
margin-bottom: 3.5rem;
box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
width: 100%;
box-sizing: border-box;
}
.lead-grid {
display: grid;
grid-template-columns: 1.4fr 1fr;
gap: 3rem;
align-items: center;
}
.lead-img-box {
border-radius: 6px;
overflow: hidden;
max-height: 480px;
}
.lead-img {
width: 100%;
height: 100%;
max-height: 480px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-card-box:hover .lead-img {
transform: scale(1.02);
}
.lead-kicker {
font-size: 0.78rem;
font-weight: 900;
color: var(--accent);
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.6rem;
display: block;
}
.lead-title {
font-size: clamp(2rem, 3vw, 2.7rem);
line-height: 1.2;
font-weight: 900;
letter-spacing: -0.02em;
margin: 0 0 1.2rem;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: var(--accent);
}
.lead-desc {
font-size: 1.2rem;
color: #475569;
line-height: 1.6;
margin-bottom: 1.5rem;
}
.lead-meta {
font-size: 0.84rem;
color: #64748b;
font-weight: 600;
border-top: 1px solid #f1f5f9;
padding-top: 1rem;
}

/* Cuadrícula de Archivo Amplia */
.section-heading-bar {
border-bottom: 2px solid #0f172a;
padding-bottom: 0.8rem;
margin-bottom: 2.2rem;
width: 100%;
}
.section-heading-title {
font-size: 1.6rem;
font-weight: 900;
letter-spacing: -0.02em;
color: #0f172a;
margin: 0;
}
.stories-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
gap: 2.5rem;
width: 100%;
}
.story-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.story-card:hover {
transform: translateY(-5px);
box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.08);
}
.story-img-wrap {
width: 100%;
height: 220px;
overflow: hidden;
}
.story-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.story-card:hover .story-img {
transform: scale(1.04);
}
.story-body {
padding: 1.6rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.story-title {
font-size: 1.25rem;
line-height: 1.35;
font-weight: 800;
letter-spacing: -0.02em;
margin: 0 0 0.8rem;
color: #0f172a;
}
.story-title a {
color: inherit;
text-decoration: none;
}
.story-title a:hover {
color: var(--accent);
}
.story-desc {
font-size: 0.92rem;
color: #475569;
line-height: 1.55;
margin-bottom: 1.2rem;
}
.story-footer {
font-size: 0.78rem;
color: #94a3b8;
font-weight: 600;
border-top: 1px solid #f8fafc;
padding-top: 0.8rem;
}

.empty-wire {
padding: 5rem 1rem;
text-align: center;
color: #64748b;
}

@media (max-width: 900px) {
.section-header-banner { flex-direction: column; align-items: flex-start; }
.lead-grid { grid-template-columns: 1fr; gap: 1.8rem; }
}
</style>
</head>
<body>
<Header />
<main>
<!-- Banner Horizontal Extendido al 100% -->
<section class="section-header-banner">
<div class="banner-side-icon">
{meta.iconType === 'tech' && (
<svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
<line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
</svg>
)}
{meta.iconType === 'finance' && (
<div class="icon-currency-sign">$</div>
)}
{meta.iconType === 'geopolitics' && (
<svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<line x1="2" y1="12" x2="22" y2="12"/>
<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>
)}
</div>

<div class="banner-content-body">
<div class="banner-title-line">
<h1 class="banner-heading-text">{meta.label}</h1>
<div class="section-pulse-badge">
<span class="custom-pulse-dot"></span>
<span>{meta.statusText}</span>
</div>
</div>
<p class="banner-summary">{meta.desc}</p>
<div class="banner-tags-list">
{meta.tags.map((t) => (
<span class="banner-tag-pill">#{t}</span>
))}
</div>
</div>
</section>

<!-- Noticia Líder -->
{leadStory && (
<section class="lead-card-box">
<div class="lead-grid">
<div class="lead-img-box">
{leadStory.data.heroImage && (
<img src={leadStory.data.heroImage} alt={leadStory.data.title} class="lead-img" />
)}
</div>
<div>
<span class="lead-kicker">INFORME DESTACADO</span>
<h2 class="lead-title">
<a href={"/blog/" + (leadStory.slug ?? leadStory.id) + "/"}>{leadStory.data.title}</a>
</h2>
<p class="lead-desc">{leadStory.data.description}</p>
<div class="lead-meta">
<span>Redacción News Internacional TEP</span>
<span>•</span>
<time>{leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
</div>
</div>
</div>
</section>
)}

<!-- Cuadrícula de Archivo -->
{otherStories.length > 0 && (
<section>
<div class="section-heading-bar">
<h3 class="section-heading-title">Archivo de Investigaciones & Prospectiva</h3>
</div>
<div class="stories-grid">
{otherStories.map((post) => (
<article class="story-card">
{post.data.heroImage && (
<div class="story-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="story-img" loading="lazy" />
</div>
)}
<div class="story-body">
<div>
<h4 class="story-title">
<a href={"/blog/" + (post.slug ?? post.id) + "/"}>{post.data.title}</a>
</h4>
<p class="story-desc">{post.data.description}</p>
</div>
<div class="story-footer">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Internacional
</div>
</div>
</article>
))}
</div>
</section>
)}

{posts.length === 0 && (
<div class="empty-wire">
<h3>Edición en Monitoreo Continuo</h3>
<p>Los sistemas autónomos están contrastando coberturas internacionales para esta sección.</p>
</div>
)}
</main>
<Footer />
</body>
</html>