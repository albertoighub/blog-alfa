---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 4);

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica'])).slice(0, 3);
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas'])).slice(0, 3);
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia'])).slice(0, 3);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Cobertura Periodística Independiente" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #fbfbfb;
color: #111827;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
main {
max-width: 1220px;
margin: 0 auto;
padding: 1.2rem 1rem 5rem;
}
/* Franja Última Hora */
.breaking-banner {
background: #991b1b;
color: #ffffff;
display: flex;
align-items: center;
padding: 0.55rem 1rem;
font-size: 0.85rem;
margin-bottom: 2rem;
border-radius: 3px;
gap: 1rem;
}
.breaking-tag {
background: #ffffff;
color: #991b1b;
font-weight: 900;
padding: 0.2rem 0.55rem;
font-size: 0.72rem;
text-transform: uppercase;
letter-spacing: 0.08em;
white-space: nowrap;
}
.breaking-text {
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
flex: 1;
}
.breaking-text a {
color: #ffffff;
text-decoration: none;
font-weight: 600;
}
.breaking-text a:hover {
text-decoration: underline;
}

/* Gran Formato Broadsheet Lead */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.3fr 1fr;
gap: 2.5rem;
padding-bottom: 3rem;
border-bottom: 2px solid #111827;
margin-bottom: 3rem;
}
.lead-col {
border-right: 1px solid #e5e7eb;
padding-right: 2.5rem;
}
.lead-category {
font-size: 0.75rem;
font-weight: 900;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.6rem;
display: block;
}
.lead-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2.1rem, 3.4vw, 3rem);
line-height: 1.15;
font-weight: 700;
margin: 0 0 1.2rem;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: #1e3a8a;
}
.lead-media {
margin-bottom: 1.2rem;
border-radius: 4px;
overflow: hidden;
}
.lead-media img {
width: 100%;
max-height: 420px;
object-fit: cover;
display: block;
}
.lead-summary {
font-family: "Georgia", serif;
font-size: 1.22rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1rem;
}
.lead-byline {
font-size: 0.8rem;
color: #64748b;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 0.05em;
}

/* Radar Lateral */
.side-col {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.section-kicker {
font-size: 0.85rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.08em;
border-bottom: 2px solid #111827;
padding-bottom: 0.4rem;
margin: 0 0 0.5rem;
color: #0f172a;
}
.side-item {
border-bottom: 1px solid #e5e7eb;
padding-bottom: 1.2rem;
}
.side-item:last-child {
border-bottom: none;
padding-bottom: 0;
}
.side-img {
width: 100%;
height: 140px;
object-fit: cover;
border-radius: 3px;
margin-bottom: 0.6rem;
display: block;
}
.side-category {
font-size: 0.68rem;
font-weight: 800;
color: #b91c1c;
text-transform: uppercase;
margin-bottom: 0.3rem;
}
.side-title {
font-family: "Georgia", serif;
font-size: 1.15rem;
line-height: 1.35;
font-weight: 700;
margin: 0 0 0.4rem;
}
.side-title a {
color: #111827;
text-decoration: none;
}
.side-title a:hover {
color: #1e3a8a;
}
.side-desc {
font-size: 0.86rem;
color: #64748b;
line-height: 1.45;
margin: 0 0 0.4rem;
}
.side-date {
font-size: 0.75rem;
color: #94a3b8;
}

/* Banner Alertas */
.institutional-alert {
background: #f8fafc;
border-left: 4px solid #0284c7;
border-top: 1px solid #e2e8f0;
border-right: 1px solid #e2e8f0;
border-bottom: 1px solid #e2e8f0;
padding: 1.2rem 1.6rem;
margin-bottom: 3.5rem;
display: flex;
justify-content: space-between;
align-items: center;
flex-wrap: wrap;
gap: 1rem;
}
.alert-heading {
font-size: 1.05rem;
font-weight: 800;
margin: 0 0 0.2rem;
color: #0f172a;
}
.alert-sub {
margin: 0;
font-size: 0.88rem;
color: #475569;
}
.alert-btn {
background: #0284c7;
color: #ffffff !important;
font-weight: 700;
font-size: 0.82rem;
padding: 0.55rem 1.2rem;
text-decoration: none;
border-radius: 4px;
text-transform: uppercase;
}

/* Bloques Temáticos */
.category-block {
margin-bottom: 4rem;
}
.category-block-header {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #111827;
padding-bottom: 0.5rem;
margin-bottom: 1.8rem;
}
.block-title {
font-family: "Georgia", serif;
font-size: 1.6rem;
font-weight: 800;
color: #0f172a;
margin: 0;
}
.block-more-link {
font-size: 0.82rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
color: #1e3a8a;
text-decoration: none;
}
.block-more-link:hover {
text-decoration: underline;
}
.block-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 2.2rem;
}
.block-card {
border-top: 1px solid #e5e7eb;
padding-top: 1.2rem;
display: flex;
flex-direction: column;
justify-content: space-between;
}
.block-card-img {
width: 100%;
height: 180px;
object-fit: cover;
border-radius: 3px;
margin-bottom: 0.8rem;
}
.block-card-title {
font-family: "Georgia", serif;
font-size: 1.22rem;
line-height: 1.35;
font-weight: 700;
margin: 0 0 0.6rem;
}
.block-card-title a {
color: #111827;
text-decoration: none;
}
.block-card-title a:hover {
color: #1e3a8a;
}
.block-card-desc {
font-size: 0.92rem;
color: #475569;
line-height: 1.55;
margin: 0 0 0.8rem;
}
.block-card-date {
font-size: 0.78rem;
color: #94a3b8;
}

.empty-state {
padding: 3rem 0;
text-align: center;
font-family: "Georgia", serif;
color: #64748b;
}

@media (max-width: 900px) {
.broadsheet-layout {
grid-template-columns: 1fr;
gap: 2rem;
}
.lead-col {
border-right: none;
padding-right: 0;
border-bottom: 1px solid #e5e7eb;
padding-bottom: 2rem;
}
}
</style>
</head>
<body>
<Header />
<main>
{leadStory ? (
<>
<div class="breaking-banner">
<span class="breaking-tag">ÚLTIMA HORA</span>
<div class="breaking-text">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>
{leadStory.data.title}
</a>
</div>
</div>

<div class="broadsheet-layout">
<section class="lead-col">
<span class="lead-category">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
{leadStory.data.heroImage && (
<div class="lead-media">
<img src={leadStory.data.heroImage} alt={leadStory.data.title} />
</div>
)}
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-byline">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>

<aside class="side-col">
<h3 class="section-kicker">RADAR ESTRATÉGICO</h3>
{sideStories.map((post) => (
<article class="side-item">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="side-img" />
)}
<div class="side-category">{post.data.category || 'Global'}</div>
<h4 class="side-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="side-desc">{post.data.description}</p>
<div class="side-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })}
</div>
</article>
))}
</aside>
</div>

<div class="institutional-alert">
<div>
<h4 class="alert-heading">Sindicación de Informes en Tiempo Real</h4>
<p class="alert-sub">Monitoreo continuo de acontecimientos geopolíticos y financieros sin algoritmos mediadores.</p>
</div>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="alert-btn">
Acceso al Canal Telegram
</a>
</div>

{postsGeopolitica.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Geopolítica & Política Global</h3>
<a href="/categoria/geopolitica" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsGeopolitica.map((post) => (
<article class="block-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="block-card-img" />
)}
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}

{postsEconomia.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Economía, Mercados & Finanzas</h3>
<a href="/categoria/economia" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsEconomia.map((post) => (
<article class="block-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="block-card-img" />
)}
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}

{postsTecnologia.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Tecnología & Inteligencia Artificial</h3>
<a href="/categoria/tecnologia" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsTecnologia.map((post) => (
<article class="block-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="block-card-img" />
)}
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}
</>
) : (
<div class="empty-state">
<h2>Edición en Preparación</h2>
<p>El motor editorial autónomo está compilando y contrastando los nuevos análisis de inteligencia global. La portada se actualizará en unos instantes.</p>
</div>
)}
</main>
<Footer />
</body>
</html>