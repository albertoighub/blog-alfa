---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 4);

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica']));
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas']));
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia']));
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Cobertura Periodística & Mercados Globales" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main {
max-width: 1240px;
margin: 0 auto;
padding: 1.5rem 1rem 6rem;
}

/* Franja Última Hora */
.breaking-ribbon {
background: #991b1b;
color: #ffffff;
display: flex;
align-items: center;
padding: 0.55rem 1rem;
font-size: 0.84rem;
margin-bottom: 2rem;
border-radius: 4px;
gap: 1rem;
box-shadow: 0 4px 12px rgba(153, 27, 27, 0.15);
}
.breaking-badge {
background: #ffffff;
color: #991b1b;
font-weight: 900;
padding: 0.2rem 0.6rem;
font-size: 0.7rem;
text-transform: uppercase;
letter-spacing: 0.08em;
border-radius: 2px;
white-space: nowrap;
}
.breaking-title {
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
flex: 1;
}
.breaking-title a {
color: #ffffff;
text-decoration: none;
font-weight: 700;
}
.breaking-title a:hover {
text-decoration: underline;
}

/* BANNER PANORÁMICO DE RADAR GLOBAL (Sustituye a los recuadros viejos) */
.strategic-radar-strip {
background: linear-gradient(135deg, #090d16 0%, #1e293b 100%);
color: #ffffff;
border-radius: 8px;
padding: 1.6rem 2rem;
margin-bottom: 3rem;
display: grid;
grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
gap: 1.5rem;
border-top: 3px solid #1e3a8a;
box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
}
.radar-pill-item {
display: flex;
align-items: center;
gap: 1.2rem;
padding: 0.8rem 1rem;
background: rgba(255, 255, 255, 0.04);
border: 1px solid rgba(255, 255, 255, 0.08);
border-radius: 8px;
text-decoration: none;
color: inherit;
transition: all 0.25s ease;
}
.radar-pill-item:hover {
background: rgba(255, 255, 255, 0.1);
transform: translateY(-2px);
border-color: rgba(255, 255, 255, 0.2);
}
.radar-icon-box {
width: 44px;
height: 44px;
border-radius: 8px;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}
.icon-geo { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
.icon-fin { background: rgba(16, 185, 129, 0.15); color: #10b981; }
.icon-tech { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.radar-pill-content h4 {
margin: 0 0 0.2rem;
font-size: 0.95rem;
font-weight: 800;
color: #ffffff;
}
.radar-pill-content p {
margin: 0;
font-size: 0.78rem;
color: #94a3b8;
}

/* Broadsheet Lead & Radar Lateral */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.2fr 1fr;
gap: 2.5rem;
padding-bottom: 3.5rem;
border-bottom: 2px solid #0f172a;
margin-bottom: 3.5rem;
}
.lead-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2rem;
box-shadow: 0 8px 20px rgba(0,0,0,0.03);
}
.lead-cat {
font-size: 0.76rem;
font-weight: 900;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.6rem;
display: block;
}
.lead-title {
font-size: clamp(2rem, 3.2vw, 2.7rem);
line-height: 1.18;
font-weight: 900;
margin: 0 0 1.2rem;
letter-spacing: -0.03em;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: #1e3a8a;
}
.lead-media {
margin-bottom: 1.4rem;
border-radius: 6px;
overflow: hidden;
max-height: 420px;
}
.lead-media img {
width: 100%;
height: 100%;
max-height: 420px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-box:hover .lead-media img {
transform: scale(1.03);
}
.lead-summary {
font-size: 1.18rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1.2rem;
}
.lead-meta {
font-size: 0.8rem;
color: #64748b;
font-weight: 600;
border-top: 1px solid #f1f5f9;
padding-top: 1rem;
}

.radar-box {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.radar-heading {
font-size: 0.85rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.08em;
border-bottom: 2px solid #0f172a;
padding-bottom: 0.5rem;
margin: 0;
color: #0f172a;
}
.radar-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 6px;
overflow: hidden;
padding: 1rem;
transition: transform 0.2s ease;
}
.radar-card:hover {
transform: translateY(-3px);
}
.radar-img {
width: 100%;
height: 130px;
object-fit: cover;
border-radius: 4px;
margin-bottom: 0.6rem;
}
.radar-cat {
font-size: 0.68rem;
font-weight: 800;
color: #b91c1c;
text-transform: uppercase;
margin-bottom: 0.3rem;
}
.radar-title {
font-size: 1.05rem;
line-height: 1.35;
font-weight: 800;
margin: 0 0 0.4rem;
}
.radar-title a {
color: #0f172a;
text-decoration: none;
}
.radar-title a:hover {
color: #1e3a8a;
}
.radar-desc {
font-size: 0.84rem;
color: #64748b;
line-height: 1.45;
margin: 0 0 0.4rem;
}

/* Secciones Temáticas - Todas las Noticias */
.category-section-wrap {
margin-bottom: 4rem;
}
.section-bar {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #0f172a;
padding-bottom: 0.6rem;
margin-bottom: 2rem;
}
.section-name {
font-size: 1.6rem;
font-weight: 900;
letter-spacing: -0.02em;
color: #0f172a;
margin: 0;
}
.section-link {
font-size: 0.8rem;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 0.06em;
color: #1e3a8a;
text-decoration: none;
}
.section-link:hover {
text-decoration: underline;
}
.articles-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 2rem;
}
.article-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.article-card:hover {
transform: translateY(-5px);
box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
}
.article-img-wrap {
width: 100%;
height: 190px;
overflow: hidden;
}
.article-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.article-card:hover .article-img {
transform: scale(1.04);
}
.article-body {
padding: 1.4rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.article-title {
font-size: 1.2rem;
line-height: 1.35;
font-weight: 800;
letter-spacing: -0.02em;
margin: 0 0 0.6rem;
color: #0f172a;
}
.article-title a {
color: inherit;
text-decoration: none;
}
.article-title a:hover {
color: #1e3a8a;
}
.article-desc {
font-size: 0.9rem;
color: #475569;
line-height: 1.55;
margin-bottom: 1.2rem;
}
.article-date {
font-size: 0.76rem;
color: #94a3b8;
font-weight: 600;
border-top: 1px solid #f8fafc;
padding-top: 0.6rem;
}

@media (max-width: 900px) {
.broadsheet-layout {
grid-template-columns: 1fr;
gap: 2rem;
}
}
</style>
</head>
<body>
<Header />

<main>
{leadStory && (
<div class="breaking-ribbon">
<span class="breaking-badge">ÚLTIMA HORA</span>
<div class="breaking-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>
{leadStory.data.title}
</a>
</div>
</div>
)}

<!-- BANNER PANORÁMICO DE EJES TEMÁTICOS CON ICONOS -->
<section class="strategic-radar-strip">
<a href="/categoria/geopolitica" class="radar-pill-item">
<div class="radar-icon-box icon-geo">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<line x1="2" y1="12" x2="22" y2="12"/>
<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>
</div>
<div class="radar-pill-content">
<h4>Radar Geopolítico</h4>
<p>Seguridad euroatlántica & diplomacia</p>
</div>
</a>

<a href="/categoria/economia" class="radar-pill-item">
<div class="radar-icon-box icon-fin">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<line x1="12" y1="1" x2="12" y2="23"/>
<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
<polyline points="3 17 9 11 13 15 21 7"/>
</svg>
</div>
<div class="radar-pill-content">
<h4>Mesa Macroeconómica</h4>
<p>Bancos centrales & deuda soberana</p>
</div>
</a>

<a href="/categoria/tecnologia" class="radar-pill-item">
<div class="radar-icon-box icon-tech">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
<line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
</svg>
</div>
<div class="radar-pill-content">
<h4>Frontera Tecnológica</h4>
<p>Semiconductores & computación cuántica</p>
</div>
</a>
</section>

<!-- PRIMERA PLANA BROADSHEET -->
{leadStory && (
<div class="broadsheet-layout">
<section class="lead-box">
<span class="lead-cat">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
{leadStory.data.heroImage && (
<div class="lead-media">
<img src={leadStory.data.heroImage} alt={leadStory.data.title} />
</div>
)}
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-meta">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>

<aside class="radar-box">
<h3 class="radar-heading">RADAR DE COBERTURA</h3>
{sideStories.map((post) => (
<article class="radar-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="radar-img" />
)}
<div class="radar-cat">{post.data.category || 'Global'}</div>
<h4 class="radar-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="radar-desc">{post.data.description}</p>
</article>
))}
</aside>
</div>
)}

<!-- TODAS LAS NOTICIAS POR SECCIONES -->
{postsGeopolitica.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Geopolítica & Orden Global</h3>
<a href="/categoria/geopolitica" class="section-link">Ver archivo ({postsGeopolitica.length}) →</a>
</div>
<div class="articles-grid">
{postsGeopolitica.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Geopolítica
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsEconomia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Economía, Mercados & Finanzas</h3>
<a href="/categoria/economia" class="section-link">Ver archivo ({postsEconomia.length}) →</a>
</div>
<div class="articles-grid">
{postsEconomia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Mercados
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsTecnologia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Tecnología & Inteligencia Artificial</h3>
<a href="/categoria/tecnologia" class="section-link">Ver archivo ({postsTecnologia.length}) →</a>
</div>
<div class="articles-grid">
{postsTecnologia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Tecnología
</div>
</div>
</article>
))}
</div>
</section>
)}
</main>

<Footer />
</body>
</html>