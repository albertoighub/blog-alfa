      justify-content: space-between;
    }
    .carousel-meta-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.65rem;
      font-weight: 850;
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }
    .carousel-cat-badge {
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      color: #ffffff;
      font-size: 0.62rem;
      line-height: 1;
    }
    .carousel-item-title {
      font-size: 0.85rem;
      font-weight: 850;
      line-height: 1.3;
      margin: 0 0 0.4rem;
