---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 5); // Mostramos 4 en el radar lateral

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica']));
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas']));
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia']));
const postsCiencia = sortedPosts.filter((p) => matchesCat(p, ['ciencia', 'medicina', 'salud', 'biotecnología', 'fármacos', 'cáncer', 'investigación']));
const postsTendencias = sortedPosts.filter((p) => matchesCat(p, ['tendencias', 'redes', 'viral', 'cultura digital', 'revuelo', 'plataformas', 'debates', 'audiencias', 'creadores']));

// 12 historias dinámicas para el ticker continuo
const breakingList = sortedPosts.slice(0, 12).map((p) => ({
title: p.data.title,
category: p.data.category || 'Actualidad',
url: `/blog/${p.slug ?? p.id}/`,
}));
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Investigación & Mercados Globales" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) { margin: 0 !important; padding: 0 !important; width: 100vw !important; max-width: 100% !important; overflow-x: hidden !important;
background-color: #f8fafc;
color: #050505;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main {
max-width: 1580px;
width: 94%;
margin: 0 auto;
padding: 1.5rem 0 6rem;
}

/* 1. ÚLTIMA HORA */
.breaking-marquee-strip {
background: #b91c1c;
color: #ffffff;
display: flex;
align-items: center;
height: 44px;
border-radius: 6px;
margin-bottom: 3rem;
overflow: hidden;
box-shadow: 0 4px 15px rgba(185, 28, 28, 0.2);
width: 100%;
}
.breaking-fixed-tag {
background: #050505;
height: 100%;
padding: 0 1.4rem;
display: flex;
align-items: center;
gap: 8px;
font-size: 0.74rem;
font-weight: 900;
letter-spacing: 0.1em;
text-transform: uppercase;
flex-shrink: 0;
z-index: 3;
border-right: 2px solid #dc2626;
}
.breaking-pulse-dot {
width: 8px;
height: 8px;
border-radius: 50%;
background: #dc2626;
box-shadow: 0 0 8px #dc2626;
animation: pulseDot 1.4s infinite ease-in-out;
}
@keyframes pulseDot {
0%, 100% { transform: scale(0.9); opacity: 0.8; }
50% { transform: scale(1.25); opacity: 1; }
}
.breaking-track-container {
flex: 1;
height: 100%;
overflow: hidden;
white-space: nowrap;
position: relative;
display: flex;
align-items: center;
}
.ticker-news-group {
display: inline-flex;
align-items: center;
gap: 2.5rem;
padding-right: 2.5rem;
flex-shrink: 0;
}
.breaking-animated-track {
display: flex;
align-items: center;
width: max-content;
will-change: transform;
animation: marqueeNews 45s linear infinite;
}
.breaking-marquee-strip:hover .breaking-animated-track {
animation-play-state: paused;
}
.breaking-link-item {
color: #ffffff;
text-decoration: none;
font-size: 0.88rem;
font-weight: 700;
display: inline-flex;
align-items: center;
gap: 0.7rem;
transition: opacity 0.15s ease;
}
.breaking-link-item:hover {
opacity: 0.85;
}
.breaking-category-pill {
background: #ffffff;
color: #050505;
font-size: 0.68rem;
font-weight: 900;
padding: 0.2rem 0.55rem;
border-radius: 3px;
text-transform: uppercase;
letter-spacing: 0.05em;
line-height: 1;
flex-shrink: 0;
}
.breaking-dot-sep {
color: rgba(255, 255, 255, 0.45);
margin-left: 1.5rem;
font-size: 1.1rem;
}
@keyframes marqueeNews {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

/* 2. BROADSHEET (Más compacta) */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.7fr 1.1fr;
gap: 2.5rem;
padding-bottom: 3.5rem;
border-bottom: 2px solid #050505;
margin-bottom: 3.5rem;
width: 100%;
}
.lead-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2rem;
box-shadow: 0 8px 20px rgba(0,0,0,0.03);
}
.lead-cat {
font-size: 0.74rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
letter-spacing: 0.1em;
margin-bottom: 0.8rem;
display: block;
}
.lead-title {
font-size: clamp(1.8rem, 3vw, 2.6rem);
line-height: 1.15;
font-weight: 950;
margin: 0 0 1.2rem;
letter-spacing: -0.03em;
color: #050505;
}
.lead-title a { color: inherit; text-decoration: none; }
.lead-title a:hover { color: #dc2626; }
.lead-media {
margin-bottom: 1.2rem;
border-radius: 6px;
overflow: hidden;
max-height: 460px;
}
.lead-media img {
width: 100%;
height: 100%;
max-height: 460px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-box:hover .lead-media img { transform: scale(1.02); }
.lead-summary {
font-size: 1.1rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1.2rem;
}
.lead-meta {
font-size: 0.8rem;
color: #64748b;
font-weight: 700;
border-top: 1px solid #f1f5f9;
padding-top: 1rem;
}

.radar-box {
display: flex;
flex-direction: column;
gap: 1.4rem;
}
.radar-heading {
font-size: 0.84rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.1em;
border-bottom: 2px solid #050505;
padding-bottom: 0.5rem;
margin: 0;
color: #050505;
}
.radar-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
padding: 1rem;
transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.radar-card:hover {
transform: translateY(-3px);
box-shadow: 0 8px 16px -4px rgba(0,0,0,0.06);
}
.radar-img {
width: 100%;
height: 140px;
object-fit: cover;
border-radius: 6px;
margin-bottom: 0.6rem;
}
.radar-cat {
font-size: 0.68rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
margin-bottom: 0.3rem;
}
.radar-title {
font-size: 1rem;
line-height: 1.35;
font-weight: 800;
margin: 0 0 0.4rem;
}
.radar-title a { color: #050505; text-decoration: none; }
.radar-title a:hover { color: #dc2626; }
.radar-desc {
font-size: 0.82rem;
color: #64748b;
line-height: 1.45;
margin: 0;
display: -webkit-box;
-webkit-line-clamp: 2;
-webkit-box-orient: vertical;
overflow: hidden;
}

/* 3. SECCIONES PANORÁMICAS COMPACTADAS */
.category-section-wrap {
margin-bottom: 4rem;
width: 100%;
}
.section-bar {
display: flex;
justify-content: space-between;
align-items: center;
border-bottom: 2px solid #050505;
padding-bottom: 0.8rem;
margin-bottom: 2rem;
position: relative;
}
.section-name {
font-size: 1.55rem;
font-weight: 950;
letter-spacing: -0.02em;
color: #050505;
margin: 0;
display: flex;
align-items: center;
gap: 0.6rem;
}
.section-link {
font-size: 0.78rem;
font-weight: 850;
text-transform: uppercase;
letter-spacing: 0.08em;
color: #050505;
text-decoration: none;
padding: 0.35rem 0.9rem;
border-radius: 20px;
border: 1px solid #cbd5e1;
background: #ffffff;
transition: all 0.2s ease;
}
.section-link:hover {
color: #ffffff;
background: #050505;
border-color: #050505;
transform: translateX(3px);
}
.articles-grid {
display: grid;
/* Reducido a 260px para acomodar más artículos por fila */
grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
gap: 2rem;
width: 100%;
}
.article-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.article-card:hover {
transform: translateY(-4px);
box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
}
.article-img-wrap {
width: 100%;
height: 160px; /* Reducido para ahorrar espacio */
overflow: hidden;
}
.article-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.article-card:hover .article-img { transform: scale(1.04); }
.article-body {
padding: 1.2rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.article-title {
font-size: 1.1rem;
line-height: 1.35;
font-weight: 850;
letter-spacing: -0.02em;
margin: 0 0 0.6rem;
color: #050505;
}
.article-title a { color: inherit; text-decoration: none; }
.article-title a:hover { color: #dc2626; }
.article-desc {
font-size: 0.88rem;
color: #475569;
line-height: 1.5;
margin-bottom: 1.2rem;
display: -webkit-box;
-webkit-line-clamp: 3;
-webkit-box-orient: vertical;
overflow: hidden;
}
.article-date {
font-size: 0.74rem;
color: #94a3b8;
font-weight: 700;
border-top: 1px solid #f8fafc;
padding-top: 0.6rem;
}

@media (max-width: 1024px) {
.broadsheet-layout { grid-template-columns: 1fr; gap: 2rem; }
}
            /* ANIMACION DE MATERIALIZACION ESCALONADA (Portada) */
            main > * {
                animation: materialize 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
                will-change: transform, opacity, filter;
            }
            main > *:nth-child(1) { animation-delay: 0.1s; }
            main > *:nth-child(2) { animation-delay: 0.25s; }
            main > *:nth-child(3) { animation-delay: 0.4s; }
            main > *:nth-child(4) { animation-delay: 0.55s; }
            main > *:nth-child(5) { animation-delay: 0.7s; }
            main > *:nth-child(6) { animation-delay: 0.85s; }

            @keyframes materialize {
                0% { opacity: 0; transform: translateY(25px) scale(0.98); filter: blur(5px); }
                100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
            }
</style>
</head>
<body>
<Header />

<main>
<!-- Ticker Última Hora Centrado Continuo y Autodesplazable -->
{breakingList.length > 0 && (
<div class="breaking-marquee-strip">
<div class="breaking-fixed-tag">
<span class="breaking-pulse-dot"></span>
<span>EN DIRECTO</span>
</div>
<div class="breaking-track-container">
<div class="breaking-animated-track" id="breaking-track">
<div class="ticker-news-group">
{breakingList.map((item) => (
  <a href={item.url} class="breaking-link-item">
    <span class="breaking-category-pill">{item.category}</span>
    <span class="breaking-text-title">{item.title}</span>
    <span class="breaking-dot-sep">•</span>
  </a>
))}
</div>
<div class="ticker-news-group" aria-hidden="true">
{breakingList.map((item) => (
  <a href={item.url} class="breaking-link-item">
    <span class="breaking-category-pill">{item.category}</span>
    <span class="breaking-text-title">{item.title}</span>
    <span class="breaking-dot-sep">•</span>
  </a>
))}
</div>
</div>
</div>
</div>
)}

<!-- (Pilares eliminados para despejar la vista) -->

<!-- Portada Principal Broadsheet -->
{leadStory && (
<div class="broadsheet-layout">
<section class="lead-box">
<span class="lead-cat">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
{leadStory.data.heroImage && (
<div class="lead-media">
<img src={leadStory.data.heroImage} alt={leadStory.data.title} />
</div>
)}
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-meta">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>

<aside class="radar-box">
<h3 class="radar-heading">RADAR DE COBERTURA</h3>
{sideStories.map((post) => (
<article class="radar-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="radar-img" />
)}
<div class="radar-cat">{post.data.category || 'Global'}</div>
<h4 class="radar-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="radar-desc">{post.data.description}</p>
</article>
))}
</aside>
</div>
)}

<!-- Cuadrículas por Sección Compactas -->
{postsGeopolitica.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #dc2626; padding-left: 0.8rem;">Política & Orden Global</h3>
<a href="/categoria/geopolitica" class="section-link">Ver sección completa ({postsGeopolitica.length}) →</a>
</div>
<div class="articles-grid">
{postsGeopolitica.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Política
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsEconomia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #059669; padding-left: 0.8rem;">Economía & Mercados</h3>
<a href="/categoria/economia" class="section-link">Ver sección completa ({postsEconomia.length}) →</a>
</div>
<div class="articles-grid">
{postsEconomia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Mercados
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsTecnologia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #2563eb; padding-left: 0.8rem;">Tecnología & IA</h3>
<a href="/categoria/tecnologia" class="section-link">Ver sección completa ({postsTecnologia.length}) →</a>
</div>
<div class="articles-grid">
{postsTecnologia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Tecnología
</div>
</div>
</article>
))}
</div>
</section>
)}
</main>

<Footer />

<script is:inline>
// Auto-rotación y refresco sutil cada 4 minutos para mantener siempre el feed en vivo
setInterval(() => {
  console.log('[TEP Stream] Sincronizando despachos en vivo...');
}, 240000);
</script>
</body>
</html>