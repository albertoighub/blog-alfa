    }
    .donor-action {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }
    .donor-paypal-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #0070ba;
      color: #ffffff;
      text-decoration: none;
      padding: 0.75rem 1.6rem;
      border-radius: 30px;
      font-weight: 850;
      font-size: 0.95rem;
      transition: all 0.2s ease;
      box-shadow: 0 4px 15px rgba(0, 112, 186, 0.4);
    }
    .donor-paypal-btn:hover {
      background: #005ea6;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 112, 186, 0.6);
    }
