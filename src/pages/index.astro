      padding-top: 0.5rem;
    }

    /* 5. SECCIÓN INSTITUCIONAL DE APOYO Y DONACIONES DIRECTO PAYPAL */
    .donor-support-strip {
      background: linear-gradient(135deg, #050505 0%, #1e1b4b 100%);
