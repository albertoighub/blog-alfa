---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 4);

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica']));
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas']));
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia']));

const breakingList = sortedPosts.slice(0, 6).map((p) => ({
title: p.data.title,
category: p.data.category || 'Actualidad',
url: `/blog/${p.slug ?? p.id}/`,
}));
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Investigación & Mercados Globales" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #f8fafc;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main {
max-width: 1240px;
margin: 0 auto;
padding: 1.5rem 1rem 6rem;
}

/* 1. BANNER DINÁMICO DE ÚLTIMA HORA (Centrado Perfecto) */
.breaking-marquee-strip {
background: #991b1b;
color: #ffffff;
display: flex;
align-items: center;
height: 44px; /* Altura fija */
border-radius: 6px;
margin-bottom: 2rem;
overflow: hidden;
box-shadow: 0 4px 15px rgba(153, 27, 27, 0.2);
}
.breaking-fixed-tag {
background: #7f1d1d;
height: 100%;
padding: 0 1.2rem;
display: flex;
align-items: center; /* Centrado vertical */
gap: 8px;
font-size: 0.74rem;
font-weight: 900;
letter-spacing: 0.1em;
text-transform: uppercase;
flex-shrink: 0;
z-index: 3;
border-right: 1px solid rgba(255, 255, 255, 0.15);
}
.breaking-pulse-dot {
width: 8px;
height: 8px;
border-radius: 50%;
background: #f87171;
box-shadow: 0 0 8px #f87171;
animation: pulseDot 1.4s infinite ease-in-out;
}
@keyframes pulseDot {
0%, 100% { transform: scale(0.9); opacity: 0.8; }
50% { transform: scale(1.2); opacity: 1; }
}
.breaking-track-container {
flex: 1;
height: 100%;
overflow: hidden;
white-space: nowrap;
position: relative;
display: flex;
align-items: center; /* Asegura el centrado interno */
}
.breaking-animated-track {
display: inline-flex;
align-items: center; /* Alineación vertical del contenido animado */
height: 100%;
padding-left: 2rem;
animation: marqueeNews 32s linear infinite;
}
.breaking-marquee-strip:hover .breaking-animated-track {
animation-play-state: paused;
}
.breaking-link-item {
color: #ffffff;
text-decoration: none;
font-size: 0.88rem;
font-weight: 700;
display: inline-flex;
align-items: center; /* Icono y texto alineados */
gap: 0.8rem;
}
.breaking-category-pill {
background: #ffffff;
color: #991b1b;
font-size: 0.68rem;
font-weight: 900;
padding: 0.2rem 0.5rem;
border-radius: 3px;
text-transform: uppercase;
letter-spacing: 0.05em;
line-height: 1;
}
@keyframes marqueeNews {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

/* 2. LOS 3 EJES ESTRATÉGICOS (Horizontales, estrechos y limpios) */
.three-pillars-strip {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 1.2rem;
margin-bottom: 3rem;
}
.pillar-card {
background: #090d16;
border-radius: 6px;
padding: 1.2rem 1.4rem;
display: flex;
align-items: center;
gap: 1.2rem;
text-decoration: none;
color: #ffffff;
border: 1px solid #1e293b;
transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
height: 90px; /* Estrechos en altura */
box-sizing: border-box;
}
.pillar-card:hover {
transform: translateY(-3px);
box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
}
.pillar-geo { border-left: 4px solid #ef4444; }
.pillar-geo:hover { border-color: #ef4444; }
.pillar-fin { border-left: 4px solid #10b981; }
.pillar-fin:hover { border-color: #10b981; }
.pillar-tech { border-left: 4px solid #3b82f6; }
.pillar-tech:hover { border-color: #3b82f6; }

.pillar-icon {
width: 48px;
height: 48px;
border-radius: 8px;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}
.icon-geo { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
.icon-fin { 
background: rgba(16, 185, 129, 0.18); 
color: #10b981;
font-size: 1.6rem;
font-weight: 900;
font-family: system-ui, sans-serif;
}
.icon-tech { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }

.pillar-text {
display: flex;
flex-direction: column;
justify-content: center;
}
.pillar-text h4 {
margin: 0 0 0.15rem;
font-size: 1rem;
font-weight: 800;
letter-spacing: -0.01em;
color: #ffffff;
}
.pillar-text p {
margin: 0;
font-size: 0.82rem;
color: #94a3b8;
line-height: 1.3;
display: -webkit-box;
-webkit-line-clamp: 2;
-webkit-box-orient: vertical;
overflow: hidden;
}

/* Broadsheet Lead & Radar Lateral */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.2fr 1fr;
gap: 2.5rem;
padding-bottom: 3.5rem;
border-bottom: 2px solid #0f172a;
margin-bottom: 3.5rem;
}
.lead-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2rem;
box-shadow: 0 8px 20px rgba(0,0,0,0.03);
}
.lead-cat {
font-size: 0.76rem;
font-weight: 900;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.6rem;
display: block;
}
.lead-title {
font-size: clamp(2rem, 3.2vw, 2.7rem);
line-height: 1.18;
font-weight: 900;
margin: 0 0 1.2rem;
letter-spacing: -0.03em;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: #1e3a8a;
}
.lead-media {
margin-bottom: 1.4rem;
border-radius: 6px;
overflow: hidden;
max-height: 420px;
}
.lead-media img {
width: 100%;
height: 100%;
max-height: 420px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-box:hover .lead-media img {
transform: scale(1.03);
}
.lead-summary {
font-size: 1.18rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1.2rem;
}
.lead-meta {
font-size: 0.8rem;
color: #64748b;
font-weight: 600;
border-top: 1px solid #f1f5f9;
padding-top: 1rem;
}

.radar-box {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.radar-heading {
font-size: 0.85rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.08em;
border-bottom: 2px solid #0f172a;
padding-bottom: 0.5rem;
margin: 0;
color: #0f172a;
}
.radar-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 6px;
overflow: hidden;
padding: 1rem;
transition: transform 0.2s ease;
}
.radar-card:hover {
transform: translateY(-3px);
}
.radar-img {
width: 100%;
height: 130px;
object-fit: cover;
border-radius: 4px;
margin-bottom: 0.6rem;
}
.radar-cat {
font-size: 0.68rem;
font-weight: 800;
color: #b91c1c;
text-transform: uppercase;
margin-bottom: 0.3rem;
}
.radar-title {
font-size: 1.05rem;
line-height: 1.35;
font-weight: 800;
margin: 0 0 0.4rem;
}
.radar-title a {
color: #0f172a;
text-decoration: none;
}
.radar-title a:hover {
color: #1e3a8a;
}
.radar-desc {
font-size: 0.84rem;
color: #64748b;
line-height: 1.45;
margin: 0 0 0.4rem;
}

/* Catálogo Completo por Secciones */
.category-section-wrap {
margin-bottom: 4rem;
}
.section-bar {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #0f172a;
padding-bottom: 0.6rem;
margin-bottom: 2rem;
}
.section-name {
font-size: 1.6rem;
font-weight: 900;
letter-spacing: -0.02em;
color: #0f172a;
margin: 0;
}
.section-link {
font-size: 0.8rem;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 0.06em;
color: #1e3a8a;
text-decoration: none;
}
.section-link:hover {
text-decoration: underline;
}
.articles-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
gap: 2rem;
}
.article-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.article-card:hover {
transform: translateY(-5px);
box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.08);
}
.article-img-wrap {
width: 100%;
height: 190px;
overflow: hidden;
}
.article-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.article-card:hover .article-img {
transform: scale(1.04);
}
.article-body {
padding: 1.4rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.article-title {
font-size: 1.2rem;
line-height: 1.35;
font-weight: 800;
letter-spacing: -0.02em;
margin: 0 0 0.6rem;
color: #0f172a;
}
.article-title a {
color: inherit;
text-decoration: none;
}
.article-title a:hover {
color: #1e3a8a;
}
.article-desc {
font-size: 0.9rem;
color: #475569;
line-height: 1.55;
margin-bottom: 1.2rem;
}
.article-date {
font-size: 0.76rem;
color: #94a3b8;
font-weight: 600;
border-top: 1px solid #f8fafc;
padding-top: 0.6rem;
}

@media (max-width: 900px) {
.three-pillars-strip {
grid-template-columns: 1fr;
}
.broadsheet-layout {
grid-template-columns: 1fr;
gap: 2rem;
}
}
</style>
</head>
<body>
<Header />

<main>
<!-- 1. BANNER DINÁMICO DE ÚLTIMA HORA (Centrado verticalmente) -->
{breakingList.length > 0 && (
<div class="breaking-marquee-strip">
<div class="breaking-fixed-tag">
<span class="breaking-pulse-dot"></span>
<span>ÚLTIMA HORA</span>
</div>
<div class="breaking-track-container">
<div class="breaking-animated-track" id="breaking-track">
<a href={breakingList[0].url} class="breaking-link-item" id="breaking-link-1">
<span class="breaking-category-pill" id="breaking-cat-1">{breakingList[0].category}</span>
<span id="breaking-title-1">{breakingList[0].title}</span>
</a>
<span style="color: rgba(255,255,255,0.4); margin: 0 2rem;">•</span>
<a href={breakingList[0].url} class="breaking-link-item" id="breaking-link-2">
<span class="breaking-category-pill" id="breaking-cat-2">{breakingList[0].category}</span>
<span id="breaking-title-2">{breakingList[0].title}</span>
</a>
</div>
</div>
</div>
)}

<!-- 2. LOS TRES PILARES ESTRATÉGICOS HORIONALES Y ESTRECHOS -->
<section class="three-pillars-strip">
<a href="/categoria/geopolitica" class="pillar-card pillar-geo">
<div class="pillar-icon icon-geo">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<line x1="2" y1="12" x2="22" y2="12"/>
<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>
</div>
<div class="pillar-text">
<h4>Radar Geopolítico</h4>
<p>Seguridad estratégica y diplomacia</p>
</div>
</a>

<a href="/categoria/economia" class="pillar-card pillar-fin">
<div class="pillar-icon icon-fin">
$
</div>
<div class="pillar-text">
<h4>Mesa Macroeconómica</h4>
<p>Bancos centrales, liquidez y divisas</p>
</div>
</a>

<a href="/categoria/tecnologia" class="pillar-card pillar-tech">
<div class="pillar-icon icon-tech">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
<line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
</svg>
</div>
<div class="pillar-text">
<h4>Frontera Tecnológica</h4>
<p>Semiconductores y soberanía IA</p>
</div>
</a>
</section>

<!-- 3. PRIMERA PLANA BROADSHEET -->
{leadStory && (
<div class="broadsheet-layout">
<section class="lead-box">
<span class="lead-cat">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
{leadStory.data.heroImage && (
<div class="lead-media">
<img src={leadStory.data.heroImage} alt={leadStory.data.title} />
</div>
)}
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-meta">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>

<aside class="radar-box">
<h3 class="radar-heading">RADAR DE COBERTURA</h3>
{sideStories.map((post) => (
<article class="radar-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="radar-img" />
)}
<div class="radar-cat">{post.data.category || 'Global'}</div>
<h4 class="radar-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="radar-desc">{post.data.description}</p>
</article>
))}
</aside>
</div>
)}

<!-- 4. CATÁLOGO COMPLETO POR SECCIONES -->
{postsGeopolitica.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Geopolítica & Orden Global</h3>
<a href="/categoria/geopolitica" class="section-link">Ver archivo ({postsGeopolitica.length}) →</a>
</div>
<div class="articles-grid">
{postsGeopolitica.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Geopolítica
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsEconomia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Economía, Mercados & Finanzas</h3>
<a href="/categoria/economia" class="section-link">Ver archivo ({postsEconomia.length}) →</a>
</div>
<div class="articles-grid">
{postsEconomia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Mercados
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsTecnologia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name">Tecnología & Inteligencia Artificial</h3>
<a href="/categoria/tecnologia" class="section-link">Ver archivo ({postsTecnologia.length}) →</a>
</div>
<div class="articles-grid">
{postsTecnologia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Tecnología
</div>
</div>
</article>
))}
</div>
</section>
)}
</main>

<Footer />

<!-- Script de rotación de noticias cada 5 minutos (300,000 ms) -->
<script is:inline define:vars={{ breakingList }}>
let currentIndex = 0;
const FIVE_MINUTES = 5 * 60 * 1000;

function rotateBreakingNews() {
if (!breakingList || breakingList.length === 0) return;
currentIndex = (currentIndex + 1) % breakingList.length;
const currentNews = breakingList[currentIndex];

const link1 = document.getElementById('breaking-link-1');
const link2 = document.getElementById('breaking-link-2');
const cat1 = document.getElementById('breaking-cat-1');
const cat2 = document.getElementById('breaking-cat-2');
const title1 = document.getElementById('breaking-title-1');
const title2 = document.getElementById('breaking-title-2');

if (link1 && link2) {
link1.href = currentNews.url;
link2.href = currentNews.url;
}
if (cat1 && cat2) {
cat1.textContent = currentNews.category;
cat2.textContent = currentNews.category;
}
if (title1 && title2) {
title1.textContent = currentNews.title;
title2.textContent = currentNews.title;
}
}

if (breakingList && breakingList.length > 1) {
setInterval(rotateBreakingNews, FIVE_MINUTES);
}
</script>
</body>
</html>