<!-- SCRIPT DE ROTACIÓN Y CONTROL DEL CARRUSEL -->
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  // 1. CONTROL DE ROTACIÓN CONTINUA DEL CARRUSEL
  const track = document.getElementById("carousel-marquee-track");
  const toggleBtn = document.getElementById("carousel-marquee-toggle");
  const viewport = document.getElementById("carousel-marquee-viewport");

  if (track && toggleBtn) {
    let isPausedByUser = false;

    toggleBtn.addEventListener("click", () => {
      isPausedByUser = !isPausedByUser;
      if (isPausedByUser) {
        track.classList.add("is-paused");
        toggleBtn.textContent = "▶ Reanudar";
      } else {
        track.classList.remove("is-paused");
        toggleBtn.textContent = "⏸ Pausar";
      }
    });

    if (viewport) {
      viewport.addEventListener("touchstart", () => {
        if (!isPausedByUser) track.classList.add("is-paused");
      }, { passive: true });

      viewport.addEventListener("touchend", () => {
        if (!isPausedByUser) track.classList.remove("is-paused");
      });
    }
  }

  // 2. OBSERVADOR DE ENTRADA FLUIDA Y MICRO-ANIMACIONES
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("fade-in-up");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    const animatedItems = document.querySelectorAll(".article-card, .broadcast-item-card, .radar-card, .category-section-wrap");
    animatedItems.forEach((el) => {
      observer.observe(el);
    });
  }
});
</script>
