---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 4);

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica']));
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas']));
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia']));

const breakingList = sortedPosts.slice(0, 6).map((p) => ({
title: p.data.title,
category: p.data.category || 'Actualidad',
url: `/blog/${p.slug ?? p.id}/`,
}));
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Investigación & Mercados Globales" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #f8fafc;
color: #050505;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main {
max-width: 1580px;
width: 94%;
margin: 0 auto;
padding: 1.5rem 0 6rem;
}

/* 1. ÚLTIMA HORA */
.breaking-marquee-strip {
background: #b91c1c;
color: #ffffff;
display: flex;
align-items: center;
height: 44px;
border-radius: 6px;
margin-bottom: 2rem;
overflow: hidden;
box-shadow: 0 4px 15px rgba(185, 28, 28, 0.2);
width: 100%;
}
.breaking-fixed-tag {
background: #050505;
height: 100%;
padding: 0 1.4rem;
display: flex;
align-items: center;
gap: 8px;
font-size: 0.74rem;
font-weight: 900;
letter-spacing: 0.1em;
text-transform: uppercase;
flex-shrink: 0;
z-index: 3;
border-right: 2px solid #dc2626;
}
.breaking-pulse-dot {
width: 8px;
height: 8px;
border-radius: 50%;
background: #dc2626;
box-shadow: 0 0 8px #dc2626;
animation: pulseDot 1.4s infinite ease-in-out;
}
@keyframes pulseDot {
0%, 100% { transform: scale(0.9); opacity: 0.8; }
50% { transform: scale(1.25); opacity: 1; }
}
.breaking-track-container {
flex: 1;
height: 100%;
overflow: hidden;
white-space: nowrap;
position: relative;
display: flex;
align-items: center;
}
.breaking-animated-track {
display: inline-flex;
align-items: center;
height: 100%;
padding-left: 2rem;
animation: marqueeNews 32s linear infinite;
}
.breaking-marquee-strip:hover .breaking-animated-track {
animation-play-state: paused;
}
.breaking-link-item {
color: #ffffff;
text-decoration: none;
font-size: 0.88rem;
font-weight: 700;
display: inline-flex;
align-items: center;
gap: 0.8rem;
}
.breaking-category-pill {
background: #ffffff;
color: #050505;
font-size: 0.68rem;
font-weight: 900;
padding: 0.2rem 0.55rem;
border-radius: 3px;
text-transform: uppercase;
letter-spacing: 0.05em;
line-height: 1;
}
@keyframes marqueeNews {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

/* 2. LOS TRES PILARES */
.three-pillars-strip {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 1.5rem;
margin-bottom: 3rem;
width: 100%;
}
.pillar-card {
background: #050505;
border-radius: 8px;
padding: 1.1rem 1.6rem;
display: flex;
align-items: center;
gap: 1.3rem;
text-decoration: none;
color: #ffffff;
border: 1px solid #1f2937;
transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
height: 86px;
box-sizing: border-box;
}
.pillar-card:hover {
transform: translateY(-3px);
box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
}
.pillar-geo { border-left: 4px solid #dc2626; }
.pillar-geo:hover { border-color: #dc2626; }
.pillar-fin { border-left: 4px solid #059669; }
.pillar-fin:hover { border-color: #059669; }
.pillar-tech { border-left: 4px solid #2563eb; }
.pillar-tech:hover { border-color: #2563eb; }

.pillar-icon {
width: 48px;
height: 48px;
border-radius: 8px;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
}
.icon-geo { background: rgba(220, 38, 38, 0.15); color: #dc2626; }
.icon-fin { 
background: rgba(5, 150, 105, 0.18); 
color: #059669;
font-size: 1.6rem;
font-weight: 900;
font-family: system-ui, sans-serif;
}
.icon-tech { background: rgba(37, 99, 235, 0.15); color: #2563eb; }

.pillar-text {
display: flex;
flex-direction: column;
justify-content: center;
}
.pillar-text h4 {
margin: 0 0 0.15rem;
font-size: 1.05rem;
font-weight: 900;
letter-spacing: -0.01em;
color: #ffffff;
}
.pillar-text p {
margin: 0;
font-size: 0.84rem;
color: #94a3b8;
line-height: 1.35;
}

/* 3. BROADSHEET */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.7fr 1.1fr;
gap: 3rem;
padding-bottom: 3.5rem;
border-bottom: 2px solid #050505;
margin-bottom: 3.5rem;
width: 100%;
}
.lead-box {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
padding: 2.5rem;
box-shadow: 0 8px 20px rgba(0,0,0,0.03);
}
.lead-cat {
font-size: 0.78rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
letter-spacing: 0.1em;
margin-bottom: 0.8rem;
display: block;
}
.lead-title {
font-size: clamp(2.3rem, 3.5vw, 3.2rem);
line-height: 1.15;
font-weight: 950;
margin: 0 0 1.4rem;
letter-spacing: -0.03em;
color: #050505;
}
.lead-title a { color: inherit; text-decoration: none; }
.lead-title a:hover { color: #dc2626; }
.lead-media {
margin-bottom: 1.6rem;
border-radius: 6px;
overflow: hidden;
max-height: 520px;
}
.lead-media img {
width: 100%;
height: 100%;
max-height: 520px;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.lead-box:hover .lead-media img { transform: scale(1.02); }
.lead-summary {
font-size: 1.25rem;
line-height: 1.65;
color: #334155;
margin: 0 0 1.4rem;
}
.lead-meta {
font-size: 0.84rem;
color: #64748b;
font-weight: 700;
border-top: 1px solid #f1f5f9;
padding-top: 1.2rem;
}

.radar-box {
display: flex;
flex-direction: column;
gap: 1.8rem;
}
.radar-heading {
font-size: 0.88rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.1em;
border-bottom: 2px solid #050505;
padding-bottom: 0.6rem;
margin: 0;
color: #050505;
}
.radar-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
padding: 1.2rem;
transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.radar-card:hover {
transform: translateY(-3px);
box-shadow: 0 10px 20px -5px rgba(0,0,0,0.06);
}
.radar-img {
width: 100%;
height: 160px;
object-fit: cover;
border-radius: 6px;
margin-bottom: 0.8rem;
}
.radar-cat {
font-size: 0.72rem;
font-weight: 900;
color: #dc2626;
text-transform: uppercase;
margin-bottom: 0.4rem;
}
.radar-title {
font-size: 1.15rem;
line-height: 1.35;
font-weight: 800;
margin: 0 0 0.5rem;
}
.radar-title a { color: #050505; text-decoration: none; }
.radar-title a:hover { color: #dc2626; }
.radar-desc {
font-size: 0.88rem;
color: #64748b;
line-height: 1.5;
margin: 0 0 0.4rem;
}

/* 4. SECCIONES PANORÁMICAS */
.category-section-wrap {
margin-bottom: 4.5rem;
width: 100%;
}
.section-bar {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #050505;
padding-bottom: 0.8rem;
margin-bottom: 2.2rem;
}
.section-name {
font-size: 1.8rem;
font-weight: 950;
letter-spacing: -0.02em;
color: #050505;
margin: 0;
}
.section-link {
font-size: 0.84rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.06em;
color: #050505;
text-decoration: none;
}
.section-link:hover {
color: #dc2626;
text-decoration: underline;
}
.articles-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
gap: 2.5rem;
width: 100%;
}
.article-card {
background: #ffffff;
border: 1px solid #e2e8f0;
border-radius: 8px;
overflow: hidden;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.article-card:hover {
transform: translateY(-5px);
box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.08);
}
.article-img-wrap {
width: 100%;
height: 220px;
overflow: hidden;
}
.article-img {
width: 100%;
height: 100%;
object-fit: cover;
display: block;
transition: transform 0.4s ease;
}
.article-card:hover .article-img { transform: scale(1.04); }
.article-body {
padding: 1.6rem;
display: flex;
flex-direction: column;
flex: 1;
justify-content: space-between;
}
.article-title {
font-size: 1.28rem;
line-height: 1.35;
font-weight: 850;
letter-spacing: -0.02em;
margin: 0 0 0.8rem;
color: #050505;
}
.article-title a { color: inherit; text-decoration: none; }
.article-title a:hover { color: #dc2626; }
.article-desc {
font-size: 0.94rem;
color: #475569;
line-height: 1.6;
margin-bottom: 1.4rem;
}
.article-date {
font-size: 0.78rem;
color: #94a3b8;
font-weight: 700;
border-top: 1px solid #f8fafc;
padding-top: 0.8rem;
}

@media (max-width: 1024px) {
.three-pillars-strip { grid-template-columns: 1fr; }
.broadsheet-layout { grid-template-columns: 1fr; gap: 2rem; }
}
</style>
</head>
<body>
<Header />

<main>
<!-- Ticker Última Hora Centrado -->
{breakingList.length > 0 && (
<div class="breaking-marquee-strip">
<div class="breaking-fixed-tag">
<span class="breaking-pulse-dot"></span>
<span>ÚLTIMA HORA</span>
</div>
<div class="breaking-track-container">
<div class="breaking-animated-track" id="breaking-track">
<a href={breakingList[0].url} class="breaking-link-item" id="breaking-link-1">
<span class="breaking-category-pill" id="breaking-cat-1">{breakingList[0].category}</span>
<span id="breaking-title-1">{breakingList[0].title}</span>
</a>
<span style="color: rgba(255,255,255,0.4); margin: 0 2.5rem;">•</span>
<a href={breakingList[0].url} class="breaking-link-item" id="breaking-link-2">
<span class="breaking-category-pill" id="breaking-cat-2">{breakingList[0].category}</span>
<span id="breaking-title-2">{breakingList[0].title}</span>
</a>
</div>
</div>
</div>
)}

<!-- Los 3 Pilares Temáticos Estrechos y Sin Descripciones Secundarias -->
<section class="three-pillars-strip">
<a href="/categoria/geopolitica" class="pillar-card pillar-geo">
<div class="pillar-icon icon-geo">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="10"/>
<line x1="2" y1="12" x2="22" y2="12"/>
<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
</svg>
</div>
<div class="pillar-text">
<h4>Política & Orden Global</h4>
<p>Seguridad estratégica y diplomacia</p>
</div>
</a>

<a href="/categoria/economia" class="pillar-card pillar-fin">
<div class="pillar-icon icon-fin">
$
</div>
<div class="pillar-text">
<h4>Economía & Mercados</h4>
<p>Bancos centrales y divisas</p>
</div>
</a>

<a href="/categoria/tecnologia" class="pillar-card pillar-tech">
<div class="pillar-icon icon-tech">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="4" y="4" width="16" height="16" rx="2"/>
<rect x="9" y="9" width="6" height="6"/>
<line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
<line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
</svg>
</div>
<div class="pillar-text">
<h4>Tecnología & IA</h4>
<p>Semiconductores y soberanía digital</p>
</div>
</a>
</section>

<!-- Portada Principal Broadsheet -->
{leadStory && (
<div class="broadsheet-layout">
<section class="lead-box">
<span class="lead-cat">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
{leadStory.data.heroImage && (
<div class="lead-media">
<img src={leadStory.data.heroImage} alt={leadStory.data.title} />
</div>
)}
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-meta">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>

<aside class="radar-box">
<h3 class="radar-heading">RADAR DE COBERTURA</h3>
{sideStories.map((post) => (
<article class="radar-card">
{post.data.heroImage && (
<img src={post.data.heroImage} alt={post.data.title} class="radar-img" />
)}
<div class="radar-cat">{post.data.category || 'Global'}</div>
<h4 class="radar-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="radar-desc">{post.data.description}</p>
</article>
))}
</aside>
</div>
)}

<!-- Cuadrículas por Sección -->
{postsGeopolitica.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #dc2626; padding-left: 0.8rem;">Política & Orden Global</h3>
<a href="/categoria/geopolitica" class="section-link">Ver sección completa ({postsGeopolitica.length}) →</a>
</div>
<div class="articles-grid">
{postsGeopolitica.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Política
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsEconomia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #059669; padding-left: 0.8rem;">Economía & Mercados</h3>
<a href="/categoria/economia" class="section-link">Ver sección completa ({postsEconomia.length}) →</a>
</div>
<div class="articles-grid">
{postsEconomia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Mercados
</div>
</div>
</article>
))}
</div>
</section>
)}

{postsTecnologia.length > 0 && (
<section class="category-section-wrap">
<div class="section-bar">
<h3 class="section-name" style="border-left: 4px solid #2563eb; padding-left: 0.8rem;">Tecnología & IA</h3>
<a href="/categoria/tecnologia" class="section-link">Ver sección completa ({postsTecnologia.length}) →</a>
</div>
<div class="articles-grid">
{postsTecnologia.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<div class="article-img-wrap">
<img src={post.data.heroImage} alt={post.data.title} class="article-img" loading="lazy" />
</div>
)}
<div class="article-body">
<div>
<h4 class="article-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="article-desc">{post.data.description}</p>
</div>
<div class="article-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP Tecnología
</div>
</div>
</article>
))}
</div>
</section>
)}
</main>

<Footer />

<script is:inline define:vars={{ breakingList }}>
let currentIndex = 0;
const FIVE_MINUTES = 5 * 60 * 1000;

function rotateBreakingNews() {
if (!breakingList || breakingList.length === 0) return;
currentIndex = (currentIndex + 1) % breakingList.length;
const currentNews = breakingList[currentIndex];

const link1 = document.getElementById('breaking-link-1');
const link2 = document.getElementById('breaking-link-2');
const cat1 = document.getElementById('breaking-cat-1');
const cat2 = document.getElementById('breaking-cat-2');
const title1 = document.getElementById('breaking-title-1');
const title2 = document.getElementById('breaking-title-2');

if (link1 && link2) {
link1.href = currentNews.url;
link2.href = currentNews.url;
}
if (cat1 && cat2) {
cat1.textContent = currentNews.category;
cat2.textContent = currentNews.category;
}
if (title1 && title2) {
title1.textContent = currentNews.title;
title2.textContent = currentNews.title;
}
}

if (breakingList && breakingList.length > 1) {
setInterval(rotateBreakingNews, FIVE_MINUTES);
}
</script>
</body>
</html>