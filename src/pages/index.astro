---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 4);

const matchesCat = (post, terms) => {
const c = (post.data.category || '').toLowerCase();
return terms.some((t) => c.includes(t));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica'])).slice(0, 3);
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas'])).slice(0, 3);
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia'])).slice(0, 3);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Cobertura Periodística Independiente" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #fdfdfd;
color: #121212;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
main {
max-width: 1200px;
margin: 0 auto;
padding: 1rem 1rem 4rem;
}
.breaking-banner {
background: #b91c1c;
color: #ffffff;
display: flex;
align-items: center;
padding: 0.6rem 1rem;
font-size: 0.88rem;
margin-bottom: 2rem;
border-radius: 2px;
gap: 1rem;
}
.breaking-tag {
background: #ffffff;
color: #b91c1c;
font-weight: 900;
padding: 0.2rem 0.5rem;
font-size: 0.72rem;
text-transform: uppercase;
letter-spacing: 0.08em;
white-space: nowrap;
}
.breaking-text {
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
flex: 1;
}
.breaking-text a {
color: #ffffff;
text-decoration: none;
font-weight: 600;
}
.broadsheet-layout {
display: grid;
grid-template-columns: 2.2fr 1fr;
gap: 2.5rem;
padding-bottom: 2.5rem;
border-bottom: 2px solid #121212;
margin-bottom: 2.5rem;
}
.lead-col {
border-right: 1px solid #e2e8f0;
padding-right: 2.5rem;
}
.lead-category {
font-size: 0.75rem;
font-weight: 900;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.5rem;
display: block;
}
.lead-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2rem, 3.2vw, 2.85rem);
line-height: 1.15;
font-weight: 700;
margin: 0 0 1rem;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: #1e3a8a;
}
.lead-summary {
font-family: "Georgia", serif;
font-size: 1.25rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1.2rem;
}
.lead-byline {
font-size: 0.82rem;
color: #64748b;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 0.05em;
}
.side-col {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.section-kicker {
font-size: 0.85rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.06em;
border-bottom: 2px solid #121212;
padding-bottom: 0.4rem;
margin: 0 0 0.5rem;
color: #0f172a;
}
.side-item {
border-bottom: 1px solid #e2e8f0;
padding-bottom: 1.2rem;
}
.side-item:last-child {
border-bottom: none;
padding-bottom: 0;
}
.side-category {
font-size: 0.68rem;
font-weight: 800;
color: #b91c1c;
text-transform: uppercase;
margin-bottom: 0.3rem;
}
.side-title {
font-family: "Georgia", serif;
font-size: 1.2rem;
line-height: 1.3;
font-weight: 700;
margin: 0 0 0.5rem;
}
.side-title a {
color: #121212;
text-decoration: none;
}
.side-title a:hover {
color: #1e3a8a;
}
.side-desc {
font-size: 0.88rem;
color: #64748b;
line-height: 1.45;
margin: 0 0 0.5rem;
}
.side-date {
font-size: 0.75rem;
color: #94a3b8;
}
.institutional-alert {
background: #f8fafc;
border-left: 4px solid #0284c7;
border-top: 1px solid #e2e8f0;
border-right: 1px solid #e2e8f0;
border-bottom: 1px solid #e2e8f0;
padding: 1.2rem 1.6rem;
margin-bottom: 3.5rem;
display: flex;
justify-content: space-between;
align-items: center;
flex-wrap: wrap;
gap: 1rem;
}
.alert-heading {
font-size: 1.05rem;
font-weight: 800;
margin: 0 0 0.2rem;
color: #0f172a;
}
.alert-sub {
margin: 0;
font-size: 0.88rem;
color: #475569;
}
.alert-btn {
background: #0284c7;
color: #ffffff !important;
font-weight: 700;
font-size: 0.82rem;
padding: 0.55rem 1.2rem;
text-decoration: none;
border-radius: 4px;
text-transform: uppercase;
}

/* Estilo para los bloques seccionados */
.category-block {
margin-bottom: 3.5rem;
}
.category-block-header {
display: flex;
justify-content: space-between;
align-items: baseline;
border-bottom: 2px solid #121212;
padding-bottom: 0.5rem;
margin-bottom: 1.5rem;
}
.block-title {
font-family: "Georgia", serif;
font-size: 1.5rem;
font-weight: 800;
color: #0f172a;
margin: 0;
}
.block-more-link {
font-size: 0.82rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
color: #1e3a8a;
text-decoration: none;
}
.block-more-link:hover {
text-decoration: underline;
}
.block-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
gap: 2rem 2.5rem;
}
.block-card {
border-top: 1px solid #e2e8f0;
padding-top: 1rem;
display: flex;
flex-direction: column;
justify-content: space-between;
}
.block-card-title {
font-family: "Georgia", serif;
font-size: 1.2rem;
line-height: 1.35;
font-weight: 700;
margin: 0 0 0.6rem;
}
.block-card-title a {
color: #111827;
text-decoration: none;
}
.block-card-title a:hover {
color: #1e3a8a;
}
.block-card-desc {
font-size: 0.9rem;
color: #475569;
line-height: 1.5;
margin: 0 0 0.8rem;
}
.block-card-date {
font-size: 0.78rem;
color: #94a3b8;
}

@media (max-width: 900px) {
.broadsheet-layout {
grid-template-columns: 1fr;
gap: 2rem;
}
.lead-col {
border-right: none;
padding-right: 0;
border-bottom: 1px solid #e2e8f0;
padding-bottom: 2rem;
}
}
</style>
</head>
<body>
<Header />
<main>
<!-- Breaking Ticker -->
{leadStory && (
<div class="breaking-banner">
<span class="breaking-tag">ÚLTIMA HORA</span>
<div class="breaking-text">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>
{leadStory.data.title}
</a>
</div>
</div>
)}

<!-- Disposición Broadsheet Lead + Radar -->
<div class="broadsheet-layout">
{leadStory && (
<section class="lead-col">
<span class="lead-category">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-byline">
Por Redacción News Internacional TEP • {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>
)}

<aside class="side-col">
<h3 class="section-kicker">RADAR ESTRATÉGICO</h3>
{sideStories.map((post) => (
<article class="side-item">
<div class="side-category">{post.data.category || 'Global'}</div>
<h4 class="side-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="side-desc">{post.data.description}</p>
<div class="side-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })}
</div>
</article>
))}
</aside>
</div>

<!-- Alerta Telegram -->
<div class="institutional-alert">
<div>
<h4 class="alert-heading">Sindicación de Informes en Tiempo Real</h4>
<p class="alert-sub">Monitoreo continuo de acontecimientos mundiales sin algoritmos mediadores.</p>
</div>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="alert-btn">
Acceso al Canal Telegram
</a>
</div>

<!-- BLOQUE 1: Geopolítica -->
{postsGeopolitica.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Geopolítica & Política Global</h3>
<a href="/categoria/geopolitica" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsGeopolitica.map((post) => (
<article class="block-card">
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}

<!-- BLOQUE 2: Economía & Mercados -->
{postsEconomia.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Economía, Mercados & Finanzas</h3>
<a href="/categoria/economia" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsEconomia.map((post) => (
<article class="block-card">
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}

<!-- BLOQUE 3: Tecnología & Inteligencia Artificial -->
{postsTecnologia.length > 0 && (
<section class="category-block">
<div class="category-block-header">
<h3 class="block-title">Tecnología & Inteligencia Artificial</h3>
<a href="/categoria/tecnologia" class="block-more-link">Ver sección completa →</a>
</div>
<div class="block-grid">
{postsTecnologia.map((post) => (
<article class="block-card">
<div>
<h4 class="block-card-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="block-card-desc">{post.data.description}</p>
</div>
<div class="block-card-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
)}
</main>
<Footer />
</body>
</html>