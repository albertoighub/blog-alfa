---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = sortedPosts[0];
const sideStories = sortedPosts.slice(1, 5); // 4 en radar
const carouselStories = sortedPosts.slice(5, 17); // 12 en slider interactivo

const matchesCat = (post: any, terms: string[]) => {
  const c = (post.data.category || '').toLowerCase();
  const t = (post.data.tags || []).join(' ').toLowerCase();
  const tit = (post.data.title || '').toLowerCase();
  return terms.some((term) => c.includes(term) || t.includes(term) || tit.includes(term));
};

const postsGeopolitica = sortedPosts.filter((p) => matchesCat(p, ['política', 'politica', 'geopolítica', 'geopolitica', 'defensa', 'seguridad', 'estado', 'soberanía']));
const postsEconomia = sortedPosts.filter((p) => matchesCat(p, ['economía', 'economia', 'mercados', 'finanzas', 'banc', 'fiscal', 'deuda', 'arancel']));
const postsTecnologia = sortedPosts.filter((p) => matchesCat(p, ['tecnología', 'tecnologia', 'ia', 'inteligencia', 'semiconductor', 'chip', 'software', 'hardware', 'ciber', 'kernel']));
const postsCiencia = sortedPosts.filter((p) => matchesCat(p, ['ciencia', 'medicina', 'salud', 'biotecnología', 'fármacos', 'cáncer', 'investigación', 'sanitario', 'genom', 'clínic']));
const postsTendencias = sortedPosts.filter((p) => matchesCat(p, ['tendencias', 'redes', 'viral', 'cultura digital', 'revuelo', 'plataformas', 'debates', 'audiencias', 'creadores', 'algoritmo', 'fragmentación']));

// 12 historias para el ticker dinámico continuo
const breakingList = sortedPosts.slice(0, 12).map((p) => ({
  title: p.data.title,
  category: p.data.category || 'Actualidad',
  url: `/blog/${p.slug ?? p.id}/`,
}));

// Función auxiliar para color de badge de categoría
const getCatColor = (cat: string) => {
  const c = (cat || '').toLowerCase();
  if (c.includes('econ') || c.includes('mercad')) return '#059669';
  if (c.includes('tecn') || c.includes('ia')) return '#2563eb';
  if (c.includes('cien') || c.includes('med') || c.includes('salud')) return '#06b6d4';
  if (c.includes('tend') || c.includes('red') || c.includes('viral')) return '#ec4899';
  return '#dc2626';
};
---

<!doctype html>
<html lang="es">
<head>
  <BaseHead title="News Internacional TEP | Investigación & Mercados Globales" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros, Geopolítica, Ciencia y Dinámica Digital." />
  <style>
    :global(body) { 
      margin: 0 !important; 
      padding: 0 !important; 
      width: 100vw !important; 
      max-width: 100% !important; 
      overflow-x: hidden !important;
      background-color: #f8fafc;
      color: #050505;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    
    /* Layout compacto para visualización óptima al 100% de zoom */
    main {
      max-width: 1440px;
      width: 93%;
      margin: 0 auto;
      padding: 0.85rem 0 4rem;
    }

    /* 1. TICKER ÚLTIMA HORA COMPACTO */
    .breaking-marquee-strip {
      background: #b91c1c;
      color: #ffffff;
      display: flex;
      align-items: center;
      height: 38px;
      border-radius: 6px;
      margin-bottom: 1.25rem;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(185, 28, 28, 0.2);
      width: 100%;
    }
    .breaking-fixed-tag {
      background: #050505;
      height: 100%;
      padding: 0 1.1rem;
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      flex-shrink: 0;
      z-index: 3;
      border-right: 2px solid #dc2626;
    }
    .breaking-pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #dc2626;
      box-shadow: 0 0 8px #dc2626;
      animation: pulseDot 1.4s infinite ease-in-out;
    }
    @keyframes pulseDot {
      0%, 100% { transform: scale(0.9); opacity: 0.8; }
      50% { transform: scale(1.25); opacity: 1; }
    }
    .breaking-track-container {
      flex: 1;
      height: 100%;
      overflow: hidden;
      white-space: nowrap;
      position: relative;
      display: flex;
      align-items: center;
    }
    .ticker-news-group {
      display: inline-flex;
      align-items: center;
      gap: 2rem;
      padding-right: 2rem;
      flex-shrink: 0;
    }
    .breaking-animated-track {
      display: flex;
      align-items: center;
      width: max-content;
      will-change: transform;
      animation: marqueeNews 50s linear infinite;
    }
    .breaking-marquee-strip:hover .breaking-animated-track {
      animation-play-state: paused;
    }
    .breaking-link-item {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.84rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      transition: opacity 0.15s ease;
    }
    .breaking-link-item:hover { opacity: 0.85; }
    .breaking-category-pill {
      background: #ffffff;
      color: #050505;
      font-size: 0.65rem;
      font-weight: 900;
      padding: 0.15rem 0.45rem;
      border-radius: 3px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 1;
      flex-shrink: 0;
    }
    .breaking-dot-sep {
      color: rgba(255, 255, 255, 0.45);
      margin-left: 1.2rem;
      font-size: 0.95rem;
    }
    @keyframes marqueeNews {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* 2. BROADSHEET COMPACTA Y SIN HUECOS */
    .broadsheet-layout {
      display: grid;
      grid-template-columns: 2.3fr 1.15fr;
      gap: 1.5rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid #050505;
      margin-bottom: 2rem;
      width: 100%;
    }

    .lead-column-stack {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .lead-box {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1.25rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    .lead-cat {
      font-size: 0.72rem;
      font-weight: 900;
      color: #dc2626;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.5rem;
      display: block;
    }
    .lead-title {
      font-size: clamp(1.4rem, 2.2vw, 2.05rem);
      line-height: 1.18;
      font-weight: 950;
      margin: 0 0 0.8rem;
      letter-spacing: -0.025em;
      color: #050505;
    }
    .lead-title a { color: inherit; text-decoration: none; }
    .lead-title a:hover { color: #dc2626; }
    .lead-media {
      margin-bottom: 0.9rem;
      border-radius: 6px;
      overflow: hidden;
      max-height: 310px;
      background: #f1f5f9;
    }
    .lead-media img {
      width: 100%;
      height: 100%;
      max-height: 310px;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .lead-box:hover .lead-media img { transform: scale(1.02); }
    .lead-summary {
      font-size: 0.96rem;
      line-height: 1.55;
      color: #334155;
      margin: 0 0 0.8rem;
    }
    .lead-meta {
