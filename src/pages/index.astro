---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const leadStory = posts[0];
const sideStories = posts.slice(1, 4);
const bottomStories = posts.slice(4, 10);
---

<!doctype html>
<html lang="es">
<head>
<BaseHead title="News Internacional TEP | Cobertura Periodística Independiente" description="Diario analítico global de alta precisión en Tecnología, Mercados Financieros y Geopolítica." />
<style>
:global(body) {
background-color: #fdfdfd;
color: #121212;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
main {
max-width: 1200px;
margin: 0 auto;
padding: 1rem 1rem 3rem;
}
/* 1. Breaking News Banner estilo CNN */
.breaking-banner {
background: #b91c1c;
color: #ffffff;
display: flex;
align-items: center;
padding: 0.6rem 1rem;
font-size: 0.88rem;
margin-bottom: 2rem;
border-radius: 2px;
gap: 1rem;
}
.breaking-tag {
background: #ffffff;
color: #b91c1c;
font-weight: 900;
padding: 0.2rem 0.5rem;
font-size: 0.72rem;
text-transform: uppercase;
letter-spacing: 0.08em;
white-space: nowrap;
}
.breaking-text {
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
flex: 1;
}
.breaking-text a {
color: #ffffff;
text-decoration: none;
font-weight: 600;
}
.breaking-text a:hover {
text-decoration: underline;
}

/* 2. Disposición Broadsheet (NYT Front Page) */
.broadsheet-layout {
display: grid;
grid-template-columns: 2.2fr 1fr;
gap: 2.5rem;
padding-bottom: 2.5rem;
border-bottom: 2px solid #121212;
margin-bottom: 2.5rem;
}

/* Historia Principal */
.lead-col {
border-right: 1px solid #e2e8f0;
padding-right: 2.5rem;
}
.lead-category {
font-size: 0.75rem;
font-weight: 900;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.08em;
margin-bottom: 0.5rem;
display: block;
}
.lead-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2rem, 3.2vw, 2.85rem);
line-height: 1.15;
font-weight: 700;
margin: 0 0 1rem;
color: #0f172a;
}
.lead-title a {
color: inherit;
text-decoration: none;
}
.lead-title a:hover {
color: #1e3a8a;
}
.lead-summary {
font-family: "Georgia", serif;
font-size: 1.25rem;
line-height: 1.6;
color: #334155;
margin: 0 0 1.2rem;
}
.lead-byline {
font-size: 0.82rem;
color: #64748b;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 0.05em;
}

/* Columna Lateral "Radar TEP" */
.side-col {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.section-kicker {
font-size: 0.85rem;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.06em;
border-bottom: 2px solid #121212;
padding-bottom: 0.4rem;
margin: 0 0 0.5rem;
color: #0f172a;
}
.side-item {
border-bottom: 1px solid #e2e8f0;
padding-bottom: 1.2rem;
}
.side-item:last-child {
border-bottom: none;
padding-bottom: 0;
}
.side-category {
font-size: 0.68rem;
font-weight: 800;
color: #b91c1c;
text-transform: uppercase;
letter-spacing: 0.05em;
margin-bottom: 0.3rem;
}
.side-title {
font-family: "Georgia", serif;
font-size: 1.2rem;
line-height: 1.3;
font-weight: 700;
margin: 0 0 0.5rem;
}
.side-title a {
color: #121212;
text-decoration: none;
}
.side-title a:hover {
color: #1e3a8a;
}
.side-desc {
font-size: 0.88rem;
color: #64748b;
line-height: 1.45;
margin: 0 0 0.5rem;
}
.side-date {
font-size: 0.75rem;
color: #94a3b8;
}

/* Banner Institucional de Telegram estilo Prensa */
.institutional-alert {
background: #f8fafc;
border-left: 4px solid #0284c7;
border-top: 1px solid #e2e8f0;
border-right: 1px solid #e2e8f0;
border-bottom: 1px solid #e2e8f0;
padding: 1.2rem 1.6rem;
margin-bottom: 3rem;
display: flex;
justify-content: space-between;
align-items: center;
flex-wrap: wrap;
gap: 1rem;
}
.alert-heading {
font-size: 1.05rem;
font-weight: 800;
margin: 0 0 0.2rem;
color: #0f172a;
}
.alert-sub {
margin: 0;
font-size: 0.88rem;
color: #475569;
}
.alert-btn {
background: #0284c7;
color: #ffffff !important;
font-weight: 700;
font-size: 0.82rem;
padding: 0.55rem 1.2rem;
text-decoration: none;
border-radius: 4px;
text-transform: uppercase;
letter-spacing: 0.05em;
}

/* 3. Cuadrícula Inferior Multicolumna */
.grid-heading {
font-family: "Georgia", serif;
font-size: 1.6rem;
font-weight: 800;
margin: 0 0 1.5rem;
padding-bottom: 0.5rem;
border-bottom: 1px solid #121212;
}
.bottom-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
gap: 2rem 2.5rem;
}
.bottom-card {
border-top: 1px solid #e2e8f0;
padding-top: 1rem;
display: flex;
flex-direction: column;
justify-content: space-between;
}
.bottom-cat {
font-size: 0.7rem;
font-weight: 800;
color: #1e3a8a;
text-transform: uppercase;
letter-spacing: 0.05em;
margin-bottom: 0.4rem;
}
.bottom-title {
font-family: "Georgia", serif;
font-size: 1.2rem;
line-height: 1.35;
font-weight: 700;
margin: 0 0 0.6rem;
}
.bottom-title a {
color: #111827;
text-decoration: none;
}
.bottom-title a:hover {
color: #1e3a8a;
}
.bottom-desc {
font-size: 0.9rem;
color: #475569;
line-height: 1.5;
margin: 0 0 0.8rem;
}
.bottom-date {
font-size: 0.78rem;
color: #94a3b8;
}

@media (max-width: 900px) {
.broadsheet-layout {
grid-template-columns: 1fr;
gap: 2rem;
}
.lead-col {
border-right: none;
padding-right: 0;
border-bottom: 1px solid #e2e8f0;
padding-bottom: 2rem;
}
}
</style>
</head>
<body>
<Header />
<main>
<!-- Franja Última Hora estilo CNN -->
{leadStory && (
<div class="breaking-banner">
<span class="breaking-tag">ÚLTIMA HORA</span>
<div class="breaking-text">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>
{leadStory.data.title}
</a>
</div>
</div>
)}

<!-- Estructura Front Page NYT -->
<div class="broadsheet-layout">
<!-- Lead Story Column -->
{leadStory && (
<section class="lead-col">
<span class="lead-category">{leadStory.data.category || 'Análisis Especial'}</span>
<h2 class="lead-title">
<a href={`/blog/${leadStory.slug ?? leadStory.id}/`}>{leadStory.data.title}</a>
</h2>
<p class="lead-summary">{leadStory.data.description}</p>
<div class="lead-byline">
Por Redacción News Internacional TEP • Publicado el {leadStory.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
</div>
</section>
)}

<!-- Radar Lateral -->
<aside class="side-col">
<h3 class="section-kicker">RADAR ESTRATÉGICO</h3>
{sideStories.map((post) => (
<article class="side-item">
<div class="side-category">{post.data.category || 'Global'}</div>
<h4 class="side-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="side-desc">{post.data.description}</p>
<div class="side-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })}
</div>
</article>
))}
</aside>
</div>

<!-- Banner Telegram Estilo Diario -->
<div class="institutional-alert">
<div>
<h4 class="alert-heading">Sindicación Inmediata de Informes de Inteligencia</h4>
<p class="alert-sub">Monitoreo 24/7 sobre movimientos económicos, desarrollos de IA y política exterior sin intermediarios.</p>
</div>
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="alert-btn">
Acceso al Canal Telegram
</a>
</div>

<!-- Secciones Temáticas Inferiores -->
<section>
<h3 class="grid-heading">Cobertura Global e Investigaciones</h3>
<div class="bottom-grid">
{bottomStories.map((post) => (
<article class="bottom-card">
<div>
<span class="bottom-cat">{post.data.category || 'Actualidad'}</span>
<h4 class="bottom-title">
<a href={`/blog/${post.slug ?? post.id}/`}>{post.data.title}</a>
</h4>
<p class="bottom-desc">{post.data.description}</p>
</div>
<div class="bottom-date">
{post.data.pubDate.toLocaleDateString('es-MX', { month: 'short', day: 'numeric', year: 'numeric' })} • TEP
</div>
</article>
))}
</div>
</section>
</main>
<Footer />
</body>
</html>
