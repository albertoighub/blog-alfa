    }
    .section-link {
      font-size: 0.74rem;
      font-weight: 850;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #050505;
      text-decoration: none;
      padding: 0.3rem 0.8rem;
      border-radius: 16px;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      transition: all 0.2s ease;
    }

    /* Reacciones de Color al Cursor por Sección */
    .section-geo .section-name { border-left: 4px solid #dc2626; padding-left: 0.7rem; }
    .section-geo .section-link:hover { background: #dc2626; border-color: #dc2626; color: #ffffff; transform: translateX(3px); }
    .section-geo .article-card:hover { border-color: #dc2626; box-shadow: 0 10px 22px rgba(220, 38, 38, 0.08); }
    .section-geo .article-card:hover .article-title a { color: #dc2626; }

