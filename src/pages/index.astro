---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => {
  const diff = new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf();
  if (diff !== 0) return diff;
  return (b.slug ?? b.id ?? '').localeCompare(a.slug ?? a.id ?? '');
});

// CONJUNTO GLOBAL DE SLUGS USADOS: GARANTÍA MATEMÁTICA DE CERO REPETICIÓN
const usedSlugs = new Set();

// 1. Noticia Líder (1 post único)
const leadStory = sortedPosts[0];
if (leadStory) {
  usedSlugs.add(leadStory.slug ?? leadStory.id);
}

// 2. Radar de Cobertura (4 posts únicos, ninguno repetido)
const sideStories = [];
for (const p of sortedPosts) {
  const s = p.slug ?? p.id;
  if (!usedSlugs.has(s)) {
    sideStories.push(p);
    usedSlugs.add(s);
    if (sideStories.length === 4) break;
  }
}

// 3. Carrusel Interactivo en Rotación (8 posts únicos, ninguno repetido)
const carouselStories = [];
for (const p of sortedPosts) {
  const s = p.slug ?? p.id;
  if (!usedSlugs.has(s)) {
    carouselStories.push(p);
    usedSlugs.add(s);
    if (carouselStories.length === 8) break;
  }
}

// 4. Selector estricto de artículos únicos por sección (Sin duplicaciones cruzadas)
const pickUniqueCategoryPosts = (matcher: (p: any) => boolean, count = 4) => {
  const list = [];
  for (const p of sortedPosts) {
    const s = p.slug ?? p.id;
    if (!usedSlugs.has(s) && matcher(p)) {
      list.push(p);
      usedSlugs.add(s);
      if (list.length === count) break;
    }
  }
  return list;
};

// Secciones temáticas con asignación estricta y única
const postsGeopolitica = pickUniqueCategoryPosts((p) => {
  const c = (p.data.category || '').toLowerCase();
  return c.includes('polít') || c.includes('polit') || c.includes('geopol');
}, 4);

const postsEconomia = pickUniqueCategoryPosts((p) => {
  const c = (p.data.category || '').toLowerCase();
  return c.includes('econ') || c.includes('mercad') || c.includes('finan');
}, 4);

const postsTecnologia = pickUniqueCategoryPosts((p) => {
  const c = (p.data.category || '').toLowerCase();
  return c.includes('tecn') || c.includes('ia') || c.includes('intel') || c.includes('ciber');
}, 4);

const postsCiencia = pickUniqueCategoryPosts((p) => {
  const c = (p.data.category || '').toLowerCase();
  const t = (p.data.tags || []).join(' ').toLowerCase();
  return c.includes('cien') || c.includes('med') || c.includes('salud') || c.includes('biotec') || t.includes('salud') || t.includes('medic');
}, 4);

const postsTendencias = pickUniqueCategoryPosts((p) => {
  const c = (p.data.category || '').toLowerCase();
  const t = (p.data.tags || []).join(' ').toLowerCase();
  return c.includes('tend') || c.includes('red') || c.includes('viral') || c.includes('plataform') || t.includes('digital') || t.includes('redes');
}, 4);

// 12 historias para el ticker dinámico continuo
const breakingList = sortedPosts.slice(0, 12).map((p) => ({
  title: p.data.title,
  category: p.data.category || 'Actualidad',
  url: `/blog/${p.slug ?? p.id}/`,
}));

// Colores de identificación cromática por sección
const getCatColor = (cat: string) => {
  const c = (cat || '').toLowerCase();
  if (c.includes('econ') || c.includes('mercad')) return '#059669';
  if (c.includes('tecn') || c.includes('ia')) return '#2563eb';
  if (c.includes('cien') || c.includes('med') || c.includes('salud')) return '#06b6d4';
  if (c.includes('tend') || c.includes('red') || c.includes('viral')) return '#ec4899';
  return '#dc2626';
};
