      padding: 0.75rem;
      text-align: center;
    }
    .ad-label-pill {
      display: block;
      font-size: 0.62rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #94a3b8;
      letter-spacing: 0.08em;
      margin-bottom: 0.4rem;
