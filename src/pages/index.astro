    .ad-placement-inner {
      min-height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 4. SECCIONES PANORÁMICAS COMPACTAS CON REACCIÓN DE COLOR AL CURSOR */
