<!-- Scripts de interactividad y actualización en vivo -->
<script is:inline>
// 1. Barra de progreso al scroll
window.addEventListener('scroll', () => {
const scrollTop = window.scrollY;
const docHeight = document.documentElement.scrollHeight - window.innerHeight;
const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
const bar = document.getElementById('scroll-progress');
if (bar) bar.style.width = pct + '%';
});

// 2. Reloj mundial dinámico
function updateClocks() {
const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
const now = new Date();

const fmt = (tz) => new Intl.DateTimeFormat('es-MX', { ...opts, timeZone: tz }).format(now);

const elNy = document.getElementById('time-ny');
const elLon = document.getElementById('time-lon');
const elFra = document.getElementById('time-fra');
const elTok = document.getElementById('time-tok');
const elSin = document.getElementById('time-sin');
const elDxb = document.getElementById('time-dxb');
const elMex = document.getElementById('time-mex');

if (elNy) elNy.textContent = fmt('America/New_York');
if (elLon) elLon.textContent = fmt('Europe/London');
if (elFra) elFra.textContent = fmt('Europe/Berlin');
if (elTok) elTok.textContent = fmt('Asia/Tokyo');
if (elSin) elSin.textContent = fmt('Asia/Singapore');
if (elDxb) elDxb.textContent = fmt('Asia/Dubai');
if (elMex) elMex.textContent = fmt('America/Mexico_City');
}
updateClocks();
setInterval(updateClocks, 1000);

// 3. Revelado suave de tarjetas al scroll (IntersectionObserver)
const observer = new IntersectionObserver((entries) => {
entries.forEach((e) => {
if (e.isIntersecting) e.target.classList.add('is-visible');
});
}, { threshold: 0.08 });

document.querySelectorAll('.reveal-item').forEach((el) => observer.observe(el));
</script>
</body>
</html>