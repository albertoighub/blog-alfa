<style>
footer {
background: #0f172a;
color: #94a3b8;
padding: 3.5rem 1.5rem 2rem;
margin-top: 4rem;
border-top: 1px solid #1e293b;
}
.footer-wrap {
max-width: 1100px;
margin: 0 auto;
}
.footer-grid {
display: grid;
grid-template-columns: 2fr 1fr 1fr;
gap: 3rem;
margin-bottom: 2.5rem;
}
.footer-title {
color: #ffffff;
font-size: 1.25rem;
font-weight: 800;
margin: 0 0 0.8rem;
}
.accent {
color: #38bdf8;
}
.footer-desc {
font-size: 0.9rem;
line-height: 1.6;
color: #cbd5e1;
margin: 0;
}
.col-heading {
color: #ffffff;
font-size: 0.95rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
margin: 0 0 1rem;
}
.col-links {
list-style: none;
padding: 0;
margin: 0;
}
.col-links li {
margin-bottom: 0.5rem;
}
.col-links a {
color: #94a3b8;
text-decoration: none;
font-size: 0.88rem;
transition: color 0.15s ease;
}
.col-links a:hover {
color: #38bdf8;
}
.footer-bottom {
border-top: 1px solid #1e293b;
padding-top: 1.8rem;
display: flex;
justify-content: space-between;
align-items: center;
font-size: 0.82rem;
flex-wrap: wrap;
gap: 0.8rem;
}
.footer-bottom p {
margin: 0;
}
.disclaimer {
color: #64748b;
}
@media (max-width: 768px) {
.footer-grid {
grid-template-columns: 1fr;
gap: 2rem;
}
.footer-bottom {
flex-direction: column;
align-items: flex-start;
}
}
</style>
