<style>
.tep-global-footer {
background: #090d16;
color: #94a3b8;
border-top: 3px solid #0f172a;
padding: 4rem 1rem 3rem;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.footer-wrap {
max-width: 1640px;
width: 95%;
margin: 0 auto;
display: grid;
grid-template-columns: 2fr 1fr 1fr;
gap: 3.5rem;
}
.footer-title {
font-size: 1.35rem;
font-weight: 900;
color: #ffffff;
letter-spacing: -0.02em;
margin: 0 0 0.8rem;
}
.footer-title span {
color: #38bdf8;
}
.footer-mission {
font-size: 0.88rem;
line-height: 1.6;
max-width: 480px;
margin: 0 0 1.2rem;
color: #94a3b8;
}
.footer-copy {
font-size: 0.78rem;
color: #64748b;
margin: 0;
}
.col-heading {
font-size: 0.74rem;
font-weight: 900;
color: #f8fafc;
letter-spacing: 0.1em;
text-transform: uppercase;
margin: 0 0 1rem;
border-bottom: 1px solid #1e293b;
padding-bottom: 0.4rem;
}
.footer-links-col ul {
list-style: none;
padding: 0;
margin: 0;
}
.footer-links-col li {
margin-bottom: 0.6rem;
}
.footer-links-col a {
color: #cbd5e1;
text-decoration: none;
font-size: 0.85rem;
font-weight: 500;
transition: color 0.15s ease;
}
.footer-links-col a:hover {
color: #38bdf8;
}

@media (max-width: 768px) {
.footer-wrap {
grid-template-columns: 1fr;
gap: 2rem;
}
}
</style>