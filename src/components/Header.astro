---
const today = new Date().toLocaleDateString('es-MX', {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric',
});

const marketData = [
{ asset: 'USD / EUR', val: '0.9241', change: '+0.18%', up: true },
{ asset: 'USD / MXN', val: '19.342', change: '-0.42%', up: false },
{ asset: 'USD / JPY', val: '149.25', change: '+0.31%', up: true },
{ asset: 'GBP / USD', val: '1.3060', change: '-0.15%', up: false },
{ asset: 'ORO (XAU/USD)', val: '$2,654.80', change: '+0.64%', up: true },
{ asset: 'BRENT CRUDO', val: '$77.40', change: '-1.15%', up: false },
{ asset: 'BITCOIN', val: '$64,280', change: '+2.10%', up: true },
{ asset: 'S&P 500', val: '5,815.20', change: '+0.45%', up: true },
{ asset: 'NASDAQ 100', val: '20,240.10', change: '+0.72%', up: true },
{ asset: 'BONO EE.UU. 10A', val: '4.08%', change: '-0.03%', up: false },
];
---

<header class="tep-global-header">
<!-- 1. Ticker 1: Horarios Mundiales (Azul Noche #050914) -->
<div class="ticker-time-wrapper">
<div class="ticker-label-time">HORA GLOBAL</div>
<div class="ticker-viewport">
<div class="ticker-track-loop time-track">
<div class="ticker-group">
<div class="time-item"><span class="time-city">Nueva York:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
<div class="ticker-group" aria-hidden="true">
<div class="time-item"><span class="time-city">Nueva York:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
</div>
</div>
</div>

<!-- 2. Ticker 2: Mercados Financieros (Azul Noche #0a1228) -->
<div class="ticker-market-wrapper">
<div class="ticker-label-market">MERCADOS & DIVISAS</div>
<div class="ticker-viewport">
<div class="ticker-track-loop market-track">
<div class="ticker-group">
{marketData.map((m) => (
<div class="market-item">
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
<div class="ticker-group" aria-hidden="true">
{marketData.map((m) => (
<div class="market-item">
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
</div>
</div>
</div>

<!-- 3. Utilidad Superior -->
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Internacional</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Alertas TEP</span>
</a>
</div>
</div>

<!-- 4. Masthead con Logotipo Profesional e Isotipo Emblemático -->
<div class="masthead">
<span class="sub-head">REVISTA CIENTÍFICA & ANÁLISIS ESTRATÉGICO GLOBAL</span>

<div class="brand-container">
<a href="/" class="brand-link" aria-label="News Internacional TEP">
<!-- Emblema / Isotipo Vectorial Oficial -->
<svg class="brand-emblem" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect width="64" height="64" rx="14" fill="#080e21"/>
<rect x="2" y="2" width="60" height="60" rx="12" stroke="#1e3a8a" stroke-width="2"/>
<circle cx="32" cy="32" r="22" stroke="#38bdf8" stroke-width="1.8" stroke-opacity="0.4"/>
<ellipse cx="32" cy="32" rx="11" ry="22" stroke="#38bdf8" stroke-width="1.8" stroke-opacity="0.6"/>
<line x1="10" y1="32" x2="54" y2="32" stroke="#38bdf8" stroke-width="1.8" stroke-opacity="0.6"/>
<text x="32" y="37" font-family="system-ui, sans-serif" font-size="11" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="1">TEP</text>
<circle cx="48" cy="16" r="3.5" fill="#dc2626"/>
</svg>

<!-- Logotipo Tipográfico -->
<div class="brand-text-wrap">
<h1 class="main-title">
NEWS INTERNACIONAL <span class="brand-badge-tep">TEP</span>
</h1>
</div>
</a>
</div>

<!-- Sub-navegación con colores temáticos bien diferenciados -->
<div class="tagline-nav">
<a href="/categoria/tecnologia" class="tagline-link tag-tech">
<span class="tag-bullet bullet-tech"></span> TECNOLOGÍA
</a>
<span class="dot">•</span>
<a href="/categoria/economia" class="tagline-link tag-econ">
<span class="tag-bullet bullet-econ"></span> ECONOMÍA
</a>
<span class="dot">•</span>
<a href="/categoria/geopolitica" class="tagline-link tag-geo">
<span class="tag-bullet bullet-geo"></span> GEOPOLÍTICA
</a>
</div>
</div>

<!-- 5. Barra de Navegación Principal -->
<nav class="nav-sections">
<div class="nav-wrap">
<a href="/" class="nav-link active">Inicio</a>
<a href="/categoria/geopolitica" class="nav-link nav-geo">Geopolítica</a>
<a href="/categoria/economia" class="nav-link nav-econ">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link nav-tech">Tecnología & IA</a>
<a href="/about" class="nav-link">Línea Editorial</a>
</div>
</nav>
</header>

<style>
.tep-global-header {
background: #ffffff;
border-bottom: 2px solid #0f172a;
color: #0f172a;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
width: 100%;
}

/* TICKERS CONTINUOS (AZULES NOCHE DE MARCA) */
.ticker-time-wrapper {
background: #050914;
color: #94a3b8;
font-size: 0.72rem;
font-weight: 700;
border-bottom: 1px solid #141c33;
height: 34px;
display: flex;
align-items: center;
overflow: hidden;
}
.ticker-label-time {
background: #0f1e47;
color: #f8fafc;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
box-shadow: 6px 0 12px rgba(0,0,0,0.5);
}

.ticker-market-wrapper {
background: #0a1228;
color: #ffffff;
font-size: 0.74rem;
border-bottom: 1px solid #19274e;
height: 36px;
display: flex;
align-items: center;
overflow: hidden;
}
.ticker-label-market {
background: #14285e;
color: #ffffff;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
box-shadow: 6px 0 12px rgba(0,0,0,0.5);
}

.ticker-viewport {
flex: 1;
height: 100%;
overflow: hidden;
position: relative;
display: flex;
align-items: center;
}
.ticker-track-loop {
display: flex;
width: max-content;
will-change: transform;
}
.ticker-group {
display: flex;
align-items: center;
gap: 3rem;
padding-right: 3rem;
flex-shrink: 0;
}
.time-track {
animation: circularMarquee 38s linear infinite;
}
.market-track {
animation: circularMarquee 48s linear infinite;
}
.ticker-track-loop:hover {
animation-play-state: paused;
}
@keyframes circularMarquee {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

.time-item, .market-item {
display: inline-flex;
align-items: center;
gap: 0.5rem;
white-space: nowrap;
}
.time-city {
color: #cbd5e1;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.time-val {
color: #38bdf8;
font-variant-numeric: tabular-nums;
font-weight: 700;
}
.market-name {
color: #e2e8f0;
font-weight: 700;
}
.market-val {
color: #cbd5e1;
font-variant-numeric: tabular-nums;
font-weight: 600;
}
.badge-up {
background: rgba(16, 185, 129, 0.2);
color: #10b981;
border: 1px solid #059669;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}
.badge-down {
background: rgba(239, 68, 68, 0.2);
color: #ef4444;
border: 1px solid #dc2626;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}

/* BARRA DE UTILIDAD */
.top-utility-bar {
max-width: 1580px;
width: 94%;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.5rem 0;
font-size: 0.78rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 800;
text-transform: uppercase;
color: #0f172a;
margin-right: 0.8rem;
border-right: 1px solid #cbd5e1;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
font-weight: 500;
}
.live-pulse-btn {
display: inline-flex;
align-items: center;
gap: 6px;
color: #0284c7;
text-decoration: none;
font-weight: 700;
font-size: 0.76rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0%, 100% { transform: scale(0.95); opacity: 0.8; }
50% { transform: scale(1.2); opacity: 1; }
}

/* MASTHEAD & LOGO OFICIAL */
.masthead {
text-align: center;
padding: 2rem 1rem 1.4rem;
border-bottom: 1px solid #0f172a;
}
.sub-head {
font-size: 0.74rem;
font-weight: 800;
color: #475569;
letter-spacing: 0.18em;
display: block;
margin-bottom: 0.7rem;
}
.brand-container {
display: flex;
justify-content: center;
align-items: center;
margin-bottom: 0.4rem;
}
.brand-link {
display: inline-flex;
align-items: center;
gap: 1.2rem;
text-decoration: none;
color: #0f172a;
}
.brand-emblem {
width: 52px;
height: 52px;
flex-shrink: 0;
box-shadow: 0 4px 12px rgba(8, 14, 33, 0.15);
border-radius: 12px;
}
.main-title {
font-size: clamp(2.3rem, 5.5vw, 3.8rem);
font-weight: 950;
letter-spacing: -0.04em;
margin: 0;
line-height: 1;
color: #0f172a;
text-transform: uppercase;
display: flex;
align-items: center;
gap: 0.4rem;
}
.brand-badge-tep {
color: #0f1e47;
background: #eff6ff;
border: 2px solid #bfdbfe;
padding: 0 0.4rem;
border-radius: 6px;
letter-spacing: -0.02em;
}

/* SUB-NAVEGACIÓN CON COLORES DIFERENCIADOS */
.tagline-nav {
display: flex;
justify-content: center;
align-items: center;
gap: 1.4rem;
margin-top: 1rem;
}
.tagline-link {
font-size: 0.76rem;
font-weight: 800;
letter-spacing: 0.12em;
text-decoration: none;
display: inline-flex;
align-items: center;
gap: 6px;
transition: opacity 0.15s ease;
}
.tag-bullet {
width: 7px;
height: 7px;
border-radius: 50%;
}
.bullet-tech { background: #2563eb; box-shadow: 0 0 6px rgba(37, 99, 235, 0.4); }
.bullet-econ { background: #059669; box-shadow: 0 0 6px rgba(5, 150, 105, 0.4); }
.bullet-geo  { background: #dc2626; box-shadow: 0 0 6px rgba(220, 38, 38, 0.4); }

.tag-tech { color: #2563eb; }
.tag-econ { color: #059669; }
.tag-geo  { color: #dc2626; }
.tagline-link:hover { opacity: 0.75; }

.dot {
color: #cbd5e1;
font-size: 0.8rem;
}

/* BARRA DE SECCIONES */
.nav-sections {
border-top: 1px solid #e2e8f0;
}
.nav-wrap {
max-width: 1580px;
width: 94%;
margin: 0 auto;
display: flex;
justify-content: center;
align-items: center;
flex-wrap: wrap;
gap: 0 2.5rem;
padding: 0.75rem 0;
}
.nav-link {
color: #1e293b;
text-decoration: none;
font-size: 0.84rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
padding: 0.35rem 0;
border-bottom: 2px solid transparent;
transition: all 0.15s ease;
}
.nav-link:hover, .nav-link.active {
color: #0f172a;
border-bottom-color: #0f172a;
}
.nav-link.nav-tech:hover { color: #2563eb; border-bottom-color: #2563eb; }
.nav-link.nav-econ:hover { color: #059669; border-bottom-color: #059669; }
.nav-link.nav-geo:hover  { color: #dc2626; border-bottom-color: #dc2626; }

@media (max-width: 768px) {
.utility-left { display: flex; flex-direction: column; gap: 2px; }
.nav-wrap { justify-content: flex-start; overflow-x: auto; white-space: nowrap; gap: 0 1.2rem; }
.brand-link { gap: 0.8rem; }
.brand-emblem { width: 42px; height: 42px; }
}
</style>

<script is:inline>
function updateClocks() {
const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
const now = new Date();
const elements = document.querySelectorAll('[data-tz]');

elements.forEach((el) => {
const tz = el.getAttribute('data-tz');
if (tz) {
try {
el.textContent = new Intl.DateTimeFormat('es-MX', { ...opts, timeZone: tz }).format(now);
} catch (e) {}
}
});
}
updateClocks();
setInterval(updateClocks, 1000);
</script>