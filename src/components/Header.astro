---
const today = new Date().toLocaleDateString('es-MX', {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric',
});

const marketData = [
{ asset: 'USD / EUR', val: '0.9241', change: '+0.18%', up: true },
{ asset: 'USD / MXN', val: '19.342', change: '-0.42%', up: false },
{ asset: 'USD / JPY', val: '149.25', change: '+0.31%', up: true },
{ asset: 'GBP / USD', val: '1.3060', change: '-0.15%', up: false },
{ asset: 'ORO (XAU/USD)', val: '$2,654.80', change: '+0.64%', up: true },
{ asset: 'BRENT CRUDO', val: '$77.40', change: '-1.15%', up: false },
{ asset: 'BITCOIN', val: '$64,280', change: '+2.10%', up: true },
{ asset: 'S&P 500', val: '5,815.20', change: '+0.45%', up: true },
{ asset: 'NASDAQ 100', val: '20,240.10', change: '+0.72%', up: true },
{ asset: 'BONO EE.UU. 10A', val: '4.08%', change: '-0.03%', up: false },
];
---

<header class="tep-global-header">
<!-- 1. Ticker Horario Mundial Cíclico -->
<div class="ticker-time-wrapper">
<div class="ticker-label-time">HORA GLOBAL</div>
<div class="ticker-viewport">
<div class="ticker-track-loop time-track">
<div class="ticker-group">
<div class="time-item"><span class="time-city">Nueva York:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
<div class="ticker-group" aria-hidden="true">
<div class="time-item"><span class="time-city">Nueva York:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
</div>
</div>
</div>

<!-- 2. Ticker Mercados & Divisas Cíclico -->
<div class="ticker-market-wrapper">
<div class="ticker-label-market">MERCADOS & DIVISAS</div>
<div class="ticker-viewport">
<div class="ticker-track-loop market-track">
<div class="ticker-group">
{marketData.map((m) => (
<div class="market-item">
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
<div class="ticker-group" aria-hidden="true">
{marketData.map((m) => (
<div class="market-item">
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
</div>
</div>
</div>

<!-- 3. Utilidad Superior -->
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Internacional</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Alertas TEP</span>
</a>
</div>
</div>

<!-- 4. Masthead Oficial con Buscador Discreto Superior -->
<div class="masthead">
<!-- BUSCADOR DISCRETO CON ACCESO A BÚSQUEDA AVANZADA (SUSTITUYE AL TEXTO REDUNDANTE) -->
<div class="header-search-container">
<div class="discrete-search-box">
<svg class="search-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="11" cy="11" r="8"/>
<line x1="21" y1="21" x2="16.65" y2="16.65"/>
</svg>
<input
type="text"
id="quick-search-input"
placeholder="Buscar investigaciones, cifras, informes..."
autocomplete="off"
/>
<button type="button" class="advanced-filter-btn" id="open-advanced-modal-btn" title="Abrir Búsqueda Avanzada">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
<line x1="4" y1="21" x2="4" y2="14"/>
<line x1="4" y1="10" x2="4" y2="3"/>
<line x1="12" y1="21" x2="12" y2="12"/>
<line x1="12" y1="8" x2="12" y2="3"/>
<line x1="20" y1="21" x2="20" y2="16"/>
<line x1="20" y1="12" x2="20" y2="3"/>
<line x1="1" y1="14" x2="7" y2="14"/>
<line x1="9" y1="8" x2="15" y2="8"/>
<line x1="17" y1="16" x2="23" y2="16"/>
</svg>
<span>Búsqueda Avanzada</span>
</button>
</div>
</div>

<!-- Logotipo Oficial Centrado y Recuadro TEP Alineado -->
<div class="brand-container">
<a href="/" class="brand-link" aria-label="TEP NEWS">
<img 
src="/logo.png" 
alt="TEP NEWS - Logo Oficial" 
class="brand-logo-img"
width="68"
height="68"
loading="eager"
onerror="if(!this.dataset.retry){this.dataset.retry=1;this.src='/logo.jpg';}else if(this.dataset.retry==1){this.dataset.retry=2;this.src='/Logo.jpg';}else if(this.dataset.retry==2){this.dataset.retry=3;this.src='/Logo.png';}"
/>

<div class="brand-text-wrap">
<h1 class="main-title">
NEWS INTERNACIONAL <span class="brand-badge-tep">TEP</span>
</h1>
</div>
</a>
</div>
</div>
</header>

<!-- 5. NAVEGACIÓN ADHERENTE (STICKY) -->
<nav class="nav-sections sticky-nav">
<div class="nav-wrap">
<a href="/" class="nav-link active">Inicio</a>
<a href="/categoria/geopolitica" class="nav-link nav-geo">Geopolítica</a>
<a href="/categoria/economia" class="nav-link nav-econ">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link nav-tech">Tecnología & IA</a>
<a href="/about" class="nav-link">Línea Editorial</a>
</div>
</nav>

<!-- MODAL DE BÚSQUEDA AVANZADA MULTIDIMENSIONAL -->
<div id="search-modal-backdrop" class="search-backdrop hidden">
<div class="search-modal-window">
<div class="modal-top-bar">
<div class="modal-title-wrap">
<div class="modal-badge-red">FILTROS DE INTELIGENCIA</div>
<h3 class="modal-title">Búsqueda Avanzada en Archivo TEP</h3>
</div>
<button type="button" id="close-advanced-modal-btn" class="modal-close-icon" aria-label="Cerrar modal">✕</button>
</div>

<form id="advanced-search-form" class="modal-filters-grid" onsubmit="return false;">
<div class="filter-group full-width">
<label for="adv-input-query">Término de Búsqueda o Título</label>
<input type="text" id="adv-input-query" placeholder="Ej: Semiconductores, Bancos Centrales, Taiwán..." />
</div>

<div class="filter-group">
<label for="adv-select-cat">Sección Informativa</label>
<select id="adv-select-cat">
<option value="all">Todas las Secciones</option>
<option value="geopolitica">Geopolítica & Orden Global</option>
<option value="economia">Economía & Mercados</option>
<option value="tecnologia">Tecnología & IA</option>
</select>
</div>

<div class="filter-group">
<label for="adv-select-date">Fecha de Publicación</label>
<select id="adv-select-date">
<option value="all">Cualquier Fecha</option>
<option value="7">Últimos 7 días</option>
<option value="30">Últimos 30 días</option>
<option value="90">Últimos 3 meses</option>
</select>
</div>

<div class="filter-group">
<label for="adv-input-author">Autor / Redacción</label>
<input type="text" id="adv-input-author" placeholder="Ej: Redacción TEP, Comité..." />
</div>

<div class="filter-group">
<label for="adv-input-tag">Palabra Clave (Tag)</label>
<input type="text" id="adv-input-tag" placeholder="Ej: chips, fed, defensa..." />
</div>
</form>

<!-- Resultados Dinámicos en Tiempo Real -->
<div class="search-results-area">
<div class="results-header">
<span id="results-count-badge">0 resultados encontrados</span>
<span class="results-hint">Escribe o selecciona filtros para actualizar</span>
</div>
<div id="search-results-list" class="results-container">
<div class="empty-search-state">
<p>Introduce un término o aplica los filtros para buscar en la base de datos documental.</p>
</div>
</div>
</div>
</div>
</div>

<style>
.tep-global-header {
background: #ffffff;
color: #050505;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
width: 100%;
}

/* TICKERS CONTINUOS */
.ticker-time-wrapper {
background: #050505;
color: #94a3b8;
font-size: 0.72rem;
font-weight: 700;
border-bottom: 1px solid #1c1c1c;
height: 34px;
display: flex;
align-items: center;
overflow: hidden;
}
.ticker-label-time {
background: #121212;
color: #ffffff;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
border-right: 2px solid #dc2626;
box-shadow: 4px 0 12px rgba(0,0,0,0.6);
}

.ticker-market-wrapper {
background: #0a0a0a;
color: #ffffff;
font-size: 0.74rem;
border-bottom: 1px solid #1a1a1a;
height: 36px;
display: flex;
align-items: center;
overflow: hidden;
}
.ticker-label-market {
background: #dc2626;
color: #ffffff;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
box-shadow: 4px 0 12px rgba(220, 38, 38, 0.4);
}

.ticker-viewport {
flex: 1;
height: 100%;
overflow: hidden;
position: relative;
display: flex;
align-items: center;
}
.ticker-track-loop {
display: flex;
width: max-content;
will-change: transform;
}
.ticker-group {
display: flex;
align-items: center;
gap: 3rem;
padding-right: 3rem;
flex-shrink: 0;
}
.time-track { animation: circularMarquee 38s linear infinite; }
.market-track { animation: circularMarquee 48s linear infinite; }
.ticker-track-loop:hover { animation-play-state: paused; }

@keyframes circularMarquee {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

.time-item, .market-item {
display: inline-flex;
align-items: center;
gap: 0.5rem;
white-space: nowrap;
}
.time-city {
color: #cbd5e1;
text-transform: uppercase;
letter-spacing: 0.04em;
}
.time-val {
color: #f87171;
font-variant-numeric: tabular-nums;
font-weight: 700;
}
.market-name { color: #e2e8f0; font-weight: 700; }
.market-val { color: #ffffff; font-variant-numeric: tabular-nums; font-weight: 700; }
.badge-up {
background: rgba(16, 185, 129, 0.2);
color: #10b981;
border: 1px solid #059669;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}
.badge-down {
background: rgba(239, 68, 68, 0.25);
color: #f87171;
border: 1px solid #dc2626;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}

/* UTILIDAD SUPERIOR */
.top-utility-bar {
max-width: 1580px;
width: 94%;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.5rem 0;
font-size: 0.78rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 900;
text-transform: uppercase;
color: #050505;
margin-right: 0.8rem;
border-right: 2px solid #050505;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
font-weight: 600;
color: #475569;
}
.live-pulse-btn {
display: inline-flex;
align-items: center;
gap: 6px;
color: #dc2626;
text-decoration: none;
font-weight: 800;
font-size: 0.76rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0%, 100% { transform: scale(0.95); opacity: 0.8; }
50% { transform: scale(1.25); opacity: 1; }
}

/* MASTHEAD & BUSCADOR DISCRETO SUPERIOR */
.masthead {
text-align: center;
padding: 1.2rem 1rem 1.4rem;
}

.header-search-container {
display: flex;
justify-content: center;
margin-bottom: 1.2rem;
}
.discrete-search-box {
display: flex;
align-items: center;
background: #f8fafc;
border: 1px solid #cbd5e1;
border-radius: 30px;
padding: 0.35rem 0.5rem 0.35rem 1rem;
width: 100%;
max-width: 620px;
transition: all 0.2s ease;
box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
}
.discrete-search-box:focus-within {
border-color: #dc2626;
background: #ffffff;
box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
}
.search-icon-svg {
color: #94a3b8;
margin-right: 0.6rem;
flex-shrink: 0;
}
.discrete-search-box input {
border: none;
outline: none;
background: transparent;
font-size: 0.85rem;
color: #0f172a;
width: 100%;
font-family: inherit;
}
.discrete-search-box input::placeholder {
color: #94a3b8;
font-size: 0.82rem;
}
.advanced-filter-btn {
display: inline-flex;
align-items: center;
gap: 6px;
background: #050505;
color: #ffffff;
border: none;
border-radius: 20px;
padding: 0.38rem 0.85rem;
font-size: 0.72rem;
font-weight: 800;
letter-spacing: 0.04em;
text-transform: uppercase;
cursor: pointer;
white-space: nowrap;
transition: background 0.15s ease;
}
.advanced-filter-btn:hover {
background: #dc2626;
}

/* LOGO Y TITULAR CON TEP CENTRADO */
.brand-container {
display: flex;
justify-content: center;
align-items: center;
}
.brand-link {
display: inline-flex;
align-items: center;
gap: 1.2rem;
text-decoration: none;
color: #050505;
}
.brand-logo-img {
width: 66px;
height: 66px;
object-fit: cover;
border-radius: 50%;
border: 2px solid #050505;
box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
flex-shrink: 0;
background: #050505;
}
.brand-text-wrap {
display: flex;
align-items: center;
}
.main-title {
font-size: clamp(2.1rem, 5vw, 3.6rem);
font-weight: 950;
letter-spacing: -0.04em;
margin: 0;
line-height: 1;
color: #050505;
text-transform: uppercase;
display: inline-flex;
align-items: center;
gap: 0.45rem;
}

/* RECUADRO ROJO TEP MATEMÁTICAMENTE CENTRADO */
.brand-badge-tep {
display: inline-flex;
align-items: center;
justify-content: center;
background: #dc2626;
color: #ffffff;
font-size: 0.7em;
font-weight: 950;
height: 1.18em;
padding: 0 0.42em;
border-radius: 4px;
letter-spacing: -0.01em;
box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
line-height: 1;
align-self: center;
vertical-align: middle;
}

/* NAVEGACIÓN STICKY */
.sticky-nav {
position: sticky;
top: 0;
z-index: 1000;
background: rgba(255, 255, 255, 0.98);
backdrop-filter: blur(10px);
border-top: 1px solid #e2e8f0;
border-bottom: 2px solid #050505;
box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
}
.nav-wrap {
max-width: 1580px;
width: 94%;
margin: 0 auto;
display: flex;
justify-content: center;
align-items: center;
flex-wrap: wrap;
gap: 0 2.5rem;
padding: 0.75rem 0;
}
.nav-link {
color: #050505;
text-decoration: none;
font-size: 0.84rem;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 0.05em;
padding: 0.35rem 0;
border-bottom: 2px solid transparent;
transition: all 0.15s ease;
}
.nav-link:hover, .nav-link.active {
color: #dc2626;
border-bottom-color: #dc2626;
}
.nav-link.nav-tech:hover { color: #2563eb; border-bottom-color: #2563eb; }
.nav-link.nav-econ:hover { color: #059669; border-bottom-color: #059669; }
.nav-link.nav-geo:hover  { color: #dc2626; border-bottom-color: #dc2626; }

/* MODAL DE BÚSQUEDA AVANZADA */
.search-backdrop {
position: fixed;
inset: 0;
z-index: 99999;
background: rgba(5, 5, 5, 0.75);
backdrop-filter: blur(6px);
display: flex;
align-items: flex-start;
justify-content: center;
padding: 3rem 1rem;
overflow-y: auto;
}
.search-backdrop.hidden {
display: none;
}
.search-modal-window {
background: #ffffff;
border-radius: 10px;
max-width: 840px;
width: 100%;
border: 1px solid #1e293b;
box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
overflow: hidden;
animation: modalFadeIn 0.2s ease-out;
}
@keyframes modalFadeIn {
from { opacity: 0; transform: translateY(-12px); }
to { opacity: 1; transform: translateY(0); }
}

.modal-top-bar {
background: #050505;
color: #ffffff;
padding: 1.2rem 1.6rem;
display: flex;
justify-content: space-between;
align-items: center;
border-bottom: 2px solid #dc2626;
}
.modal-badge-red {
font-size: 0.68rem;
font-weight: 900;
letter-spacing: 0.12em;
color: #f87171;
margin-bottom: 0.2rem;
}
.modal-title {
font-size: 1.25rem;
font-weight: 900;
margin: 0;
color: #ffffff;
}
.modal-close-icon {
background: transparent;
border: none;
color: #94a3b8;
font-size: 1.4rem;
cursor: pointer;
padding: 0.2rem 0.5rem;
border-radius: 4px;
transition: color 0.15s ease;
}
.modal-close-icon:hover {
color: #ffffff;
}

/* FILTROS DE BÚSQUEDA */
.modal-filters-grid {
padding: 1.4rem 1.6rem;
background: #f8fafc;
border-bottom: 1px solid #e2e8f0;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 1rem 1.2rem;
}
.filter-group {
display: flex;
flex-direction: column;
gap: 0.35rem;
}
.filter-group.full-width {
grid-column: 1 / -1;
}
.filter-group label {
font-size: 0.72rem;
font-weight: 800;
text-transform: uppercase;
letter-spacing: 0.05em;
color: #475569;
}
.filter-group input, .filter-group select {
padding: 0.55rem 0.8rem;
border-radius: 6px;
border: 1px solid #cbd5e1;
font-size: 0.88rem;
font-family: inherit;
outline: none;
background: #ffffff;
color: #0f172a;
}
.filter-group input:focus, .filter-group select:focus {
border-color: #dc2626;
box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.15);
}

/* RESULTADOS */
.search-results-area {
padding: 1.4rem 1.6rem;
max-height: 440px;
overflow-y: auto;
}
.results-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 1rem;
font-size: 0.78rem;
font-weight: 700;
color: #64748b;
}
#results-count-badge {
color: #050505;
font-weight: 900;
text-transform: uppercase;
letter-spacing: 0.05em;
}
.results-container {
display: flex;
flex-direction: column;
gap: 0.8rem;
}
.result-item-card {
display: flex;
gap: 1rem;
padding: 0.9rem;
border-radius: 6px;
border: 1px solid #e2e8f0;
background: #ffffff;
text-decoration: none;
color: inherit;
transition: all 0.15s ease;
}
.result-item-card:hover {
border-color: #dc2626;
background: #fef2f2;
transform: translateX(3px);
}
.result-thumb {
width: 80px;
height: 60px;
object-fit: cover;
border-radius: 4px;
flex-shrink: 0;
}
.result-details {
flex: 1;
}
.result-meta-row {
display: flex;
align-items: center;
gap: 0.6rem;
font-size: 0.7rem;
font-weight: 800;
text-transform: uppercase;
margin-bottom: 0.25rem;
}
.badge-cat-geo { color: #dc2626; }
.badge-cat-econ { color: #059669; }
.badge-cat-tech { color: #2563eb; }
.result-title {
font-size: 0.95rem;
font-weight: 800;
margin: 0 0 0.3rem;
color: #050505;
line-height: 1.3;
}
.result-snippet {
font-size: 0.8rem;
color: #64748b;
margin: 0;
line-height: 1.4;
display: -webkit-box;
-webkit-line-clamp: 2;
-webkit-box-orient: vertical;
overflow: hidden;
}
.empty-search-state {
text-align: center;
padding: 2.5rem 1rem;
color: #94a3b8;
font-size: 0.88rem;
}

