---
const today = new Date().toLocaleDateString('es-MX', {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric',
});
---

<header class="nyt-header">
<!-- 1. Barra superior de datos y canal en vivo -->
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Internacional</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Telegram</span>
</a>
</div>
</div>

<!-- 2. Masthead con logotipo y enlaces seccionados -->
<div class="masthead">
<span class="sub-head">El Diario Analítico Global</span>
<h1 class="main-title">
<a href="/" class="brand-link">NEWS INTERNACIONAL <span>TEP</span></a>
</h1>
<!-- Sub-encabezado seccionado con enlaces directos -->
<div class="tagline-nav">
<a href="/categoria/tecnologia" class="tagline-link">TECNOLOGÍA</a>
<span class="dot">•</span>
<a href="/categoria/economia" class="tagline-link">ECONOMÍA</a>
<span class="dot">•</span>
<a href="/categoria/geopolitica" class="tagline-link">POLÍTICA INTERNACIONAL</a>
</div>
</div>

<!-- 3. Navegación temática -->
<nav class="nav-sections">
<div class="nav-wrap">
<a href="/" class="nav-link">Portada</a>
<a href="/categoria/geopolitica" class="nav-link">Geopolítica</a>
<a href="/categoria/economia" class="nav-link">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link">Inteligencia Artificial & Tech</a>
<a href="/about" class="nav-link">Línea Editorial</a>
</div>
</nav>
</header>

<style>
.nyt-header {
background: #ffffff;
border-bottom: 3px double #121212;
color: #121212;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.top-utility-bar {
max-width: 1200px;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.4rem 1rem;
font-size: 0.78rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 800;
text-transform: uppercase;
color: #0f172a;
margin-right: 0.8rem;
border-right: 1px solid #cbd5e1;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
}
.live-pulse-btn {
display: inline-flex;
align-items: center;
gap: 6px;
color: #0284c7;
text-decoration: none;
font-weight: 700;
font-size: 0.78rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0% { transform: scale(0.95); opacity: 0.8; }
70% { transform: scale(1.1); opacity: 1; }
100% { transform: scale(0.95); opacity: 0.8; }
}
.masthead {
text-align: center;
padding: 1.8rem 1rem 1.2rem;
border-bottom: 1px solid #121212;
}
.brand-link {
text-decoration: none;
color: inherit;
}
.sub-head {
font-family: "Georgia", serif;
font-style: italic;
font-size: 0.88rem;
color: #475569;
letter-spacing: 0.05em;
display: block;
margin-bottom: 0.3rem;
}
.main-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2rem, 5.5vw, 3.4rem);
font-weight: 900;
letter-spacing: -0.03em;
margin: 0;
line-height: 1;
color: #111827;
text-transform: uppercase;
}
.main-title span {
color: #1e3a8a;
font-style: italic;
}
.tagline-nav {
display: flex;
justify-content: center;
align-items: center;
gap: 0.8rem;
margin-top: 0.7rem;
}
.tagline-link {
font-size: 0.72rem;
font-weight: 800;
letter-spacing: 0.14em;
color: #475569;
text-decoration: none;
transition: color 0.15s ease;
}
.tagline-link:hover {
color: #1e3a8a;
text-decoration: underline;
}
.dot {
color: #94a3b8;
font-size: 0.8rem;
}
.nav-sections {
border-top: 1px solid #e2e8f0;
}
.nav-wrap {
max-width: 1200px;
margin: 0 auto;
display: flex;
justify-content: center;
align-items: center;
flex-wrap: wrap;
gap: 0 2rem;
padding: 0.6rem 1rem;
}
.nav-link {
color: #1e293b;
text-decoration: none;
font-size: 0.84rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
padding: 0.3rem 0;
border-bottom: 2px solid transparent;
transition: all 0.15s ease;
}
.nav-link:hover {
color: #1e3a8a;
border-bottom-color: #1e3a8a;
}
@media (max-width: 768px) {
.utility-left { display: flex; flex-direction: column; gap: 2px; }
.tagline-nav { flex-wrap: wrap; gap: 0.4rem; font-size: 0.68rem; }
.nav-wrap { justify-content: flex-start; overflow-x: auto; white-space: nowrap; gap: 0 1.2rem; }
}
</style>