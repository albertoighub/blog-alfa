---
const today = new Date().toLocaleDateString('es-MX', {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric',
});
---

<header class="tep-header">
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Global</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Alertas TEP</span>
</a>
</div>
</div>

<div class="masthead">
<span class="sub-head">INVESTIGACIÓN & PROSPECTIVA ESTRATÉGICA INTERNACIONAL</span>
<h1 class="main-title">
<a href="/" class="brand-link">NEWS INTERNACIONAL <span class="brand-accent">TEP</span></a>
</h1>
<div class="tagline-nav">
<a href="/categoria/tecnologia" class="tagline-link">TECNOLOGÍA</a>
<span class="dot">•</span>
<a href="/categoria/economia" class="tagline-link">ECONOMÍA</a>
<span class="dot">•</span>
<a href="/categoria/geopolitica" class="tagline-link">GEOPOLÍTICA</a>
</div>
</div>

<nav class="nav-sections">
<div class="nav-wrap">
<a href="/" class="nav-link active">Portada</a>
<a href="/categoria/geopolitica" class="nav-link">Geopolítica</a>
<a href="/categoria/economia" class="nav-link">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link">Tecnología & IA</a>
<a href="/about" class="nav-link">Línea Editorial</a>
</div>
</nav>
</header>

<style>
.tep-header {
background: #ffffff;
border-bottom: 2px solid #0f172a;
color: #0f172a;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
.top-utility-bar {
max-width: 1240px;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.45rem 1rem;
font-size: 0.76rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 800;
text-transform: uppercase;
color: #0f172a;
margin-right: 0.8rem;
border-right: 1px solid #cbd5e1;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
font-weight: 500;
}
.live-pulse-btn {
display: inline-flex;
align-items: center;
gap: 6px;
color: #0284c7;
text-decoration: none;
font-weight: 700;
font-size: 0.76rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0% { transform: scale(0.95); opacity: 0.8; }
70% { transform: scale(1.15); opacity: 1; }
100% { transform: scale(0.95); opacity: 0.8; }
}
.masthead {
text-align: center;
padding: 1.8rem 1rem 1.2rem;
border-bottom: 1px solid #0f172a;
}
.brand-link {
text-decoration: none;
color: inherit;
}
.sub-head {
font-size: 0.72rem;
font-weight: 800;
color: #64748b;
letter-spacing: 0.14em;
display: block;
margin-bottom: 0.4rem;
}
.main-title {
font-size: clamp(2.2rem, 5.5vw, 3.5rem);
font-weight: 900;
letter-spacing: -0.04em;
margin: 0;
line-height: 1;
color: #0f172a;
text-transform: uppercase;
}
.brand-accent {
color: #1e3a8a;
}
.tagline-nav {
display: flex;
justify-content: center;
align-items: center;
gap: 0.9rem;
margin-top: 0.8rem;
}
.tagline-link {
font-size: 0.74rem;
font-weight: 800;
letter-spacing: 0.12em;
color: #475569;
text-decoration: none;
transition: color 0.15s ease;
}
.tagline-link:hover {
color: #1e3a8a;
}
.dot {
color: #cbd5e1;
font-size: 0.8rem;
}
.nav-sections {
border-top: 1px solid #e2e8f0;
}
.nav-wrap {
max-width: 1240px;
margin: 0 auto;
display: flex;
justify-content: center;
align-items: center;
flex-wrap: wrap;
gap: 0 2rem;
padding: 0.6rem 1rem;
}
.nav-link {
color: #1e293b;
text-decoration: none;
font-size: 0.82rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
padding: 0.35rem 0;
border-bottom: 2px solid transparent;
transition: all 0.15s ease;
}
.nav-link:hover, .nav-link.active {
color: #1e3a8a;
border-bottom-color: #1e3a8a;
}
@media (max-width: 768px) {
.utility-left { display: flex; flex-direction: column; gap: 2px; }
.tagline-nav { flex-wrap: wrap; gap: 0.4rem; font-size: 0.7rem; }
.nav-wrap { justify-content: flex-start; overflow-x: auto; white-space: nowrap; gap: 0 1.2rem; }
}
</style>