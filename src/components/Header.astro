.brand-logo-img { width: 48px; height: 48px; }
.modal-filters-grid { grid-template-columns: 1fr; }
.discrete-search-box { max-width: 95%; }
.advanced-filter-btn span { display: none; }
}
</style>

<!-- SCRIPT DE SINCRONIZACIÓN Y MOTOR DE BÚSQUEDA DINÁMICA -->
<script is:inline>
// 1. Reloj Mundial en Vivo
function updateClocks() {
const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
const now = new Date();
const elements = document.querySelectorAll('[data-tz]');
elements.forEach((el) => {
const tz = el.getAttribute('data-tz');
if (tz) {
try {
el.textContent = new Intl.DateTimeFormat('es-MX', { ...opts, timeZone: tz }).format(now);
} catch (e) {}
}
});
}
updateClocks();
setInterval(updateClocks, 1000);

// 2. Motor de Búsqueda Client-Side en Tiempo Real
let cachedIndex = null;

async function fetchSearchIndex() {
if (cachedIndex) return cachedIndex;
try {
const res = await fetch('/search-index.json');
if (res.ok) {
cachedIndex = await res.json();
return cachedIndex;
}
} catch (e) {
console.error('Error cargando índice de búsqueda:', e);
}
return [];
}

function performSearch() {
if (!cachedIndex) return;

const query = (document.getElementById('adv-input-query')?.value || document.getElementById('quick-search-input')?.value || '').toLowerCase().trim();
const catFilter = document.getElementById('adv-select-cat')?.value || 'all';
const dateFilter = document.getElementById('adv-select-date')?.value || 'all';
const authorFilter = (document.getElementById('adv-input-author')?.value || '').toLowerCase().trim();
const tagFilter = (document.getElementById('adv-input-tag')?.value || '').toLowerCase().trim();

const now = new Date();

const filtered = cachedIndex.filter((item) => {
// Filtro Query (título o descripción)
if (query) {
const inTitle = item.title.toLowerCase().includes(query);
const inDesc = item.description.toLowerCase().includes(query);
if (!inTitle && !inDesc) return false;
}

// Filtro Categoría
if (catFilter !== 'all') {
const itemCat = item.category.toLowerCase();
if (catFilter === 'geopolitica' && !itemCat.includes('polít') && !itemCat.includes('polit') && !itemCat.includes('geopol')) return false;
if (catFilter === 'economia' && !itemCat.includes('econ') && !itemCat.includes('mercad') && !itemCat.includes('finan')) return false;
if (catFilter === 'tecnologia' && !itemCat.includes('tecn') && !itemCat.includes('ia') && !itemCat.includes('intel')) return false;
}

// Filtro Fecha
if (dateFilter !== 'all') {
const itemDate = new Date(item.pubDate);
const diffDays = (now - itemDate) / (1000 * 60 * 60 * 24);
if (diffDays > parseInt(dateFilter, 10)) return false;
}

// Filtro Autor
if (authorFilter && !item.author.toLowerCase().includes(authorFilter)) {
return false;
}

// Filtro Tags
if (tagFilter) {
const tagsStr = item.tags.join(' ').toLowerCase();
if (!tagsStr.includes(tagFilter)) return false;
}

return true;
});

renderResults(filtered);
}

function renderResults(items) {
const container = document.getElementById('search-results-list');
const badge = document.getElementById('results-count-badge');
if (!container || !badge) return;

badge.textContent = `${items.length} resultado${items.length === 1 ? '' : 's'} encontrado${items.length === 1 ? '' : 's'}`;

if (items.length === 0) {
container.innerHTML = `
<div class="empty-search-state">
<p>No se encontraron investigaciones que coincidan con los criterios seleccionados.</p>
</div>
`;
return;
}

container.innerHTML = items.map((post) => {
const catLower = post.category.toLowerCase();
let catClass = 'badge-cat-geo';
if (catLower.includes('econ') || catLower.includes('mercad')) catClass = 'badge-cat-econ';
if (catLower.includes('tecn') || catLower.includes('ia')) catClass = 'badge-cat-tech';

return `
<a href="${post.url}" class="result-item-card">
${post.heroImage ? `<img src="${post.heroImage}" alt="${post.title}" class="result-thumb" loading="lazy" />` : ''}
<div class="result-details">
<div class="result-meta-row">
<span class="${catClass}">${post.category}</span>
<span>•</span>
<span>${post.pubDate}</span>
<span>•</span>
<span>${post.author}</span>
</div>
<h4 class="result-title">${post.title}</h4>
<p class="result-snippet">${post.description}</p>
</div>
</a>
`;
}).join('');
}

// 3. Event Listeners del Modal y Buscador
document.addEventListener('DOMContentLoaded', () => {
const quickInput = document.getElementById('quick-search-input');
const advBtn = document.getElementById('open-advanced-modal-btn');
const closeBtn = document.getElementById('close-advanced-modal-btn');
const modal = document.getElementById('search-modal-backdrop');

const advQuery = document.getElementById('adv-input-query');
const advCat = document.getElementById('adv-select-cat');
const advDate = document.getElementById('adv-select-date');
const advAuthor = document.getElementById('adv-input-author');
const advTag = document.getElementById('adv-input-tag');

function openModal(initialQuery = '') {
fetchSearchIndex().then(() => {
if (modal) modal.classList.remove('hidden');
if (advQuery) {
advQuery.value = initialQuery;
advQuery.focus();
}
performSearch();
});
}

function closeModal() {
if (modal) modal.classList.add('hidden');
}

if (quickInput) {
quickInput.addEventListener('focus', () => openModal(quickInput.value));
quickInput.addEventListener('keydown', (e) => {
if (e.key === 'Enter') openModal(quickInput.value);
});
}

if (advBtn) advBtn.addEventListener('click', () => openModal(quickInput?.value || ''));
if (closeBtn) closeBtn.addEventListener('click', closeModal);

if (modal) {
modal.addEventListener('click', (e) => {
if (e.target === modal) closeModal();
});
}

window.addEventListener('keydown', (e) => {
if (e.key === 'Escape') closeModal();
});

// Filtros reactivos en tiempo real
[advQuery, advCat, advDate, advAuthor, advTag].forEach((el) => {
if (el) {
el.addEventListener('input', performSearch);
el.addEventListener('change', performSearch);
}
});
});
</script>