<!-- Script de cálculo de hora en vivo con segundos -->
<script is:inline>
function updateHeaderClocks() {
const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
const now = new Date();
const fmt = (tz) => new Intl.DateTimeFormat('es-MX', { ...opts, timeZone: tz }).format(now);

const tzList = [
{ id: 'time-ny', id2: 'time-ny-2', tz: 'America/New_York' },
{ id: 'time-lon', id2: 'time-lon-2', tz: 'Europe/London' },
{ id: 'time-fra', id2: 'time-fra-2', tz: 'Europe/Berlin' },
{ id: 'time-tok', id2: 'time-tok-2', tz: 'Asia/Tokyo' },
{ id: 'time-sin', id2: 'time-sin-2', tz: 'Asia/Singapore' },
{ id: 'time-dxb', id2: 'time-dxb-2', tz: 'Asia/Dubai' },
{ id: 'time-mex', id2: 'time-mex-2', tz: 'America/Mexico_City' },
];

tzList.forEach(({ id, id2, tz }) => {
const val = fmt(tz);
const el1 = document.getElementById(id);
const el2 = document.getElementById(id2);
if (el1) el1.textContent = val;
if (el2) el2.textContent = val;
});
}
updateHeaderClocks();
setInterval(updateHeaderClocks, 1000);
</script>