---
// Formato de fecha exacto: "miércoles, 14 de Octubre de 2026"
const today = new Date();
const formattedDate = today.toLocaleDateString('zh-CN', {
weekday: 'long',
day: 'numeric',
month: 'long',
year: 'numeric'
}).replace(/^\w/, (c) => c.toUpperCase()); // Mayúscula inicial al día

const marketData = [
{ asset: 'USD / EUR', val: '0.9241', change: '+0.18%', up: true },
{ asset: 'USD / MXN', val: '19.342', change: '-0.42%', up: false },
{ asset: 'USD / JPY', val: '149.25', change: '+0.31%', up: true },
{ asset: 'GBP / USD', val: '1.3060', change: '-0.15%', up: false },
{ asset: '现货黄金 (XAU/USD)', val: '$2,654.80', change: '+0.64%', up: true },
{ asset: '布伦特原油', val: '$77.40', change: '-1.15%', up: false },
{ asset: 'BITCOIN', val: '$64,280', change: '+2.10%', up: true },
{ asset: 'S&P 500', val: '5,815.20', change: '+0.45%', up: true },
{ asset: 'NASDAQ 100', val: '20,240.10', change: '+0.72%', up: true },
{ asset: '美债10年期', val: '4.08%', change: '-0.03%', up: false },
];
---

<div id="global-progress-bar"></div>
<header class="tep-global-header">
<!-- 1. Ticker Horario Mundial (Ajuste de bordes cero) -->
<div class="ticker-time-wrapper">
<div class="ticker-label-time">全球标准时间</div>
<div class="ticker-viewport">
<div class="ticker-track-loop time-track">
<div class="ticker-group">
<div class="time-item"><span class="time-city">纽约:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">伦敦:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">法兰克福:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">东京:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">新加坡:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">迪拜:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">墨西哥城:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
<div class="ticker-group" aria-hidden="true">
<div class="time-item"><span class="time-city">纽约:</span> <span class="time-val" data-tz="America/New_York">--:--:--</span></div>
<div class="time-item"><span class="time-city">伦敦:</span> <span class="time-val" data-tz="Europe/London">--:--:--</span></div>
<div class="time-item"><span class="time-city">法兰克福:</span> <span class="time-val" data-tz="Europe/Berlin">--:--:--</span></div>
<div class="time-item"><span class="time-city">东京:</span> <span class="time-val" data-tz="Asia/Tokyo">--:--:--</span></div>
<div class="time-item"><span class="time-city">新加坡:</span> <span class="time-val" data-tz="Asia/Singapore">--:--:--</span></div>
<div class="time-item"><span class="time-city">迪拜:</span> <span class="time-val" data-tz="Asia/Dubai">--:--:--</span></div>
<div class="time-item"><span class="time-city">墨西哥城:</span> <span class="time-val" data-tz="America/Mexico_City">--:--:--</span></div>
</div>
</div>
</div>
</div>

<!-- 2. Ticker Mercados & Divisas (Ajuste de bordes cero) -->
<div class="ticker-market-wrapper">
<div class="ticker-label-market">全球金融市场与外汇</div>
<div class="ticker-viewport">
<div class="ticker-track-loop market-track">
<div class="ticker-group">
{marketData.map((m) => (
<div class="market-item" data-asset={m.asset}>
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
<div class="ticker-group" aria-hidden="true">
{marketData.map((m) => (
<div class="market-item" data-asset={m.asset}>
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
</div>
</div>
</div>

<!-- 3. Utilidad Superior (Fecha en tiempo real, Indicador Atómico y Audio Brief) -->
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Internacional</span>
<span class="utility-date" id="live-header-date">{formattedDate}</span>
<span class="live-realtime-indicator" title="Sincronizado con tiempo atómico"><span class="clock-sync-dot"></span> TIEMPO REAL</span>
</div>
<div class="utility-right">
<div class="edition-selector-bar">
<span class="edition-selector-label">国家 / 语言:</span>
<a href="https://newsinternacionaltep.com" class="edition-pill" title="西班牙语版 (Español)">
<span class="edition-flag">🇪🇸</span>
<span class="edition-lang">Español</span>
</a>
<a href="https://international.newsinternacionaltep.com" class="edition-pill" title="国际英文版 (English)">
<span class="edition-flag">🇬🇧</span>
<span class="edition-lang">English</span>
</a>
<a href="https://china.newsinternacionaltep.com" class="edition-pill is-active" title="亚太中文版 (中文)">
<span class="edition-flag">🇨🇳</span>
<span class="edition-lang">中文</span>
</a>
</div>
</div>
</div>

<!-- 4. Masthead Oficial con Buscador Discreto Superior -->
<div class="masthead">
<!-- BUSCADOR DISCRETO (Sustituye textos redundantes) -->
<div class="header-search-container">
<div class="discrete-search-box">
<svg class="search-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="11" cy="11" r="8"/>
<line x1="21" y1="21" x2="16.65" y2="16.65"/>
</svg>
<input
type="text"
id="quick-search-input"
placeholder="Buscar investigaciones, cifras, informes..."
autocomplete="off"
/>
<button type="button" class="advanced-filter-btn" id="open-advanced-modal-btn" title="Abrir 深度检索">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
<line x1="4" y1="21" x2="4" y2="14"/>
<line x1="4" y1="10" x2="4" y2="3"/>
<line x1="12" y1="21" x2="12" y2="12"/>
<line x1="12" y1="8" x2="12" y2="3"/>
<line x1="20" y1="21" x2="20" y2="16"/>
<line x1="20" y1="12" x2="20" y2="3"/>
<line x1="1" y1="14" x2="7" y2="14"/>
<line x1="9" y1="8" x2="15" y2="8"/>
<line x1="17" y1="16" x2="23" y2="16"/>
</svg>
<span>深度检索</span>
</button>
</div>
</div>

<!-- Logotipo Oficial y Recuadro TEP -->
<div class="brand-container">
<a href="/" class="brand-link" aria-label="TEP NEWS">
<img 
src="/logo.png" 
alt="TEP NEWS - Logo Oficial" 
class="brand-logo-img"
width="68"
height="68"
loading="eager"
onerror="if(!this.dataset.retry){this.dataset.retry=1;this.src='/logo.jpg';}else if(this.dataset.retry==1){this.dataset.retry=2;this.src='/Logo.jpg';}else if(this.dataset.retry==2){this.dataset.retry=3;this.src='/Logo.png';}"
/>
<div class="brand-text-wrap">
<h1 class="main-title">
NEWS INTERNATIONAL <span class="brand-badge-tep">CHINA TEP</span>
</h1>
</div>
</a>
</div>
</div>
</header>

<!-- 5. NAVEGACIÓN ADHERENTE (STICKY) -->
<nav class="nav-sections sticky-nav">
<div class="nav-wrap">
<a href="/" class="nav-link active">首页</a>
<a href="/categoria/geopolitica" class="nav-link nav-geo">政治与防务</a>
<a href="/categoria/economia" class="nav-link nav-econ">经济与市场</a>
<a href="/categoria/tecnologia" class="nav-link nav-tech">科技与AI</a>
<a href="/categoria/ciencia" class="nav-link nav-sci">科学与医学</a>
<a href="/categoria/tendencias" class="nav-link nav-trend">社交媒体与动态</a>
<a href="/about" class="nav-link">关于我们</a>
<a href="https://paypal.me/newsinternacional" target="_blank" rel="noopener noreferrer" class="nav-link nav-donate" style="color: #dc2626; font-weight: 900;">♥ 赞助支持</a>
</div>
</nav>

<!-- MODAL DE BÚSQUEDA AVANZADA MULTIDIMENSIONAL -->
<div id="search-modal-backdrop" class="search-backdrop hidden">
<div class="search-modal-window">
<div class="modal-top-bar">
<div class="modal-title-wrap">
<div class="modal-badge-red">智能情报分析检索</div>
<h3 class="modal-title">深度检索 en Archivo TEP</h3>
</div>
<button type="button" id="close-advanced-modal-btn" class="modal-close-icon" aria-label="Cerrar modal">✕</button>
</div>

<form id="advanced-search-form" class="modal-filters-grid" onsubmit="return false;">
<div class="filter-group full-width">
<label for="adv-input-query">Término de Búsqueda o Título</label>
<input type="text" id="adv-input-query" placeholder="Ej: Semiconductores, Bancos Centrales, Taiwán..." />
</div>

<div class="filter-group">
<label for="adv-select-cat">Sección Informativa</label>
<select id="adv-select-cat">
<option value="all">Todas las Secciones</option>
<option value="geopolitica">Política & Orden Global</option>
<option value="economia">经济与市场</option>
<option value="tecnologia">科技与AI</option>
<option value="ciencia">科学与医学</option>
<option value="tendencias">Redes Sociales & Revuelo</option>
</select>
</div>

<div class="filter-group">
<label for="adv-input-date-specific">Día, Mes o Año (Especifico)</label>
<input type="date" id="adv-input-date-specific" title="Selecciona una fecha exacta" />
</div>

<div class="filter-group">
<label for="adv-input-author">Autor / Redacción</label>
<input type="text" id="adv-input-author" placeholder="Ej: Redacción TEP, Comité..." />
</div>

<div class="filter-group">
<label for="adv-input-tag">Palabra Clave (Tag)</label>
<input type="text" id="adv-input-tag" placeholder="Ej: chips, fed, defensa..." />
</div>
</form>

<!-- Resultados Dinámicos (Imágenes pequeñas y texto al lado) -->
<div class="search-results-area">
<div class="results-header">
<span id="results-count-badge">0 resultados encontrados</span>
<span class="results-hint">Escribe o selecciona filtros para actualizar</span>
</div>
<div id="search-results-list" class="results-container">
<div class="empty-search-state">
<p>Introduce un término o aplica los filtros para buscar en la base de datos documental.</p>
</div>
</div>
</div>
</div>
</div>

<style>
        /* RESULTADOS DINÁMICOS DE BÚSQUEDA (GLOBAL) */
        :global(.results-container) {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.9rem !important;
        }
        :global(.result-item-card) {
            display: grid !important;
            grid-template-columns: 140px 1fr !important;
            align-items: center !important;
            gap: 1.2rem !important;
            padding: 0.85rem !important;
            border-radius: 8px !important;
            border: 1px solid #e2e8f0 !important;
            background: #ffffff !important;
            text-decoration: none !important;
            color: inherit !important;
            transition: all 0.2s ease !important;
        }
        :global(.result-item-card:hover) {
            border-color: #050505 !important;
            background: #f8fafc !important;
            transform: translateX(4px) !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05) !important;
        }
        :global(.result-thumb) {
            width: 140px !important;
            height: 85px !important;
            max-width: 140px !important;
            max-height: 85px !important;
            object-fit: cover !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
            border: 1px solid #e2e8f0 !important;
            display: block !important;
        }
        :global(.result-details) {
            display: flex !important;
            flex-direction: column !important;
            justify-content: center !important;
            min-width: 0 !important;
        }
        :global(.result-meta-row) {
            display: flex !important;
            align-items: center !important;
            gap: 0.6rem !important;
            font-size: 0.7rem !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            margin-bottom: 0.3rem !important;
            color: #94a3b8 !important;
        }
        :global(.result-title) {
            font-size: 0.96rem !important;
            font-weight: 850 !important;
            margin: 0 0 0.35rem 0 !important;
            color: #050505 !important;
            line-height: 1.3 !important;
            white-space: normal !important;
        }
        :global(.result-snippet) {
            font-size: 0.82rem !important;
            color: #64748b !important;
            margin: 0 !important;
            line-height: 1.45 !important;
            display: -webkit-box !important;
            -webkit-line-clamp: 2 !important;
            -webkit-box-orient: vertical !important;
            overflow: hidden !important;
        }

        /* RESET GLOBAL FULL-WIDTH */
        :global(body), :global(html) {
            margin: 0 !important;
            padding: 0 !important;
            width: 100vw !important;
            max-width: 100% !important;
            overflow-x: hidden !important;
        }
    #global-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 4px;
        background: #dc2626;
        width: 0%;
        z-index: 999999;
        transition: width 0.1s ease-out;
        box-shadow: 0 0 8px rgba(220, 38, 38, 0.6);
    }
.tep-global-header { width: 100vw; max-width: 100%; box-sizing: border-box; overflow-x: hidden; margin: 0; padding: 0;
background: #ffffff;
color: #050505;
font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
width: 100%;
margin: 0;
padding: 0;
}

/* TICKERS CONTINUOS (Cero márgenes laterales) */
.ticker-time-wrapper {
background: #050505;
color: #94a3b8;
font-size: 0.72rem;
font-weight: 700;
border-bottom: 1px solid #1c1c1c;
height: 34px;
display: flex;
align-items: center;
overflow: hidden;
width: 100%;
}
.ticker-label-time {
background: #121212;
color: #ffffff;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
border-right: 2px solid #dc2626;
box-shadow: 4px 0 12px rgba(0,0,0,0.6);
}

.ticker-market-wrapper {
background: #0a0a0a;
color: #ffffff;
font-size: 0.74rem;
border-bottom: 1px solid #1a1a1a;
height: 36px;
display: flex;
align-items: center;
overflow: hidden;
width: 100%;
}
.ticker-label-market {
background: #dc2626;
color: #ffffff;
padding: 0 1.4rem;
height: 100%;
display: flex;
align-items: center;
font-weight: 900;
letter-spacing: 0.08em;
text-transform: uppercase;
z-index: 5;
flex-shrink: 0;
box-shadow: 4px 0 12px rgba(220, 38, 38, 0.4);
}

.ticker-viewport {
flex: 1;
height: 100%;
overflow: hidden;
position: relative;
display: flex;
align-items: center;
}
.ticker-track-loop {
display: flex;
width: max-content;
will-change: transform;
}
.ticker-group {
display: flex;
align-items: center;
gap: 3rem;
padding-right: 3rem;
flex-shrink: 0;
}
.time-track { animation: circularMarquee 38s linear infinite; }
.market-track { animation: circularMarquee 48s linear infinite; }
.ticker-track-loop:hover { animation-play-state: paused; }

@keyframes circularMarquee {
0% { transform: translateX(0); }
100% { transform: translateX(-50%); }
}

.time-item, .market-item {
display: inline-flex;
align-items: center;
gap: 0.5rem;
white-space: nowrap;
}
.time-city { color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.04em; }
.time-val { color: #f87171; font-variant-numeric: tabular-nums; font-weight: 700; }
.market-name { color: #e2e8f0; font-weight: 700; }
.market-val { color: #ffffff; font-variant-numeric: tabular-nums; font-weight: 700; }
.badge-up {
background: rgba(16, 185, 129, 0.2);
color: #10b981;
border: 1px solid #059669;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}
.badge-down {
background: rgba(239, 68, 68, 0.25);
color: #f87171;
border: 1px solid #dc2626;
padding: 0.1rem 0.45rem;
border-radius: 3px;
font-size: 0.68rem;
font-weight: 800;
}

/* UTILIDAD SUPERIOR */
.top-utility-bar {
max-width: 1580px;
width: 94%;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.6rem 0;
font-size: 0.78rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 900;
text-transform: uppercase;
color: #050505;
margin-right: 0.8rem;
border-right: 2px solid #050505;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
font-weight: 600;
color: #475569;
}
.utility-right {
display: flex;
align-items: center;
gap: 1.2rem;
}
/* SELECTOR DE EDICIONES Y PAÍSES TRILLIZO */
.edition-selector-bar {
display: inline-flex;
align-items: center;
gap: 0.25rem;
background: #f1f5f9;
padding: 0.18rem 0.35rem;
border-radius: 9999px;
border: 1px solid #e2e8f0;
}
.edition-selector-label {
font-size: 0.62rem;
font-weight: 850;
color: #64748b;
letter-spacing: 0.05em;
margin-right: 0.2rem;
padding-left: 0.35rem;
text-transform: uppercase;
}
.edition-pill {
display: inline-flex;
align-items: center;
gap: 0.3rem;
padding: 0.2rem 0.6rem;
border-radius: 9999px;
font-size: 0.72rem;
font-weight: 700;
color: #334155;
text-decoration: none;
transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.edition-pill:hover {
background: #ffffff;
color: #0f172a;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}
.edition-pill.is-active {
background: #0f172a;
color: #ffffff !important;
box-shadow: 0 2px 6px rgba(15, 23, 42, 0.25);
cursor: default;
}
.edition-flag {
font-size: 0.82rem;
line-height: 1;
}
.edition-lang {
line-height: 1;
letter-spacing: 0.02em;
}
@media (max-width: 768px) {
.edition-selector-label {
display: none;
}
.edition-pill {
padding: 0.18rem 0.45rem;
font-size: 0.68rem;
}
}
.live-info-badge {
display: inline-flex;
align-items: center;
gap: 6px;
font-weight: 800;
color: #dc2626;
text-transform: uppercase;
letter-spacing: 0.05em;
font-size: 0.72rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0%, 100% { transform: scale(0.95); opacity: 0.8; }
50% { transform: scale(1.25); opacity: 1; }
}
.live-pulse-btn {
color: #0f172a;
text-decoration: none;
font-weight: 800;
font-size: 0.76rem;
transition: color 0.15s ease;
}
.live-pulse-btn:hover {
color: #dc2626;
text-decoration: underline;
}

/* INDICADOR DE TIEMPO REAL ATÓMICO */
.live-realtime-indicator {
display: inline-flex;
align-items: center;
gap: 5px;
font-size: 0.65rem;
font-weight: 850;
color: #059669;
background: rgba(16, 185, 129, 0.1);
border: 1px solid rgba(16, 185, 129, 0.3);
padding: 0.15rem 0.5rem;
border-radius: 12px;
letter-spacing: 0.05em;
margin-left: 0.75rem;
}
.clock-sync-dot {
width: 6px;
height: 6px;
border-radius: 50%;
background: #10b981;
box-shadow: 0 0 6px #10b981;
animation: pulse 1.2s infinite ease-in-out;
}

/* PÍLDORA AUDIO BRIEF SÍNTESIS 24/7 */
.audio-brief-pill {
display: inline-flex;
align-items: center;
gap: 0.5rem;
background: #0f172a;
color: #38bdf8;
padding: 0.25rem 0.75rem;
border-radius: 20px;
font-size: 0.68rem;
font-weight: 850;
letter-spacing: 0.04em;
cursor: pointer;
border: 1px solid #1e293b;
box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.audio-brief-pill:hover {
background: #0284c7;
color: #ffffff;
border-color: #0284c7;
transform: translateY(-2px);
box-shadow: 0 6px 16px rgba(2, 132, 199, 0.4);
}
.audio-wave-icon {
display: inline-flex;
align-items: flex-end;
gap: 2px;
height: 12px;
}
.audio-wave-icon .bar {
width: 2px;
background: currentColor;
border-radius: 1px;
animation: soundBarPulse 1.2s ease-in-out infinite alternate;
}
.bar-1 { height: 4px; animation-delay: 0.1s; }
.bar-2 { height: 11px; animation-delay: 0.3s; }
