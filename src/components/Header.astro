<script is:inline>
// 1. FECHA LOCAL EN TIEMPO REAL
function updateLiveDate() {
const el = document.getElementById('live-header-date');
if (el) {
const now = new Date();
const str = now.toLocaleDateString('zh-CN', {
weekday: 'long',
day: 'numeric',
month: 'long',
year: 'numeric'
});
el.textContent = str.charAt(0).toUpperCase() + str.slice(1);
}
}
updateLiveDate();

// 2. RELOJES MUNDIALES EN TIEMPO REAL EXACTO
function updateClocks() {
const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
const now = new Date();
const elements = document.querySelectorAll('[data-tz]');
elements.forEach((el) => {
const tz = el.getAttribute('data-tz');
if (tz) {
try { el.textContent = new Intl.DateTimeFormat('zh-CN', { ...opts, timeZone: tz }).format(now); } catch (e) {}
}
});
}
updateClocks();
setInterval(updateClocks, 1000);

// 3. MOTOR DE MERCADOS Y DIVISAS EN TIEMPO REAL
function updateMarketPill(assetName, newVal, newChange, isUp) {
const items = document.querySelectorAll(`.market-item[data-asset="${assetName}"]`);
items.forEach((item) => {
const valEl = item.querySelector('.market-val');
const badgeEl = item.querySelector('.badge-up, .badge-down');
if (valEl) valEl.textContent = newVal;
if (badgeEl) {
badgeEl.textContent = newChange;
badgeEl.className = isUp ? 'badge-up' : 'badge-down';
}
item.classList.remove('flash-green', 'flash-red');
void item.offsetWidth; // trigger reflow
item.classList.add(isUp ? 'flash-green' : 'flash-red');
setTimeout(() => {
item.classList.remove('flash-green', 'flash-red');
}, 800);
});
}

function initLiveMarkets() {
// Cotizaciones base
const state = {
'BITCOIN': { val: 64280, pct: 2.10, isCrypto: true, prefix: '$' },
'S&P 500': { val: 5815.20, pct: 0.45, prefix: '' },
'NASDAQ 100': { val: 20240.10, pct: 0.72, prefix: '' },
'USD / EUR': { val: 0.9241, pct: 0.18, prefix: '' },
'USD / MXN': { val: 19.342, pct: -0.42, prefix: '' },
'现货黄金 (XAU/USD)': { val: 2654.80, pct: 0.64, prefix: '$' },
'布伦特原油': { val: 77.40, pct: -1.15, prefix: '$' },
'美债10年期': { val: 4.08, pct: -0.03, suffix: '%' }
};

// Intento de datos reales de Bitcoin
try {
fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true')
.then(r => r.json())
.then(d => {
if (d && d.bitcoin) {
const p = d.bitcoin.usd;
const ch = d.bitcoin.usd_24h_change || 0;
state['BITCOIN'].val = p;
state['BITCOIN'].pct = ch;
updateMarketPill('BITCOIN', '$' + p.toLocaleString('en-US'), (ch >= 0 ? '+' : '') + ch.toFixed(2) + '%', ch >= 0);
}
}).catch(() => {});
} catch(e) {}

// Micro-fluctuaciones en tiempo real cada 3.5 segundos (efecto piso bursátil de Wall Street)
setInterval(() => {
const keys = Object.keys(state);
const randomKey = keys[Math.floor(Math.random() * keys.length)];
const item = state[randomKey];
const delta = (Math.random() - 0.48) * (item.val * 0.0008);
item.val += delta;
item.pct += (Math.random() - 0.49) * 0.03;
const isUp = delta >= 0;

let displayVal = '';
if (item.prefix) displayVal += item.prefix;
if (item.val >= 1000) {
displayVal += item.val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
} else {
displayVal += item.val.toFixed(item.val < 2 ? 4 : 2);
}
if (item.suffix) displayVal += item.suffix;

const changeStr = (item.pct >= 0 ? '+' : '') + item.pct.toFixed(2) + '%';
updateMarketPill(randomKey, displayVal, changeStr, isUp);
}, 3500);
}
initLiveMarkets();

// 4. INTERACTIVIDAD PÍLDORA AUDIO BRIEF
document.addEventListener('DOMContentLoaded', () => {
const audioBtn = document.getElementById('tep-audio-brief-pill');
if (audioBtn) {
audioBtn.addEventListener('click', () => {
alert('🎙️ TEP AUDIO INFORMATIVO: Sintonizando síntesis ejecutiva de inteligencia geopolítica y mercados en tiempo real.');
});
}
});

let cachedIndex = null;
async function fetchSearchIndex() {
if (cachedIndex) return cachedIndex;
try {
const res = await fetch('/search-index.json');
if (res.ok) {
cachedIndex = await res.json();
return cachedIndex;
}
} catch (e) {}
return [];
}

function performSearch() {
if (!cachedIndex) return;
const query = (document.getElementById('adv-input-query')?.value || document.getElementById('quick-search-input')?.value || '').toLowerCase().trim();
const catFilter = document.getElementById('adv-select-cat')?.value || 'all';
const dateSpecific = document.getElementById('adv-input-date-specific')?.value; // Formato YYYY-MM-DD
const authorFilter = (document.getElementById('adv-input-author')?.value || '').toLowerCase().trim();
const tagFilter = (document.getElementById('adv-input-tag')?.value || '').toLowerCase().trim();

const filtered = cachedIndex.filter((item) => {
if (query) {
const inTitle = item.title.toLowerCase().includes(query);
const inDesc = item.description.toLowerCase().includes(query);
if (!inTitle && !inDesc) return false;
}
if (catFilter !== 'all') {
const itemCat = item.category.toLowerCase();
if (catFilter === 'geopolitica' && !itemCat.includes('polít') && !itemCat.includes('polit') && !itemCat.includes('geopol')) return false;
if (catFilter === 'economia' && !itemCat.includes('econ') && !itemCat.includes('mercad') && !itemCat.includes('finan')) return false;
if (catFilter === 'tecnologia' && !itemCat.includes('tecn') && !itemCat.includes('ia') && !itemCat.includes('intel')) return false;
if (catFilter === 'ciencia' && !itemCat.includes('cien') && !itemCat.includes('med') && !itemCat.includes('salud') && !itemCat.includes('biotec')) return false;
if (catFilter === 'tendencias' && !itemCat.includes('tend') && !itemCat.includes('red') && !itemCat.includes('viral') && !itemCat.includes('revuel')) return false;
}
// Filtro de fecha exacta por día, mes y año
if (dateSpecific) {
if (item.pubDate !== dateSpecific) return false;
}
if (authorFilter && !item.author.toLowerCase().includes(authorFilter)) return false;
if (tagFilter) {
const tagsStr = item.tags.join(' ').toLowerCase();
if (!tagsStr.includes(tagFilter)) return false;
}
return true;
});
renderResults(filtered);
}

function renderResults(items) {
const container = document.getElementById('search-results-list');
const badge = document.getElementById('results-count-badge');
if (!container || !badge) return;

badge.textContent = `${items.length} resultado${items.length === 1 ? '' : 's'} encontrado${items.length === 1 ? '' : 's'}`;

if (items.length === 0) {
container.innerHTML = `<div class="empty-search-state"><p>No se encontraron investigaciones que coincidan con los criterios seleccionados.</p></div>`;
return;
}

container.innerHTML = items.map((post) => {
const catLower = post.category.toLowerCase();
let catClass = 'badge-cat-geo';
let catColor = '#dc2626';
if (catLower.includes('econ') || catLower.includes('mercad')) { catClass = 'badge-cat-econ'; catColor = '#059669'; }
else if (catLower.includes('tecn') || catLower.includes('ia')) { catClass = 'badge-cat-tech'; catColor = '#2563eb'; }
else if (catLower.includes('cien') || catLower.includes('med') || catLower.includes('salud') || catLower.includes('biotec')) { catClass = 'badge-cat-sci'; catColor = '#06b6d4'; }
else if (catLower.includes('tend') || catLower.includes('red') || catLower.includes('viral') || catLower.includes('revuel')) { catClass = 'badge-cat-trend'; catColor = '#ec4899'; }

// Formatear la fecha en el resultado
const postDate = new Date(post.pubDate + 'T12:00:00Z');
const displayDate = postDate.toLocaleDateString('zh-CN', { day: 'numeric', month: 'short', year: 'numeric' });
const imgUrl = post.heroImage || '/og-image.jpg';

return `
<a href="${post.url}" class="result-item-card" style="display:grid !important; grid-template-columns:130px 1fr !important; align-items:center !important; gap:1.1rem !important; padding:0.85rem !important; border-radius:8px !important; border:1px solid #e2e8f0 !important; background:#ffffff !important; text-decoration:none !important; color:inherit !important; transition:all 0.2s ease !important; margin-bottom:0.75rem !important;">
  <div style="width:130px !important; height:85px !important; min-width:130px !important; max-width:130px !important; max-height:85px !important; border-radius:6px !important; overflow:hidden !important; flex-shrink:0 !important; background:#f1f5f9 !important;">
    <img src="${imgUrl}" alt="${post.title}" class="result-thumb" style="width:100% !important; height:100% !important; max-width:130px !important; max-height:85px !important; object-fit:cover !important; display:block !important;" loading="lazy" onerror="this.src='/og-image.jpg'" />
  </div>
  <div class="result-details" style="display:flex !important; flex-direction:column !important; justify-content:center !important; min-width:0 !important; overflow:hidden !important;">
    <div class="result-meta-row" style="display:flex !important; align-items:center !important; gap:0.5rem !important; font-size:0.7rem !important; font-weight:850 !important; text-transform:uppercase !important; margin-bottom:0.25rem !important; color:#94a3b8 !important;">
      <span class="${catClass}" style="color:${catColor} !important; font-weight:900 !important;">${post.category}</span>
      <span>•</span>
      <span>${displayDate}</span>
    </div>
    <h4 class="result-title" style="font-size:0.95rem !important; font-weight:850 !important; margin:0 0 0.35rem 0 !important; color:#050505 !important; line-height:1.3 !important; white-space:normal !important;">${post.title}</h4>
    <p class="result-snippet" style="font-size:0.82rem !important; color:#64748b !important; margin:0 !important; line-height:1.45 !important; display:-webkit-box !important; -webkit-line-clamp:2 !important; -webkit-box-orient:vertical !important; overflow:hidden !important;">${post.description}</p>
  </div>
</a>
`;
}).join('');
}

document.addEventListener('DOMContentLoaded', () => {
        const globalProgressBar = document.getElementById('global-progress-bar');
        if (globalProgressBar) {
            window.addEventListener('scroll', () => {
                const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
                globalProgressBar.style.width = scrolled + '%';
            });
        }
const quickInput = document.getElementById('quick-search-input');
const advBtn = document.getElementById('open-advanced-modal-btn');
const closeBtn = document.getElementById('close-advanced-modal-btn');
const modal = document.getElementById('search-modal-backdrop');
const advQuery = document.getElementById('adv-input-query');
const advCat = document.getElementById('adv-select-cat');
const advDateSpecific = document.getElementById('adv-input-date-specific');
const advAuthor = document.getElementById('adv-input-author');
const advTag = document.getElementById('adv-input-tag');

function openModal(initialQuery = '') {
fetchSearchIndex().then(() => {
if (modal) modal.classList.remove('hidden');
if (advQuery) {
advQuery.value = initialQuery;
advQuery.focus();
}
performSearch();
});
}

function closeModal() { if (modal) modal.classList.add('hidden'); }

if (quickInput) {
quickInput.addEventListener('focus', () => openModal(quickInput.value));
quickInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') openModal(quickInput.value); });
}
if (advBtn) advBtn.addEventListener('click', () => openModal(quickInput?.value || ''));
if (closeBtn) closeBtn.addEventListener('click', closeModal);
if (modal) { modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); }); }
window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

[advQuery, advCat, advDateSpecific, advAuthor, advTag].forEach((el) => {
if (el) {
el.addEventListener('input', performSearch);
el.addEventListener('change', performSearch);
}
});
});
</script>
<style>
