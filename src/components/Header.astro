<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" id="time-lon">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" id="time-fra">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" id="time-tok">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" id="time-sin">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" id="time-dxb">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" id="time-mex">--:--:--</span></div>
<!-- Duplicado para rotación continua fluida -->
<div class="time-item"><span class="time-city">Nueva York:</span> <span class="time-val" id="time-ny-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Londres:</span> <span class="time-val" id="time-lon-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Fráncfort:</span> <span class="time-val" id="time-fra-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Tokio:</span> <span class="time-val" id="time-tok-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Singapur:</span> <span class="time-val" id="time-sin-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Dubái:</span> <span class="time-val" id="time-dxb-2">--:--:--</span></div>
<div class="time-item"><span class="time-city">Cd. de México:</span> <span class="time-val" id="time-mex-2">--:--:--</span></div>
</div>
</div>

<!-- 2. BANNER GLOBAL: Monitor de Divisas y Mercados Financieros -->
<div class="ticker-market-wrapper">
<div class="ticker-label-market">MERCADOS & DIVISAS</div>
<div class="ticker-track-market">
{marketData.concat(marketData).map((m) => (
<div class="market-item">
<span class="market-name">{m.asset}:</span>
<span class="market-val">{m.val}</span>
<span class={m.up ? "badge-up" : "badge-down"}>{m.change}</span>
</div>
))}
</div>
</div>

<!-- 3. Barra de Utilidad Superior -->
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Global</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Alertas TEP</span>
</a>
</div>
</div>

<!-- 4. Masthead Periodístico -->
<div class="masthead">
<span class="sub-head">INVESTIGACIÓN & PROSPECTIVA ESTRATÉGICA INTERNACIONAL</span>
<h1 class="main-title">
<a href="/" class="brand-link">NEWS INTERNACIONAL <span class="brand-accent">TEP</span></a>
</h1>
<div class="tagline-nav">
<a href="/categoria/tecnologia" class="tagline-link">TECNOLOGÍA</a>
<span class="dot">•</span>
<a href="/categoria/economia" class="tagline-link">ECONOMÍA</a>
<span class="dot">•</span>
<a href="/categoria/geopolitica" class="tagline-link">GEOPOLÍTICA</a>
</div>
</div>

<!-- 5. Barra de Navegación Temática -->
<nav class="nav-sections">
<div class="nav-wrap">
<a href="/" class="nav-link">Portada</a>
<a href="/categoria/geopolitica" class="nav-link">Geopolítica</a>
<a href="/categoria/economia" class="nav-link">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link">Tecnología & IA</a>
<a href="/about" class="nav-link">Línea Editorial</a>
</div>
</nav>
</header>

