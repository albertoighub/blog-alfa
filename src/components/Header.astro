<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
const timezones = [
{ name: 'NUEVA YORK', tz: 'America/New_York' }, { name: 'LONDRES', tz: 'Europe/London' },
{ name: 'TOKIO', tz: 'Asia/Tokyo' }, { name: 'CD. DE MÉXICO', tz: 'America/Mexico_City' },
{ name: 'FRÁNCFORT', tz: 'Europe/Berlin' }, { name: 'HONG KONG', tz: 'Asia/Hong_Kong' },
{ name: 'SÍDNEY', tz: 'Australia/Sydney' }, { name: 'DUBÁI', tz: 'Asia/Dubai' },
{ name: 'SINGAPUR', tz: 'Asia/Singapore' }, { name: 'SÃO PAULO', tz: 'America/Sao_Paulo' },
{ name: 'MUMBAI', tz: 'Asia/Kolkata' }, { name: 'MOSCÚ', tz: 'Europe/Moscow' },
{ name: 'PARÍS', tz: 'Europe/Paris' }, { name: 'TORONTO', tz: 'America/Toronto' },
{ name: 'SHANGHÁI', tz: 'Asia/Shanghai' }, { name: 'SEÚL', tz: 'Asia/Seoul' },
{ name: 'ZÚRICH', tz: 'Europe/Zurich' }, { name: 'JOHANNESBURGO', tz: 'Africa/Johannesburg' },
{ name: 'BUENOS AIRES', tz: 'America/Argentina/Buenos_Aires' }, { name: 'CHICAGO', tz: 'America/Chicago' },
{ name: 'MADRID', tz: 'Europe/Madrid' }, { name: 'LOS ÁNGELES', tz: 'America/Los_Angeles' },
{ name: 'RIAD', tz: 'Asia/Riyadh' }, { name: 'TAIPÉI', tz: 'Asia/Taipei' }, { name: 'ESTAMBUL', tz: 'Europe/Istanbul' }
];

const tickers = document.querySelectorAll('.ticker-content');
if(tickers.length >= 2) {
const timeContent = tickers[0];

// Llenar relojes con espaciado seguro
const buildClocksHtml = () => {
let html = '<div class="ticker-items-group" style="display:inline-flex; align-items:center;">';
timezones.forEach((tz, index) => {
html += `<span class="tep-ticker-item"><b>${tz.name}:</b> <span class="time-value" style="color:#ef4444; margin-left:6px;" id="clock-${index}">00:00:00</span></span>`;
});
html += '</div>';

html += '<div class="ticker-items-group" aria-hidden="true" style="display:inline-flex; align-items:center;">';
timezones.forEach((tz, index) => {
html += `<span class="tep-ticker-item"><b>${tz.name}:</b> <span class="time-value" style="color:#ef4444; margin-left:6px;" id="clock-dup-${index}">00:00:00</span></span>`;
});
html += '</div>';
return html;
};

timeContent.innerHTML = buildClocksHtml();

const updateClocks = () => {
const now = new Date();
timezones.forEach((tz, index) => {
try {
const timeString = now.toLocaleTimeString('en-GB', { timeZone: tz.tz, hour12: false });
document.getElementById(`clock-${index}`).textContent = timeString;
document.getElementById(`clock-dup-${index}`).textContent = timeString;
} catch(e) {}
});
};
updateClocks();
setInterval(updateClocks, 1000);
}
});
</script>