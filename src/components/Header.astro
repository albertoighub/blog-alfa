<style>
/* RESET GLOBAL FULL-WIDTH */
:global(body), :global(html) {
margin: 0 !important;
padding: 0 !important;
width: 100vw !important;
max-width: 100% !important;
overflow-x: hidden !important;
background: #ffffff;
font-family: system-ui, -apple-system, sans-serif;
}

.tep-global-header {
width: 100vw;
max-width: 100%;
box-sizing: border-box;
margin: 0;
padding: 0;
border-bottom: 2px solid #e2e8f0;
}

/* TICKERS CONTINUOS (Bucle Infinito sin cortes) */
.header-top-bar, .header-markets-bar {
display: flex;
align-items: center;
width: 100vw;
box-sizing: border-box;
overflow: hidden;
font-size: 0.75rem;
font-weight: 800;
letter-spacing: 0.05em;
color: #ffffff;
}

.header-top-bar { background: #050505; height: 32px; }
.header-markets-bar { background: #111111; height: 36px; border-bottom: 1px solid #222; }

.top-bar-label, .market-label {
background: #dc2626;
padding: 0 1rem;
height: 100%;
display: flex;
align-items: center;
white-space: nowrap;
z-index: 10;
box-shadow: 2px 0 10px rgba(0,0,0,0.5);
}

.ticker-wrap {
flex: 1;
overflow: hidden;
white-space: nowrap;
position: relative;
}

.ticker-content {
display: inline-flex;
white-space: nowrap;
/* Reducción de velocidad para lectura fluida */
animation: tickerScroll 80s linear infinite; 
}

.ticker-content:hover {
animation-play-state: paused;
}

.ticker-items-group {
display: inline-flex;
align-items: center;
}

.ticker-items-group span {
display: inline-block;
margin-right: 3rem; /* Espaciado entre elementos */
}

/* Animación lineal perfecta sin cortes */
@keyframes tickerScroll {
0% { transform: translate3d(0, 0, 0); }
100% { transform: translate3d(-50%, 0, 0); } /* Desplaza exactamente la mitad (1 grupo) */
}

/* Estilos de tendencias */
.trend { padding: 2px 4px; border-radius: 3px; font-weight: 900; margin-left: 4px; }
.trend.up { background: #064e3b; color: #34d399; }
.trend.down { background: #4c0519; color: #fb7185; }
.time-value { color: #ef4444; margin-left: 4px; font-variant-numeric: tabular-nums; }

/* EDICION Y ALERTAS */
.header-edition-bar {
display: flex;
justify-content: space-between;
padding: 0.6rem 2rem;
border-bottom: 1px solid #e2e8f0;
font-size: 0.8rem;
font-weight: 700;
color: #334155;
background: #ffffff;
}
.edition-label { color: #050505; font-weight: 900; }
.live-alerts { display: flex; align-items: center; gap: 0.8rem; color: #dc2626; font-weight: 800; }
.live-indicator {
width: 8px; height: 8px; background: #dc2626; border-radius: 50%;
animation: pulse 1.5s infinite;
}
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(220,38,38,0.7); } 70% { box-shadow: 0 0 0 6px rgba(220,38,38,0); } 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); } }
.telegram-link { color: #050505; text-decoration: none; border-bottom: 1px solid #050505; }

/* BUSCADOR */
.header-search-bar { padding: 1.5rem 0; display: flex; justify-content: center; background: #ffffff; }
.search-container {
display: flex; align-items: center; width: 600px; max-width: 90%;
border: 1px solid #e2e8f0; border-radius: 30px; padding: 0.4rem; background: #f8fafc;
}
.search-icon { width: 18px; height: 18px; color: #94a3b8; margin: 0 1rem; }
.search-container input { border: none; background: transparent; flex: 1; outline: none; font-size: 0.95rem; color: #334155; }
.advanced-search-btn {
background: #050505; color: white; border: none; border-radius: 20px;
padding: 0.5rem 1rem; font-size: 0.75rem; font-weight: 800;
display: flex; align-items: center; gap: 0.5rem; cursor: pointer;
}
.advanced-search-btn svg { width: 14px; height: 14px; }

/* LOGO CENTRAL */
.header-logo-container { display: flex; justify-content: center; padding: 1rem 0 2rem; background: #ffffff; }
.logo-link { display: flex; align-items: center; gap: 1rem; text-decoration: none; color: #050505; }
.logo-icon {
width: 55px; height: 55px; border-radius: 50%; background: #050505;
display: flex; flex-direction: column; align-items: center; justify-content: center;
color: white; font-weight: 900; line-height: 1.1; box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}
.tep-top { font-size: 1rem; color: #a3a3a3; }
.news-bottom { font-size: 0.85rem; color: #dc2626; letter-spacing: 0.05em; }
.logo-text h1 { margin: 0; font-size: 2.5rem; font-weight: 950; letter-spacing: -0.03em; display: flex; align-items: center; gap: 0.5rem; }
.tep-red-box { background: #dc2626; color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 2.2rem; }

/* NAVEGACION */
nav { display: flex; justify-content: center; padding-bottom: 1.5rem; background: #ffffff; }
.internal-links { display: flex; gap: 2.5rem; }
nav a { font-weight: 900; color: #050505; text-decoration: none; font-size: 0.9rem; letter-spacing: 0.05em; text-transform: uppercase; padding-bottom: 0.3rem; }
nav a.active { color: #dc2626; border-bottom: 3px solid #dc2626; }

@media (max-width: 768px) {
.header-edition-bar { flex-direction: column; gap: 0.5rem; align-items: center; }
.internal-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
.logo-text h1 { font-size: 1.8rem; }
.tep-red-box { font-size: 1.5rem; }
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
// 1. FECHA EN TIEMPO REAL (ESPAÑOL)
const dateEl = document.getElementById('real-time-date');
if(dateEl) {
const updateDate = () => {
const now = new Date();
const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
let formatted = now.toLocaleDateString('es-MX', options);
dateEl.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
};
updateDate();
setInterval(updateDate, 60000); // Actualiza cada minuto
}

// 2. GENERADOR DE 25 ZONAS HORARIAS MUNDIALES (En vivo)
const timezones = [
{ name: 'NUEVA YORK', tz: 'America/New_York' },
{ name: 'LONDRES', tz: 'Europe/London' },
{ name: 'TOKIO', tz: 'Asia/Tokyo' },
{ name: 'CD. DE MÉXICO', tz: 'America/Mexico_City' },
{ name: 'FRÁNCFORT', tz: 'Europe/Berlin' },
{ name: 'HONG KONG', tz: 'Asia/Hong_Kong' },
{ name: 'SÍDNEY', tz: 'Australia/Sydney' },
{ name: 'DUBÁI', tz: 'Asia/Dubai' },
{ name: 'SINGAPUR', tz: 'Asia/Singapore' },
{ name: 'SÃO PAULO', tz: 'America/Sao_Paulo' },
{ name: 'MUMBAI', tz: 'Asia/Kolkata' },
{ name: 'MOSCÚ', tz: 'Europe/Moscow' },
{ name: 'PARÍS', tz: 'Europe/Paris' },
{ name: 'TORONTO', tz: 'America/Toronto' },
{ name: 'SHANGHÁI', tz: 'Asia/Shanghai' },
{ name: 'SEÚL', tz: 'Asia/Seoul' },
{ name: 'ZÚRICH', tz: 'Europe/Zurich' },
{ name: 'JOHANNESBURGO', tz: 'Africa/Johannesburg' },
{ name: 'BUENOS AIRES', tz: 'America/Argentina/Buenos_Aires' },
{ name: 'CHICAGO', tz: 'America/Chicago' },
{ name: 'MADRID', tz: 'Europe/Madrid' },
{ name: 'LOS ÁNGELES', tz: 'America/Los_Angeles' },
{ name: 'RIAD', tz: 'Asia/Riyadh' },
{ name: 'TAIPÉI', tz: 'Asia/Taipei' },
{ name: 'ESTAMBUL', tz: 'Europe/Istanbul' }
];

const timeContent = document.getElementById('time-ticker-content');

if(timeContent) {
// Construir el HTML de los relojes (2 grupos para bucle infinito)
const buildClocksHtml = () => {
let html = '<div class="ticker-items-group">';
timezones.forEach((tz, index) => {
html += `<span><b>${tz.name}:</b> <span class="time-value" id="clock-${index}">00:00:00</span></span>`;
});
html += '</div>';

// Duplicado exacto
html += '<div class="ticker-items-group" aria-hidden="true">';
timezones.forEach((tz, index) => {
html += `<span><b>${tz.name}:</b> <span class="time-value" id="clock-dup-${index}">00:00:00</span></span>`;
});
html += '</div>';
return html;
};

timeContent.innerHTML = buildClocksHtml();

// Función para actualizar los 50 relojes segundo a segundo
const updateClocks = () => {
const now = new Date();
timezones.forEach((tz, index) => {
try {
const timeString = now.toLocaleTimeString('en-GB', { timeZone: tz.tz, hour12: false });
document.getElementById(`clock-${index}`).textContent = timeString;
document.getElementById(`clock-dup-${index}`).textContent = timeString;
} catch(e) {}
});
};

updateClocks();
setInterval(updateClocks, 1000); // Latido cada segundo
}
});
</script>