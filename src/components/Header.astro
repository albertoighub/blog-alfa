---
const today = new Date().toLocaleDateString('es-MX', {
weekday: 'long',
year: 'numeric',
month: 'long',
day: 'numeric',
});
---

<header class="nyt-header">
<div class="top-utility-bar">
<div class="utility-left">
<span class="edition-badge">Edición Internacional</span>
<span class="utility-date">{today}</span>
</div>
<div class="utility-right">
<a href="https://t.me/newsinternacionaltep" target="_blank" rel="noopener noreferrer" class="live-pulse-btn">
<span class="pulse-dot"></span>
<span>Canal Oficial de Telegram</span>
</a>
</div>
</div>

<div class="masthead">
<a href="/" class="masthead-brand">
<span class="sub-head">El Diario Analítico Global</span>
<h1 class="main-title">NEWS INTERNACIONAL <span>TEP</span></h1>
<span class="tagline">TECNOLOGÍA • ECONOMÍA • POLÍTICA INTERNACIONAL</span>
</a>
</div>

<nav class="nav-sections">
<div class="nav-wrap">
<a href="/" class="nav-link">Portada</a>
<a href="/categoria/geopolitica" class="nav-link">Geopolítica</a>
<a href="/categoria/economia" class="nav-link">Economía & Mercados</a>
<a href="/categoria/tecnologia" class="nav-link">Inteligencia Artificial & Tech</a>
<a href="/about" class="nav-link">Línea Editorial (E-E-A-T)</a>
</div>
</nav>
</header>

<style>
.nyt-header {
background: #ffffff;
border-bottom: 3px double #121212;
color: #121212;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.top-utility-bar {
max-width: 1200px;
margin: 0 auto;
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.4rem 1rem;
font-size: 0.78rem;
border-bottom: 1px solid #e2e8f0;
color: #64748b;
}
.edition-badge {
font-weight: 800;
text-transform: uppercase;
color: #0f172a;
margin-right: 0.8rem;
border-right: 1px solid #cbd5e1;
padding-right: 0.8rem;
}
.utility-date {
text-transform: capitalize;
}
.live-pulse-btn {
display: inline-flex;
align-items: center;
gap: 6px;
color: #0284c7;
text-decoration: none;
font-weight: 700;
font-size: 0.78rem;
}
.pulse-dot {
width: 8px;
height: 8px;
background: #dc2626;
border-radius: 50%;
box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
animation: pulse 1.6s infinite;
}
@keyframes pulse {
0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(220, 38, 38, 0); }
100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
}
.masthead {
text-align: center;
padding: 1.8rem 1rem 1.2rem;
border-bottom: 1px solid #121212;
}
.masthead-brand {
text-decoration: none;
color: inherit;
display: inline-block;
}
.sub-head {
font-family: "Georgia", serif;
font-style: italic;
font-size: 0.88rem;
color: #475569;
letter-spacing: 0.05em;
display: block;
margin-bottom: 0.3rem;
}
.main-title {
font-family: "Georgia", "Times New Roman", serif;
font-size: clamp(2rem, 5.5vw, 3.4rem);
font-weight: 900;
letter-spacing: -0.03em;
margin: 0;
line-height: 1;
color: #111827;
text-transform: uppercase;
}
.main-title span {
color: #1e3a8a;
font-style: italic;
}
.tagline {
display: block;
font-size: 0.68rem;
font-weight: 800;
letter-spacing: 0.18em;
color: #64748b;
margin-top: 0.6rem;
}
.nav-sections {
border-top: 1px solid #e2e8f0;
}
.nav-wrap {
max-width: 1200px;
margin: 0 auto;
display: flex;
justify-content: center;
align-items: center;
flex-wrap: wrap;
gap: 0 2rem;
padding: 0.6rem 1rem;
}
.nav-link {
color: #1e293b;
text-decoration: none;
font-size: 0.84rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
padding: 0.3rem 0;
border-bottom: 2px solid transparent;
transition: all 0.15s ease;
}
.nav-link:hover {
color: #1e3a8a;
border-bottom-color: #1e3a8a;
}
@media (max-width: 768px) {
.utility-left { display: flex; flex-direction: column; gap: 2px; }
.nav-wrap { justify-content: flex-start; overflow-x: auto; white-space: nowrap; gap: 0 1.2rem; }
}
</style>
